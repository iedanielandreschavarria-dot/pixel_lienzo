# Copiar este archivo como ".env" y ajustar los valores reales (no versionar .env)

ENVIRONMENT=development

# Base de datos MySQL / MariaDB (ver Doc/bd_pixel_lienzo.txt)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=892123
DB_NAME=pixel_lienzo_db

# Seguridad
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-y-segura
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
PASSWORD_RESET_EXPIRE_MINUTES=30
MFA_CODE_EXPIRE_MINUTES=10
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440

# Correo saliente (SMTP). Déjalo vacío en desarrollo: el servicio de correo
# imprimirá los mensajes en la consola en vez de enviarlos de verdad.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-responder@pixelylienzo.com
SMTP_FROM_NAME=Pixel y Lienzo

# URL del frontend en React (para enlaces de recuperación y del Trust Engine)
FRONTEND_URL=http://localhost:5173

# URL pública de este backend (para construir las URLs de /static) y
# almacenamiento local de archivos subidos
BACKEND_BASE_URL=http://localhost:8000
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Pasarela de pago Wompi (Colombia) — llaves de prueba en
# https://comercios.wompi.co (sandbox). Sin estas llaves, el checkout no
# generará una URL de pago válida.
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=stagtest_integrity_xxxxxxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=stagtest_events_xxxxxxxxxxxxxxxxxxxx
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
WOMPI_API_BASE_URL=https://sandbox.wompi.co/v1

# CORS: orígenes permitidos para el frontend en React.
# Acepta lista separada por comas o array JSON, por ejemplo:
#   BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
#   BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
