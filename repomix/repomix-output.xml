            ]
            for col_i, v in enumerate(vals, start=1):
                c = ws.cell(next_row, col_i, value=v)
                c._style = copy.copy(template_styles[col_i - 1])
            ws.row_dimensions[next_row].height = 48
            next_row += 1

    # Actualizar hoja Instrucciones
    inst = wb["Instrucciones"]
