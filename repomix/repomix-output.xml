<file path="frontend/src/pages/auth/VerificarEmailPage.tsx">
import { useEffect, useState } from "react";
import { useForm } from "react-hook-form";
import { Link, useLocation, useNavigate } from "react-router-dom";
import { verificarEmail } from "../../api/auth";
import { useToast } from "../../context/ToastContext";
import { Button } from "../../components/ui/Button";
import { Input } from "../../components/ui/Input";
import { AuthCard } from "./AuthCard";
import { obtenerMensajeError } from "../../api/client";

interface FormValues {
  correo_electronico: string;
  codigo: string;
}

export function VerificarEmailPage() {
  const navigate = useNavigate();
  const { notificar } = useToast();
  const location = useLocation();
  const correoPrevio = (location.state as { correo?: string } | null)?.correo ?? "";
  const [segundosEspera, setSegundosEspera] = useState(0);

  useEffect(() => {
    document.title = "Verifica tu correo · Pixel & Lienzo";
  }, []);

  useEffect(() => {
    if (segundosEspera <= 0) return;
    const timer = window.setInterval(() => {
      setSegundosEspera((prev) => (prev > 1 ? prev - 1 : 0));
    }, 1000);
    return () => window.clearInterval(timer);
  }, [segundosEspera]);

  const {
    register,
    handleSubmit,
    watch,
    formState: { errors, isSubmitting },
  } = useForm<FormValues>({
    mode: "onBlur",
    defaultValues: { correo_electronico: correoPrevio },
  });

  const correoActual = watch("correo_electronico") || correoPrevio;

  const onSubmit = async (values: FormValues) => {
    try {
      await verificarEmail(values.correo_electronico, values.codigo);
      notificar("Correo verificado correctamente. Ya puedes iniciar sesión.", "exito");
      navigate("/login");
    } catch (error) {
      notificar(obtenerMensajeError(error, "Código inválido o expirado."), "error");
    }
  };

  const manejarReenvio = () => {
    if (segundosEspera > 0) return;
    setSegundosEspera(60);
    notificar("Si el correo está pendiente de verificación, enviamos un nuevo código.", "exito");
  };

  return (
    <AuthCard
      titulo="Verifica tu correo"
      subtitulo={
        correoActual
          ? `Enviamos un código de verificación a ${correoActual}`
          : "Ingresa el código que enviamos a tu correo"
      }
    >
      <form onSubmit={handleSubmit(onSubmit)} noValidate className="flex flex-col gap-[var(--espacio-24)]">
        <Input
          variante="subrayado"
          label="Correo"
          type="email"
          autoComplete="email"
          error={errors.correo_electronico?.message}
          {...register("correo_electronico", {
            required: "Ingresa un correo válido, por ejemplo nombre@dominio.com.",
          })}
        />
        <Input
          variante="subrayado"
          label="Código de verificación"
          inputMode="numeric"
          autoComplete="one-time-code"
          className="codigo-certificado"
          error={errors.codigo?.message}
          {...register("codigo", { required: "Ingresa el código recibido." })}
        />

        <Button type="submit" variante="primario" cargando={isSubmitting} className="w-full">
          Verificar
        </Button>

        <Button
          type="button"
          variante="secundario"
          disabled={segundosEspera > 0}
          onClick={manejarReenvio}
          className="w-full"
        >
          {segundosEspera > 0 ? `Reenviar correo (${segundosEspera} s)` : "Reenviar correo"}
        </Button>

        <p className="text-center text-[length:var(--text-cuerpo)] text-[color:var(--tinta-suave)]">
          <Link to="/login" className="enlace-acceso">
            ← Volver a iniciar sesión
          </Link>
        </p>
      </form>
    </AuthCard>
  );
}
</file>

<file path="frontend/src/pages/curaduria/DialogoEmitirCertificado.tsx">
import { useState } from "react";
import { useMutation, useQueryClient } from "@tanstack/react-query";
import { emitirCertificado } from "../../api/certificados";
import { subirPdfCertificado } from "../../api/archivos";
import { obtenerMensajeError } from "../../api/client";
import { useToast } from "../../context/ToastContext";
import { Button } from "../../components/ui/Button";
import { FileUpload } from "../../components/ui/FileUpload";
import { Input } from "../../components/ui/Input";
import { Modal } from "../../components/ui/Modal";
import type { Obra } from "../../types";

interface DialogoEmitirCertificadoProps {
  obra: Obra;
  abierto: boolean;
  onCerrar: () => void;
}

/**
 * Emisión del certificado de autenticidad (Sección 6.14):
 * La firma del curador se combina con la ficha técnica de la obra para calcular
 * el sello SHA-256 irreversible.
 */
export function DialogoEmitirCertificado({
  obra,
  abierto,
  onCerrar,
}: DialogoEmitirCertificadoProps) {
  const { notificar } = useToast();
  const queryClient = useQueryClient();
  const [firma, setFirma] = useState("");
  const [pdf, setPdf] = useState<File>();
  const [errores, setErrores] = useState<{ firma?: string; pdf?: string }>({});

  const cerrar = () => {
    setFirma("");
    setPdf(undefined);
    setErrores({});
    onCerrar();
  };

  const mutacion = useMutation({
    mutationFn: async () => {
      const pdf_certificado_url = await subirPdfCertificado(pdf!);
      return emitirCertificado(obra.id_obra, {
        firma_digital_curador: firma.trim(),
        pdf_certificado_url,
      });
    },
    onSuccess: () => {
      void queryClient.invalidateQueries({ queryKey: ["obras-sin-certificado"] });
      void queryClient.invalidateQueries({ queryKey: ["certificado", obra.id_obra] });
      notificar("Certificado emitido. Su código QR de validación ya es público.", "exito");
      cerrar();
    },
    onError: (error) =>
      notificar(obtenerMensajeError(error, "No fue posible emitir el certificado"), "error"),
  });

  const emitir = () => {
    const nuevos: { firma?: string; pdf?: string } = {};
    if (firma.trim().length < 6) {
      nuevos.firma = "Ingresa tu firma digital (mínimo 6 caracteres).";
    }
    if (!pdf) {
      nuevos.pdf = "Adjunta el certificado firmado en formato PDF.";
    }
    setErrores(nuevos);
    if (Object.keys(nuevos).length > 0) return;
    mutacion.mutate();
  };

  return (
    <Modal
      abierto={abierto}
      onCerrar={cerrar}
      titulo="Emitir certificado"
      descripcion={`"${obra.titulo}" quedará certificada de forma permanente. El sello SHA-256 se calcula sobre su ficha técnica actual.`}
    >
      <div className="flex flex-col gap-[var(--espacio-24)]">
        <Input
          id="curador-firma-digital"
          variante="caja"
          label="Firma digital del curador"
          name="firma_digital_curador"
          value={firma}
          placeholder="Nombre completo y número de acreditación"
          error={errores.firma}
          onChange={(e) => {
            setFirma(e.target.value);
            if (errores.firma) setErrores((prev) => ({ ...prev, firma: undefined }));
          }}
        />

        <FileUpload
          label="Certificado firmado (PDF)"
          ayuda="Archivo PDF oficial firmado por curaduría."
          accept="application/pdf"
          archivoActual={pdf ? { nombre: pdf.name, tamanoBytes: pdf.size } : null}
          error={errores.pdf}
          onSelectFile={(archivo) => {
            setPdf(archivo);
            if (errores.pdf) setErrores((prev) => ({ ...prev, pdf: undefined }));
          }}
        />

        <div className="flex justify-end gap-[var(--espacio-12)] border-t border-[color:var(--divisor)] pt-[var(--espacio-16)]">
          <Button variante="secundario" onClick={cerrar} disabled={mutacion.isPending}>
            Cancelar
          </Button>
          <Button variante="primario" onClick={emitir} cargando={mutacion.isPending}>
            Emitir certificado
          </Button>
        </div>
      </div>
    </Modal>
  );
}
</file>

