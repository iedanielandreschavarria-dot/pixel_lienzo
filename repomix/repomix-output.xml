    # =========================================================================
    import openpyxl

    doc_dir = Path(__file__).resolve().parents[2] / "Doc"
    src_xlsx = doc_dir / "Matriz_Casos_Prueba_TP-2026-001_Completa_MOD1_a_MOD5.xlsx"
