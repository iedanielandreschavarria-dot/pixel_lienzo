@import "tailwindcss";
@import "./styles/escena.css";

/* ==========================================================
   Tipografías locales en assets/fonts con font-display: swap
   ========================================================== */
@font-face {
  font-family: "Gramon Mini Edition";
  src: url("./assets/fonts/Gramon Mini Edition.woff2") format("woff2");
  font-weight: 500 600;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: "TimesNewRomanMTStd";
  src: url("./assets/fonts/TimesNewRomanMTStd.woff2") format("woff2");
  font-weight: 900;
  font-style: normal;
  font-display: swap;
}

/* ==========================================================
   Sección 3 — Fundamentos y Tokens del Kit de Identidad
   ========================================================== */
:root {
  /* 3.1 Color [Piedra Basalto Cálida & Oro Champán Luminoso — Oscuro no sombrío] */
  --vacio: #24221f;
  --fondo: #1b1a18;
  --tinta: #f6f3ec;
  --tinta-suave: #bdb6ab;
  --tinta-inversa: #f6f3ec;
  --profundidad: #2b251f;
  --carmesi: #8f6b3e;
  --incandescente: #ab8350;
  --riel: #d8b888;
  --aviso: #e6b050;
  --exito: #7ec291;
  --peligro: #d96b6b;

  /* Superficies y transparencias de galería en piedra cálida */
  --superficie-elevada: #26231f;
  --campo-caja-fondo: #23201c;
  --campo-caja-borde: rgba(216, 184, 136, 0.34);
  --campo-subrayado-borde: rgba(216, 184, 136, 0.44);
  --divisor: rgba(246, 243, 236, 0.13);
  --esqueleto: rgba(246, 243, 236, 0.08);
  --borde-reposo: rgba(216, 184, 136, 0.38);
  --borde-hover: rgba(216, 184, 136, 0.85);
  --borde-terciario: rgba(216, 184, 136, 0.68);
  --fila-hover: rgba(216, 184, 136, 0.12);
  --cabecera-fondo: rgba(19, 18, 16, 0.96);
  --modal-velo: rgba(15, 14, 12, 0.72);
  --luz-escenario-obra: rgba(216, 184, 136, 0.15);

  /* 3.2 Tipografía [Definido] */
  --fuente-titulo: "Playfair Display", "TimesNewRomanMTStd", "Didot", "Bodoni MT", Georgia, serif;
  --fuente-texto: "Cormorant Garamond", "Gramon Mini Edition", Garamond, Georgia, serif;
  --fuente-poster: "Anton", Impact, "Arial Narrow", sans-serif;

  --text-display: 4.4rem;
  --text-display-movil: 2.6rem;
  --text-h1: 3rem;
  --text-h1-movil: 2.2rem;
  --text-h2: 2.2rem;
  --text-h2-movil: 1.7rem;
  --text-h3: 1.5rem;
  --text-h4: 1.15rem;
  --text-cuerpo: 1.25rem;
  --text-cuerpo-pequeno: 1.1rem;
  --text-cursiva-min: 1.1rem;
  --text-cursiva-max: 1.3rem;
  --text-etiqueta: 1rem;
  --text-dato: 1.15rem;
  --text-campo: 1.3rem;
  --text-minimo: 1rem; /* 16px mínimo absoluto */

  /* 3.3 Espaciado y medidas [Definido]
     Escala única permitida: 4, 8, 12, 16, 24, 32, 48, 64, 96, 128 px */
  --espacio-4: 4px;
  --espacio-8: 8px;
  --espacio-12: 12px;
  --espacio-16: 16px;
  --espacio-24: 24px;
  --espacio-32: 32px;
  --espacio-48: 48px;
  --espacio-64: 64px;
  --espacio-96: 96px;
  --espacio-128: 128px;

  --contenedor-max: 1280px;
  --contenedor-panel: 1200px;
  --contenedor-legal: 720px;
  --contenedor-lectura: 720px;
  --contenedor-formulario-amplio: 720px;
  --contenedor-resultado: 640px;
  --contenedor-verificar: 560px;
  --contenedor-formulario: 520px;
  --modal-ancho: 520px;
  --sidebar-ancho: 240px;
  --filtros-ancho: 280px;
  --retrato-artista: 280px;
  --sello-diametro: 160px;
  --miniatura-96: 96px;
  --alto-cabecera: 64px;
  --alto-barra-movil: 72px;
  --alto-control: 48px;
  --alto-control-compacto: 40px;
  --area-tactil-min: 44px;
  --alto-estado: 28px;

  /* 3.4 Bordes, formas y sombras [Definido] */
  --radio-recto: 0px;
  --radio-pildora: 999px;
  --radio-circulo: 50%;

  --sombra-tarjeta: 0 16px 42px rgba(10, 9, 8, 0.38);
  --sombra-modal: 0 24px 64px rgba(10, 9, 8, 0.55);
  --sombra-iluminacion-roja: 0 10px 30px rgba(216, 184, 136, 0.2);
  --resplandor-primario: 0 0 26px rgba(216, 184, 136, 0.32);
  --resplandor-disco:
    inset 0 0 55px 10px rgba(15, 14, 12, 0.55),
    0 0 0 1.5px rgba(216, 184, 136, 0.62),
    0 0 85px 10px rgba(216, 184, 136, 0.22);
  --resplandor-disco-hover:
    inset 0 0 55px 10px rgba(15, 14, 12, 0.6),
    0 0 0 2px rgba(235, 206, 160, 0.92),
    0 0 105px 16px rgba(216, 184, 136, 0.32);
  --resplandor-sello-valido:
    inset 0 0 32px 6px rgba(15, 14, 12, 0.5),
    0 0 42px 4px rgba(126, 194, 145, 0.28);

  /* 3.5 Movimiento [Definido] */
  --duracion-ruta: 300ms;
  --duracion-hover: 400ms;
  --duracion-texto: 500ms;
  --duracion-pagina: 600ms;
  --duracion-momento-min: 800ms;
  --duracion-momento-max: 1400ms;
  --duracion-pulso: 2.4s;

  --curva-base: ease;
  --curva-momento: cubic-bezier(0.65, 0, 0.25, 1);

  /* Geometría del catálogo Masonry */
  --catalog-radius: 10px;

  /* Medidas de Escena (sección 7.1) con scroll natural debajo del header */
  --W: min(92vw, 96vh, 980px);
  --D: calc(var(--W) * 0.56);
  --margen-superior: 40px;
  --cy: calc(var(--margen-superior) + var(--W) * 0.54);
  --p: 0;

  color-scheme: dark;
}

@theme {
  --font-display: var(--fuente-titulo);
  --font-sans: var(--fuente-texto);
  --font-serif: var(--fuente-texto);
  --font-poster: var(--fuente-poster);

  /* Tokens del Kit expuestos como utilidades Tailwind */
  --color-vacio: var(--vacio);
  --color-fondo: var(--fondo);
  --color-tinta: var(--tinta);
  --color-tinta-suave: var(--tinta-suave);
  --color-profundidad: var(--profundidad);
  --color-carmesi: var(--carmesi);
  --color-incandescente: var(--incandescente);
  --color-riel: var(--riel);
  --color-aviso: var(--aviso);
  --color-exito: var(--exito);

  /* Alias de transición para componentes existentes que se migrarán en Fases 2-4 */
  --color-carbon: var(--fondo);
  --color-carbon-suave: var(--vacio);
  --color-antracita: var(--fondo);
  --color-antracita-suave: var(--borde-reposo);
  --color-marfil: var(--tinta);
  --color-marfil-suave: var(--tinta-suave);
  --color-ocre: var(--riel);
  --color-ocre-suave: var(--incandescente);
  --color-terracota: var(--aviso);
}

/* ==========================================================
   Estilos base globales (Sección 3 y 7)
   ========================================================== */
@layer base {
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
  }

  html {
    background-color: var(--fondo);
    color: var(--tinta);
    font-size: 16px;
    scroll-behavior: smooth;
    font-variant-numeric: lining-nums tabular-nums;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  body {
    font-family: var(--fuente-texto);
    font-weight: 500;
