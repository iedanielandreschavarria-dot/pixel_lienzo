        db = SessionLocal()
        try:
            rol = db.query(Rol).filter(Rol.nombre_rol == rol_nombre).first()
            user = db.query(Usuario).filter(Usuario.correo_electronico == email).first()
            if not rol or not user:
                return None
            user.id_rol = rol.id_rol
            db.commit()
            return user.id_usuario
        finally:
            db.close()

