<file path="frontend/src/components/ProtectedRoute.tsx">
import { Navigate, Outlet, useLocation } from "react-router-dom";
import { useAuth } from "../context/AuthContext";
import { Spinner } from "./ui/Spinner";
import type { NombreRol } from "../types";

export function ProtectedRoute({ rolesPermitidos }: { rolesPermitidos?: NombreRol[] }) {
  const { user, cargando } = useAuth();
  const location = useLocation();

  if (cargando) return <Spinner etiqueta="Verificando sesión…" />;
  
  if (!user) {
    return <Navigate to="/login" state={{ from: location }} replace />;
  }

  if (rolesPermitidos && !rolesPermitidos.includes(user.rol)) {
    return <Navigate to="/" replace />;
  }

  return <Outlet />;
}
</file>

<file path="frontend/src/context/ToastContext.tsx">
import { createContext, useCallback, useContext, useEffect, useRef, useState, type ReactNode } from "react";
import { AlertTriangle, Check, X } from "lucide-react";

export type TipoToast = "exito" | "error";

export interface OpcionesToast {
  accion?: {
    etiqueta: string;
    onClick: () => void;
  };
  duracionMs?: number;
}

interface Toast {
  id: number;
  tipo: TipoToast;
  mensaje: string;
  accion?: OpcionesToast["accion"];
}

interface ToastContextValue {
  notificar: (mensaje: string, tipo?: TipoToast, opciones?: OpcionesToast) => void;
}

const ToastContext = createContext<ToastContextValue | undefined>(undefined);

let contador = 0;

/**
 * 4.8 Toast:
 * Abajo al centro, de 360 a 480 px, borde del color semántico, icono y texto.
 * Dura 5 segundos; los de error permanecen hasta cerrarse. Solo uno visible a la vez.
 * 7.2: Los toasts de error usan role="alert" y los demás role="status".
 */
export function ToastProvider({ children }: { children: ReactNode }) {
  const [toast, setToast] = useState<Toast | null>(null);
  const timerRef = useRef<number | null>(null);

  const limpiarTimer = () => {
    if (timerRef.current !== null) {
      window.clearTimeout(timerRef.current);
      timerRef.current = null;
    }
  };

  const notificar = useCallback(
    (mensaje: string, tipo: TipoToast = "exito", opciones?: OpcionesToast) => {
      limpiarTimer();
      const id = ++contador;
      setToast({ id, tipo, mensaje, accion: opciones?.accion });

      if (tipo !== "error") {
        const duracion = opciones?.duracionMs ?? 5000;
        timerRef.current = window.setTimeout(() => {
          setToast((actual) => (actual?.id === id ? null : actual));
        }, duracion);
      }
    },
    []
  );

  useEffect(() => limpiarTimer, []);

  return (
    <ToastContext.Provider value={{ notificar }}>
      {children}
      {toast && (
        <div className="fixed inset-x-0 bottom-[var(--espacio-24)] z-50 flex justify-center px-[var(--espacio-16)] pointer-events-none">
          <div
            key={toast.id}
            role={toast.tipo === "error" ? "alert" : "status"}
            aria-live={toast.tipo === "error" ? "assertive" : "polite"}
            className={`pointer-events-auto flex w-full min-w-[min(360px,100%)] max-w-[480px] items-center gap-[var(--espacio-12)] rounded-[var(--radio-recto)] border bg-[color:var(--fondo)] px-[var(--espacio-16)] py-[var(--espacio-12)] shadow-[var(--sombra-tarjeta)] ${
              toast.tipo === "exito"
                ? "border-[color:var(--exito)] text-[color:var(--tinta)]"
                : "border-[color:var(--aviso)] text-[color:var(--tinta)]"
            }`}
          >
            {toast.tipo === "exito" ? (
              <Check
                size={24}
                strokeWidth={1.5}
                className="shrink-0 text-[color:var(--exito)]"
                aria-hidden="true"
              />
            ) : (
              <AlertTriangle
                size={24}
                strokeWidth={1.5}
                className="shrink-0 text-[color:var(--aviso)]"
                aria-hidden="true"
              />
            )}

            <p className="voz-cuerpo-pequeno flex-1 text-[color:var(--tinta)]">{toast.mensaje}</p>

            {toast.accion && (
              <button
                type="button"
                onClick={() => {
                  toast.accion?.onClick();
                  setToast(null);
                }}
                className="shrink-0 bg-transparent border-0 border-b border-[color:var(--borde-terciario)] pb-[var(--espacio-4)] font-[var(--fuente-texto)] font-semibold text-[length:var(--text-cuerpo-pequeno)] text-[color:var(--tinta)] hover:border-white cursor-pointer"
              >
                {toast.accion.etiqueta}
              </button>
            )}

            <button
              type="button"
              onClick={() => setToast(null)}
              aria-label="Cerrar aviso"
              className="inline-grid h-[var(--area-tactil-min)] w-[var(--area-tactil-min)] shrink-0 place-items-center bg-transparent border-0 text-[color:var(--tinta-suave)] hover:text-[color:var(--tinta)] cursor-pointer"
            >
              <X size={24} strokeWidth={1.5} aria-hidden="true" />
            </button>
          </div>
        </div>
      )}
    </ToastContext.Provider>
  );
}

export function useToast(): ToastContextValue {
  const context = useContext(ToastContext);
  if (!context) throw new Error("useToast debe usarse dentro de <ToastProvider>");
  return context;
}
</file>

<file path="frontend/src/lib/formato.ts">
/**
 * 3.7 Voz y formatos:
 * Moneda: "$ 1.250.000 COP", con puntos para miles y sin decimales.
 * Fechas: largas en texto ("11 de noviembre de 2026") y 11/11/2026 en tablas.
 * Horas en formato 24 h ("14:30").
 */
export function formatearMoneda(valor: string | number): string {
  const numero = typeof valor === "string" ? Number(valor) : valor;
  if (Number.isNaN(numero)) return "$ 0 COP";
  const miles = new Intl.NumberFormat("es-CO", {
    maximumFractionDigits: 0,
    minimumFractionDigits: 0,
  }).format(Math.round(numero));
  return `$ ${miles} COP`;
}

export function formatearFecha(fechaIso: string): string {
  const fecha = new Date(fechaIso);
  if (Number.isNaN(fecha.getTime())) return fechaIso;
  return new Intl.DateTimeFormat("es-CO", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(fecha);
}

export function formatearFechaTabla(fechaIso: string): string {
  const fecha = new Date(fechaIso);
  if (Number.isNaN(fecha.getTime())) return fechaIso;
  const dia = String(fecha.getDate()).padStart(2, "0");
  const mes = String(fecha.getMonth() + 1).padStart(2, "0");
  const anio = fecha.getFullYear();
  return `${dia}/${mes}/${anio}`;
}

export function formatearHora(fechaIso: string): string {
  const fecha = new Date(fechaIso);
  if (Number.isNaN(fecha.getTime())) return "";
  return new Intl.DateTimeFormat("es-CO", {
    hour: "2-digit",
    minute: "2-digit",
    hour12: false,
  }).format(fecha);
}

export function abreviarNombre(nombreOCorreo: string): string {
  const limpio = nombreOCorreo.trim();
  if (!limpio) return "";
  const base = limpio.includes("@") ? limpio.split("@")[0].replace(/[._-]+/g, " ") : limpio;
  const partes = base.split(/\s+/).filter(Boolean);
  if (partes.length === 1) {
    return partes[0].charAt(0).toUpperCase() + partes[0].slice(1).toLowerCase();
  }
  const nombre = partes[0].charAt(0).toUpperCase() + partes[0].slice(1).toLowerCase();
  const inicialApellido = partes[1].charAt(0).toUpperCase();
  return `${nombre} ${inicialApellido}.`;
}
</file>

<file path="frontend/src/lib/navegacion.ts">
import type { NombreRol } from "../types";

/** Vista principal de cada rol tras iniciar sesión: el catálogo es el destino
 * natural del Comprador, pero Artista y Curador trabajan en sus propios
 * paneles y aterrizar en el catálogo los deja sin punto de partida. */
export function rutaInicialPorRol(rol: NombreRol | null | undefined): string {
  switch (rol) {
    case "Artista":
      return "/artista";
    case "Curador":
      return "/curaduria";
    case "Administrador":
      return "/institucional";
    default:
      return "/";
  }
}
</file>

