                        clsx(
                          "relative flex h-[46px] items-center gap-1.5 font-[var(--fuente-texto)] font-semibold text-[1.08rem] tracking-[0.02em] no-underline transition-colors duration-[var(--duracion-hover)]",
                          esEnlacePrincipalActivo(enlace.to, isActive)
                            ? "border-b-2 border-[color:var(--riel)] text-[color:var(--riel)]"
                            : "border-b-2 border-transparent text-[color:var(--tinta-suave)] hover:text-[color:var(--tinta)]"
                        )
                      }
                    >
                      <span>{enlace.etiqueta}</span>
                      <ChevronDown
                        size={14}
                        strokeWidth={1.75}
                        aria-hidden="true"
                        className={clsx(
                          "transition-transform duration-200",
                          abierto ? "rotate-180 text-[color:var(--riel)]" : "opacity-75"
                        )}
                      />
                    </NavLink>

                    {/* Lista desplegable del menú (solo títulos de las secciones) */}
                    {abierto && (
                      <div
                        role="menu"
                        aria-label={`Submenú de ${enlace.etiqueta}`}
                        className="absolute left-1/2 top-full z-50 w-[240px] -translate-x-1/2 pt-1"
                      >
                        <div className="border border-[color:var(--borde-reposo)] bg-[#181614] py-1.5 shadow-[0_20px_50px_rgba(0,0,0,0.65)]">
                          <ul className="list-none m-0 p-0">
                            {enlace.subopciones.map((sub) => (
                              <li key={sub.to}>
                                <Link
                                  to={sub.to}
                                  role="menuitem"
                                  onClick={() => setMenuDesplegableActivo(null)}
                                  className="block px-4 py-2.5 font-[var(--fuente-texto)] text-[1.05rem] font-semibold leading-snug text-[color:var(--tinta)] no-underline transition-colors hover:bg-[color:var(--fila-hover)] hover:text-[color:var(--riel)]"
                                >
                                  {sub.etiqueta}
                                </Link>
                              </li>
                            ))}
                          </ul>
                        </div>
                      </div>
                    )}
                  </div>
                );
              })}
            </nav>
          </div>
        </div>

        {/* Menú Móvil a pantalla completa */}
        {menuMovilAbierto && (
          <div
            role="dialog"
            aria-modal="true"
            aria-label="Menú de navegación"
            className="fixed inset-0 z-50 flex flex-col justify-between overflow-y-auto bg-[color:var(--vacio)] p-[var(--espacio-24)] min-[1024px]:hidden"
          >
            <div className="flex items-center justify-between">
              <Link
                to="/"
                onClick={() => setMenuMovilAbierto(false)}
                className="no-underline"
              >
                <LogoMarca variante="riel" tamano="md" />
              </Link>
              <button
                type="button"
                onClick={() => setMenuMovilAbierto(false)}
                aria-label="Cerrar menú"
                className="inline-grid h-[var(--area-tactil-min)] w-[var(--area-tactil-min)] place-items-center bg-transparent border-0 text-[color:var(--tinta)] cursor-pointer"
              >
                <X size={24} strokeWidth={1.5} aria-hidden="true" />
              </button>
            </div>

            {/* Búsqueda dentro del menú móvil */}
            <form onSubmit={manejarBusqueda} className="my-[var(--espacio-24)]">
              <div className="relative flex w-full items-center">
                <Search
                  size={18}
                  strokeWidth={1.6}
                  aria-hidden="true"
                  className="pointer-events-none absolute left-[var(--espacio-16)] text-[color:var(--tinta-suave)]"
                />
                <input
                  type="search"
                  value={terminoBusqueda}
                  onChange={(e) => setTerminoBusqueda(e.target.value)}
                  placeholder="Buscar obras, artistas, técnicas…"
                  className="h-[44px] w-full rounded-[var(--radio-pildora)] border border-[color:var(--riel)] bg-[rgba(242,236,227,0.05)] pl-[44px] pr-[var(--espacio-16)] font-[var(--fuente-texto)] text-[1.05rem] text-[color:var(--tinta)] placeholder:text-[color:var(--tinta-suave)]"
                />
              </div>
            </form>

            <nav
              aria-label="Menú móvil"
              className="flex flex-col items-center gap-[var(--espacio-16)] text-center"
            >
              {enlacesMenuVisibles.map((enlace) => (
                <NavLink
                  key={enlace.to}
                  to={enlace.to}
                  onClick={() => setMenuMovilAbierto(false)}
                  className={({ isActive }) =>
                    clsx(
                      "font-[var(--fuente-titulo)] font-black text-[1.75rem] no-underline",
                      esEnlacePrincipalActivo(enlace.to, isActive)
                        ? "border-b-2 border-[color:var(--riel)] text-[color:var(--tinta)]"
                        : "text-[color:var(--tinta)] hover:text-[color:var(--riel)]"
                    )
                  }
                >
                  {enlace.etiqueta}
                </NavLink>
              ))}

              <div className="my-2 h-[1px] w-24 bg-[color:var(--divisor)]" />

              {user ? (
                <>
                  {enlacePanel && (
                    <NavLink
                      to={enlacePanel.to}
                      onClick={() => setMenuMovilAbierto(false)}
                      className="rounded-[var(--radio-pildora)] border border-[color:var(--riel)] bg-[color:var(--carmesi)] px-6 py-2 font-[var(--fuente-titulo)] font-black text-[1.45rem] text-[color:var(--tinta-inversa)] no-underline"
                    >
                      {enlacePanel.etiqueta}
                    </NavLink>
                  )}
                  {user.rol === "Comprador" && (
                    <NavLink
                      to="/mis-compras"
                      onClick={() => setMenuMovilAbierto(false)}
                      className="font-[var(--fuente-titulo)] font-black text-[1.5rem] text-[color:var(--tinta)] no-underline"
                    >
                      Mis compras
                    </NavLink>
                  )}
                  <NavLink
                    to="/cuenta"
                    onClick={() => setMenuMovilAbierto(false)}
                    className="font-[var(--fuente-titulo)] font-black text-[1.5rem] text-[color:var(--tinta)] no-underline"
                  >
                    Cuenta
                  </NavLink>
                  <button
                    type="button"
                    onClick={() => void cerrarSesion()}
                    className="mt-[var(--espacio-12)] bg-transparent border-0 border-b border-[color:var(--borde-terciario)] pb-[var(--espacio-4)] font-[var(--fuente-texto)] font-semibold text-[length:var(--text-cuerpo)] text-[color:var(--tinta)] cursor-pointer"
                  >
                    Cerrar sesión
                  </button>
                </>
              ) : (
                <div className="flex flex-wrap items-center justify-center gap-[var(--espacio-16)]">
                  <Link
                    to="/login"
                    onClick={() => setMenuMovilAbierto(false)}
                    className="rounded-[var(--radio-pildora)] border border-[color:var(--riel)] bg-[color:var(--carmesi)] px-6 py-2 font-[var(--fuente-titulo)] font-black text-[1.35rem] text-[color:var(--tinta)] no-underline"
                  >
                    Ingresar
                  </Link>
                  <Link
                    to="/registro"
                    onClick={() => setMenuMovilAbierto(false)}
                    className="rounded-[var(--radio-pildora)] border border-[color:var(--borde-reposo)] px-6 py-2 font-[var(--fuente-titulo)] font-black text-[1.35rem] text-[color:var(--tinta)] no-underline"
                  >
                    Registro
                  </Link>
                </div>
              )}
            </nav>

            <p className="voz-cuerpo-pequeno mt-6 text-center text-[color:var(--tinta-suave)]">
              © 2026 Pixel &amp; Lienzo
            </p>
          </div>
        )}
      </header>

      {renderDrawerCarrito()}
    </>
  );
}
</file>

<file path="frontend/src/App.tsx">
import { Route, Routes } from "react-router-dom";
import { Layout } from "./components/layout/Layout";
import { ProtectedRoute } from "./components/ProtectedRoute";
import { CatalogoPage } from "./pages/CatalogoPage";
import { ArtistaPublicoPage, ArtistasPage } from "./pages/ArtistasPage";
import {
  ColeccionesPage,
  ExposicionesPage,
  MasPage,
  QuienesSomosPalacioPage,
  SalaPalacioNacionalPage,
  UsoDelEspacioPalacioPage,
  VisitanosPalacioPage,
} from "./pages/SeccionesHeaderPages";
import { ObraDetallePage } from "./pages/ObraDetallePage";
import { MisComprasPage } from "./pages/MisComprasPage";
import { CuentaPage } from "./pages/CuentaPage";
import { LegalContactoPage } from "./pages/LegalContactoPage";
import { CheckoutResultadoPage } from "./pages/CheckoutResultadoPage";
import { NotFoundPage } from "./pages/NotFoundPage";
import { VerificarCertificadoPage } from "./pages/VerificarCertificadoPage";
import { LoginPage } from "./pages/auth/LoginPage";
import { MfaPage } from "./pages/auth/MfaPage";
import { RegistroPage } from "./pages/auth/RegistroPage";
import { RegistroCompradorPage } from "./pages/auth/RegistroCompradorPage";
import { QuieroFormarPartePage } from "./pages/artista/QuieroFormarPartePage";
import { VerificarEmailPage } from "./pages/auth/VerificarEmailPage";
import { RecuperarPasswordPage } from "./pages/auth/RecuperarPasswordPage";
import { RestablecerPasswordPage } from "./pages/auth/RestablecerPasswordPage";
import { ArtistaPanelPage } from "./pages/artista/ArtistaPanelPage";
import { ArtistaPerfilPage } from "./pages/artista/ArtistaPerfilPage";
import { ObraFormPage } from "./pages/artista/ObraFormPage";
import { CuraduriaPage } from "./pages/curaduria/CuraduriaPage";
import { PanelInstitucionalPage } from "./pages/institucional/Paginas";
import { EstudioMotionPage } from "./pages/EstudioMotionPage";
import { KitPage } from "./pages/KitPage";

function App() {
  return (
    <Routes>
      <Route element={<Layout />}>
        <Route index element={<CatalogoPage />} />
        {import.meta.env.DEV && <Route path="kit" element={<KitPage />} />}

        {/* Rutas principales del Header */}
        <Route path="sala-palacio-nacional" element={<SalaPalacioNacionalPage />} />
        <Route path="sala-palacio-nacional/quienes-somos" element={<QuienesSomosPalacioPage />} />
        <Route path="sala-palacio-nacional/visitanos" element={<VisitanosPalacioPage />} />
        <Route path="sala-palacio-nacional/uso-del-espacio" element={<UsoDelEspacioPalacioPage />} />
        <Route path="artistas" element={<ArtistasPage />} />
        <Route path="artistas/quiero-formar-parte" element={<QuieroFormarPartePage />} />
        <Route path="artistas/:id" element={<ArtistaPublicoPage />} />
        <Route path="exposiciones" element={<ExposicionesPage />} />
        <Route path="arte" element={<CatalogoPage />} />
        <Route path="colecciones" element={<ColeccionesPage />} />
        <Route path="mas" element={<MasPage />} />

        {/* Acepta la clave primaria o el UID de la obra: los QR físicos
            impresos junto a la pieza apuntan a `/obras/{uid}`. */}
        <Route path="obras/:idObra" element={<ObraDetallePage />} />
        <Route path="verificar/:sello" element={<VerificarCertificadoPage />} />
        <Route path="estudio" element={<EstudioMotionPage />} />

        {/* Páginas legales, contacto y cuenta */}
        <Route path="cuenta" element={<CuentaPage />} />
        <Route path="legal/:vista" element={<LegalContactoPage />} />
        <Route path="terminos" element={<LegalContactoPage vistaInicial="terminos" />} />
        <Route path="privacidad" element={<LegalContactoPage vistaInicial="privacidad" />} />
        <Route path="acerca" element={<LegalContactoPage vistaInicial="acerca" />} />
        <Route path="contacto" element={<LegalContactoPage vistaInicial="contacto" />} />

        <Route path="login" element={<LoginPage />} />
        <Route path="mfa" element={<MfaPage />} />
        <Route path="registro" element={<RegistroPage />} />
        <Route path="registro/comprador" element={<RegistroCompradorPage />} />
        <Route path="registro/artista" element={<QuieroFormarPartePage />} />
        <Route path="verificar-email" element={<VerificarEmailPage />} />
        <Route path="recuperar-password" element={<RecuperarPasswordPage />} />
        <Route path="restablecer-password" element={<RestablecerPasswordPage />} />

        <Route path="compras/:idTransaccion/resultado" element={<CheckoutResultadoPage />} />

        <Route element={<ProtectedRoute rolesPermitidos={["Comprador"]} />}>
          <Route path="mis-compras" element={<MisComprasPage />} />
        </Route>

        <Route element={<ProtectedRoute rolesPermitidos={["Artista"]} />}>
          <Route path="artista" element={<ArtistaPanelPage />} />
          <Route path="artista/perfil" element={<ArtistaPerfilPage />} />
          <Route path="artista/obras/nueva" element={<ObraFormPage />} />
          <Route path="artista/obras/:idObra/editar" element={<ObraFormPage />} />
        </Route>

        <Route element={<ProtectedRoute rolesPermitidos={["Curador"]} />}>
          <Route path="curaduria" element={<CuraduriaPage />} />
        </Route>

        <Route element={<ProtectedRoute rolesPermitidos={["Administrador"]} />}>
          <Route path="institucional" element={<PanelInstitucionalPage />} />
        </Route>

        <Route path="*" element={<NotFoundPage />} />
      </Route>
    </Routes>
  );
}

export default App;
</file>

