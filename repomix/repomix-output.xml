    line-height: 1.5;
    background-color: var(--fondo);
    color: var(--tinta);
    font-variant-numeric: lining-nums tabular-nums;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  /* 3.2 Jerarquía tipográfica */
  h1,
  h2,
  h3,
  h4 {
    font-family: var(--fuente-titulo);
    font-weight: 900;
    color: var(--tinta);
    font-variant-numeric: lining-nums tabular-nums;
  }

  h1 {
    font-size: var(--text-h1-movil);
    line-height: 1.1;
  }

  h2 {
    font-size: var(--text-h2-movil);
    line-height: 1.15;
  }

  h3 {
    font-size: var(--text-h3);
    line-height: 1.2;
  }

  h4 {
    font-size: var(--text-h4);
    line-height: 1.25;
  }

  @media (min-width: 600px) {
    h1 {
      font-size: var(--text-h1);
    }

    h2 {
      font-size: var(--text-h2);
    }
  }

  p {
    max-width: 70ch;
  }

  /* 3.2 Cifras alineadas en tablas, precios, inputs y datos */
  table,
  th,
  td,
  input,
  select,
  textarea,
  button,
  time,
  dd,
  .dato,
  .cifra {
    font-variant-numeric: lining-nums tabular-nums;
  }

  /* 3.4 y 7.2 Foco visible por teclado: contorno terracota de 2px con separación de 3px */
  :focus-visible {
    outline: 2px solid var(--carmesi);
    outline-offset: 3px;
  }

  ::selection {
    background-color: var(--carmesi);
    color: var(--tinta-inversa);
  }

  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }
  ::-webkit-scrollbar-track {
    background: var(--fondo);
  }
  ::-webkit-scrollbar-thumb {
    background: var(--borde-reposo);
    border-radius: var(--radio-recto);
  }
  ::-webkit-scrollbar-thumb:hover {
    background: var(--riel);
  }
}

/* ==========================================================
   Clases tipográficas y de layout según Sección 3.2 y 3.3
   ========================================================== */
@layer utilities {
