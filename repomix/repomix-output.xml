  className,
}: TabsProps<T>) {
  return (
    <div
      role="tablist"
      aria-label={ariaLabel}
      className={clsx(
        "flex flex-wrap items-center gap-[var(--espacio-24)] border-b border-[color:var(--divisor)]",
