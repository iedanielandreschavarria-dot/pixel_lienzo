import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import { useLocation, useNavigate, useSearchParams } from "react-router-dom";
import { useQuery } from "@tanstack/react-query";
import { Search, SlidersHorizontal, X } from "lucide-react";
import { listarCatalogo } from "../api/obras";
import { listarCategorias } from "../api/categorias";
import { formatearMoneda } from "../lib/formato";
import {
  ObraCard,
  coincideParametroObra,
  obtenerSlugObra,
} from "../components/ObraCard";
import { OBRAS_MUESTRA_PALACIO } from "../lib/obrasMuestraPalacio";
import { ObraLightbox } from "../components/catalogo/ObraLightbox";
import { Ambiente } from "../components/escena/Ambiente";
import { Button } from "../components/ui/Button";
import { Input } from "../components/ui/Input";
import { Select } from "../components/ui/Select";
import { EmptyState } from "../components/ui/EmptyState";
import { SectionError } from "../components/ui/SectionError";
import { SkeletonCardGrid } from "../components/ui/Skeleton";
import { Pagination } from "../components/ui/Pagination";
import { ArtistasPage } from "./ArtistasPage";
import { CuentaPage } from "./CuentaPage";
import { InicioPage } from "./InicioPage";
import type { Obra } from "../types";

type OrdenCatalogo = "recientes" | "precio_menor" | "precio_mayor" | "titulo_az";
type FiltroDisponibilidad = "todas" | "disponibles" | "vendidas";

const POR_PAGINA = 24;

interface ChipFiltro {
  clave: string;
  etiqueta: string;
  alQuitar: () => void;
}

/**
 * 6.3 Catálogo (Nivel 1):
 * H1 "Obras" con riel de 64 x 2 px debajo, barra de herramientas (búsqueda, botón "Filtros",
 * orden y contador), filtros laterales fijos de 280 px en escritorio, pantalla completa de
 * filtros en móvil con "Ver N obras", chips con "×" + "Limpiar filtros", rejilla 3.3 y
 * paginación numerada de 24 obras por página.
 */
export function CatalogoPage() {
  const location = useLocation();
  const navigate = useNavigate();
  const [searchParams, setSearchParams] = useSearchParams();
  const [modalFiltrosMovil, setModalFiltrosMovil] = useState(false);
  const [filtrosAbiertosEscritorio, setFiltrosAbiertosEscritorio] = useState(false);
  const triggerLightboxRef = useRef<HTMLElement | null>(null);

  const enRutaArte = location.pathname === "/arte" || location.pathname.startsWith("/arte/");
  const enVistaCuenta = searchParams.get("vista") === "cuenta";
  const enVistaArtistas =
    !enRutaArte &&
    !enVistaCuenta &&
    (location.hash === "#artistas" || searchParams.has("perfil_artista"));
  const enVistaCatalogo =
    enRutaArte ||
    (!enVistaCuenta &&
      !enVistaArtistas &&
      (location.hash === "#coleccion" || location.search.length > 0));

  // Parámetros sincronizados con la URL
  const busqueda = searchParams.get("q") ?? "";
  const idCategoriaParam = searchParams.get("categoria") ?? "";
  const tecnicaParam = searchParams.get("tecnica") ?? "";
  const idArtistaParam = searchParams.get("artista") ?? "";
  const precioMin = searchParams.get("precio_min") ?? "";
  const precioMax = searchParams.get("precio_max") ?? "";
  const disponibilidad = (searchParams.get("disponibilidad") as FiltroDisponibilidad | null) ?? "todas";
  const orden = (searchParams.get("orden") as OrdenCatalogo | null) ?? "recientes";
  const paginaActual = Math.max(1, Number(searchParams.get("pagina") ?? "1") || 1);
  const obraParam = searchParams.get("obra");

  const actualizarParametros = useCallback(
    (cambios: Record<string, string | null>, resetearPagina = true) => {
      const siguientes = new URLSearchParams(searchParams);
      for (const [clave, valor] of Object.entries(cambios)) {
        if (
          !valor ||
          valor.trim() === "" ||
          (clave === "disponibilidad" && valor === "todas") ||
          (clave === "orden" && valor === "recientes")
        ) {
          siguientes.delete(clave);
        } else {
          siguientes.set(clave, valor);
        }
      }
      if (resetearPagina) {
        siguientes.delete("pagina");
      }
      setSearchParams(siguientes, { replace: true });
    },
    [searchParams, setSearchParams]
  );

  const limpiarFiltros = () => {
    const siguientes = new URLSearchParams();
    if (orden !== "recientes") {
      siguientes.set("orden", orden);
    }
    setSearchParams(siguientes, { replace: true });
  };

  useEffect(() => {
    if (enVistaCatalogo) {
      document.title = "Obras · Pixel & Lienzo";
    }
  }, [enVistaCatalogo]);

  // Cierre con Escape del modal móvil de filtros
  useEffect(() => {
    if (!modalFiltrosMovil) return;
    const alTecla = (e: KeyboardEvent) => {
      if (e.key === "Escape") {
        setModalFiltrosMovil(false);
      }
    };
    window.addEventListener("keydown", alTecla);
    return () => window.removeEventListener("keydown", alTecla);
  }, [modalFiltrosMovil]);

  const filtrosApi = useMemo(
    () => ({
      id_categoria: idCategoriaParam === "" ? undefined : Number(idCategoriaParam),
      id_artista: idArtistaParam === "" ? undefined : Number(idArtistaParam),
      precio_min: precioMin === "" ? undefined : Number(precioMin),
      precio_max: precioMax === "" ? undefined : Number(precioMax),
    }),
    [idCategoriaParam, idArtistaParam, precioMin, precioMax]
  );

  const { data: categorias } = useQuery({
    queryKey: ["categorias"],
    queryFn: listarCategorias,
    enabled: enVistaCatalogo,
  });

  const {
    data: obrasApi,
    isLoading,
    isError,
    refetch,
  } = useQuery({
    queryKey: ["catalogo", filtrosApi],
    queryFn: () => listarCatalogo(filtrosApi),
    enabled: enVistaCatalogo,
    retry: 1,
  });

  // Si el backend aún no tiene obras publicadas o no está activo, mostramos el catálogo curatorial del Palacio Nacional
  const obrasBase = useMemo<Obra[]>(() => {
    if (obrasApi && obrasApi.length > 0) {
      return obrasApi;
    }
    return [...OBRAS_MUESTRA_PALACIO];
  }, [obrasApi]);

  // Lista de técnicas disponibles en las obras cargadas
  const tecnicasDisponibles = useMemo(() => {
    const conjunto = new Set<string>();
    for (const obra of obrasBase ?? []) {
      if (obra.tecnica?.trim()) {
        conjunto.add(obra.tecnica.trim());
      }
    }
    return Array.from(conjunto).sort((a, b) => a.localeCompare(b, "es"));
  }, [obrasBase]);

  // Filtrado en cliente complementario (búsqueda, técnica, disponibilidad) y ordenamiento
  const obrasFiltradas = useMemo(() => {
    const lista = [...(obrasBase ?? [])].filter((obra) => {
      if (busqueda.trim() !== "") {
        const q = busqueda.trim().toLowerCase();
        const coincideTitulo = obra.titulo.toLowerCase().includes(q);
        const coincideTecnica = obra.tecnica.toLowerCase().includes(q);
        if (!coincideTitulo && !coincideTecnica) return false;
      }
      if (tecnicaParam !== "" && obra.tecnica.trim() !== tecnicaParam) {
        return false;
      }
      if (disponibilidad === "disponibles" && obra.estado_obra !== "Publicado") {
        return false;
      }
      if (disponibilidad === "vendidas" && obra.estado_obra !== "Vendido") {
        return false;
      }
      return true;
    });

    lista.sort((a, b) => {
      if (orden === "precio_menor") {
        return Number(a.precio_venta) - Number(b.precio_venta);
      }
      if (orden === "precio_mayor") {
        return Number(b.precio_venta) - Number(a.precio_venta);
      }
      if (orden === "titulo_az") {
        return a.titulo.localeCompare(b.titulo, "es");
      }
      // "Más recientes": las disponibles van antes que las vendidas (Sección 6.3)
      const aVendida = a.estado_obra === "Vendido" ? 1 : 0;
      const bVendida = b.estado_obra === "Vendido" ? 1 : 0;
      if (aVendida !== bVendida) return aVendida - bVendida;
      return b.id_obra - a.id_obra;
    });

    return lista;
  }, [obrasBase, busqueda, tecnicaParam, disponibilidad, orden]);

  const hayFiltrosActivos =
    busqueda.trim() !== "" ||
    idCategoriaParam !== "" ||
    tecnicaParam !== "" ||
    idArtistaParam !== "" ||
    precioMin !== "" ||
    precioMax !== "" ||
    disponibilidad !== "todas";

  const chipsActivos: ChipFiltro[] = useMemo(() => {
    const chips: ChipFiltro[] = [];
    if (busqueda.trim() !== "") {
      chips.push({
        clave: "q",
        etiqueta: `Búsqueda: "${busqueda.trim()}"`,
        alQuitar: () => actualizarParametros({ q: null }),
      });
    }
    if (idCategoriaParam !== "") {
      const cat = categorias?.find((c) => String(c.id_categoria) === idCategoriaParam);
      chips.push({
        clave: "categoria",
        etiqueta: cat ? cat.nombre_categoria : `Categoría #${idCategoriaParam}`,
        alQuitar: () => actualizarParametros({ categoria: null }),
      });
    }
    if (tecnicaParam !== "") {
      chips.push({
        clave: "tecnica",
        etiqueta: tecnicaParam,
        alQuitar: () => actualizarParametros({ tecnica: null }),
      });
    }
    if (idArtistaParam !== "") {
      chips.push({
        clave: "artista",
        etiqueta: `Artista #${idArtistaParam}`,
        alQuitar: () => actualizarParametros({ artista: null }),
      });
    }
    if (precioMin !== "") {
      chips.push({
        clave: "precio_min",
        etiqueta: `Desde ${formatearMoneda(precioMin)}`,
        alQuitar: () => actualizarParametros({ precio_min: null }),
      });
    }
    if (precioMax !== "") {
      chips.push({
        clave: "precio_max",
        etiqueta: `Hasta ${formatearMoneda(precioMax)}`,
        alQuitar: () => actualizarParametros({ precio_max: null }),
      });
    }
    if (disponibilidad !== "todas") {
      chips.push({
        clave: "disponibilidad",
        etiqueta: disponibilidad === "disponibles" ? "Disponible" : "Vendida",
        alQuitar: () => actualizarParametros({ disponibilidad: null }),
      });
    }
    return chips;
  }, [
    busqueda,
    idCategoriaParam,
    tecnicaParam,
    idArtistaParam,
    precioMin,
    precioMax,
    disponibilidad,
    categorias,
    actualizarParametros,
  ]);

  const totalPaginas = Math.max(1, Math.ceil(obrasFiltradas.length / POR_PAGINA));
  const paginaSegura = Math.min(paginaActual, totalPaginas);
  const obrasPaginadas = useMemo(() => {
    const inicio = (paginaSegura - 1) * POR_PAGINA;
    return obrasFiltradas.slice(inicio, inicio + POR_PAGINA);
  }, [obrasFiltradas, paginaSegura]);

  // Lista navegable en Lightbox y resolución de obra activa desde ?obra=<slug>
  const listaLightbox = useMemo(() => {
    if (obrasFiltradas.length > 0) return obrasFiltradas;
    return obrasBase ?? [];
  }, [obrasFiltradas, obrasBase]);

  const indiceObraLightbox = useMemo(() => {
    if (!obraParam) return -1;
    const idxEnLista = listaLightbox.findIndex((o) => coincideParametroObra(o, obraParam));
    if (idxEnLista >= 0) return idxEnLista;
    return (obrasBase ?? []).findIndex((o) => coincideParametroObra(o, obraParam));
  }, [obraParam, listaLightbox, obrasBase]);

  const obraLightboxActiva: Obra | null = useMemo(() => {
    if (!obraParam) return null;
    const enLista = listaLightbox.find((o) => coincideParametroObra(o, obraParam));
    if (enLista) return enLista;
    return (obrasBase ?? []).find((o) => coincideParametroObra(o, obraParam)) ?? null;
  }, [obraParam, listaLightbox, obrasBase]);

  const abrirLightboxObra = useCallback(
    (obra: Obra, triggerEl: HTMLElement) => {
      triggerLightboxRef.current = triggerEl;
      const siguientes = new URLSearchParams(searchParams);
      siguientes.set("obra", obtenerSlugObra(obra));
      navigate(
        {
          pathname: location.pathname,
          search: `?${siguientes.toString()}`,
          hash: enRutaArte ? "" : location.hash || "#coleccion",
        },
        { replace: false }
      );
    },
    [searchParams, navigate, location.pathname, location.hash, enRutaArte]
  );

  const cerrarLightbox = useCallback(() => {
    const siguientes = new URLSearchParams(searchParams);
    siguientes.delete("obra");
    const searchStr = siguientes.toString();
    navigate(
      {
        pathname: location.pathname,
        search: searchStr ? `?${searchStr}` : "",
        hash: enRutaArte ? "" : "#coleccion",
      },
      { replace: true }
    );
  }, [searchParams, navigate, location.pathname, enRutaArte]);

  const irObraAnteriorLightbox = useCallback(() => {
    const coleccion = listaLightbox.length > 0 ? listaLightbox : (obrasBase ?? []);
    if (coleccion.length <= 1) return;
    const actualIdx = Math.max(
      0,
      coleccion.findIndex((o) => o.id_obra === obraLightboxActiva?.id_obra)
    );
    const prevIdx = (actualIdx - 1 + coleccion.length) % coleccion.length;
    const prevObra = coleccion[prevIdx];
    if (!prevObra) return;
    const siguientes = new URLSearchParams(searchParams);
    siguientes.set("obra", obtenerSlugObra(prevObra));
    setSearchParams(siguientes, { replace: true });
  }, [listaLightbox, obrasBase, obraLightboxActiva, searchParams, setSearchParams]);

  const irObraSiguienteLightbox = useCallback(() => {
    const coleccion = listaLightbox.length > 0 ? listaLightbox : (obrasBase ?? []);
    if (coleccion.length <= 1) return;
    const actualIdx = Math.max(
      0,
      coleccion.findIndex((o) => o.id_obra === obraLightboxActiva?.id_obra)
    );
    const nextIdx = (actualIdx + 1) % coleccion.length;
    const nextObra = coleccion[nextIdx];
    if (!nextObra) return;
    const siguientes = new URLSearchParams(searchParams);
    siguientes.set("obra", obtenerSlugObra(nextObra));
    setSearchParams(siguientes, { replace: true });
  }, [listaLightbox, obrasBase, obraLightboxActiva, searchParams, setSearchParams]);

  if (enVistaCuenta) {
    return <CuentaPage />;
  }

  if (enVistaArtistas) {
    return <ArtistasPage />;
  }

  if (!enVistaCatalogo) {
    return (
      <InicioPage
        onExplorarCatalogo={() => {
          window.scrollTo({ top: 0, behavior: "auto" });
          navigate("/arte");
        }}
      />
    );
  }

  const renderControlesFiltro = (prefijoId: string) => (
    <div className="flex flex-col gap-[var(--espacio-24)]">
      <Select
        id={`${prefijoId}-categoria`}
        label="Categoría"
        value={idCategoriaParam}
        onChange={(e) => actualizarParametros({ categoria: e.target.value || null })}
      >
        <option value="">Todas las categorías</option>
        {categorias?.map((c) => (
          <option key={c.id_categoria} value={String(c.id_categoria)}>
            {c.nombre_categoria}
          </option>
        ))}
      </Select>

      <Select
        id={`${prefijoId}-tecnica`}
        label="Técnica"
        value={tecnicaParam}
        onChange={(e) => actualizarParametros({ tecnica: e.target.value || null })}
      >
        <option value="">Todas las técnicas</option>
        {tecnicasDisponibles.map((tec) => (
          <option key={tec} value={tec}>
            {tec}
          </option>
        ))}
      </Select>

      <div className="grid grid-cols-2 gap-[var(--espacio-12)]">
        <Input
          id={`${prefijoId}-precio-min`}
          variante="caja"
          label="Precio mínimo"
          type="number"
          min={0}
          placeholder="0"
          value={precioMin}
          onChange={(e) => actualizarParametros({ precio_min: e.target.value || null })}
        />
        <Input
          id={`${prefijoId}-precio-max`}
          variante="caja"
          label="Precio máximo"
          type="number"
          min={0}
          placeholder="Sin límite"
          value={precioMax}
          onChange={(e) => actualizarParametros({ precio_max: e.target.value || null })}
        />
      </div>

      <Select
        id={`${prefijoId}-disponibilidad`}
        label="Disponibilidad"
        value={disponibilidad}
        onChange={(e) => actualizarParametros({ disponibilidad: e.target.value })}
      >
        <option value="todas">Todas</option>
        <option value="disponibles">Disponible</option>
        <option value="vendidas">Vendida</option>
      </Select>

      {hayFiltrosActivos && (
        <Button
          type="button"
          variante="terciario"
          onClick={limpiarFiltros}
          className="self-start"
        >
          Limpiar filtros
        </Button>
      )}
    </div>
  );

  return (
    <section
      id="coleccion"
      aria-labelledby="catalogo-titulo"
      className="relative min-h-screen py-[var(--espacio-48)] animate-[aparecer-pagina_500ms_ease_forwards]"
    >
      <Ambiente nivel={1} />

      <div className="catalogo relative z-10">
        {/* Cabecera de sección: H1 "Obras" con riel de 64 px por 2 px en --riel debajo */}
        <header className="mb-[var(--espacio-32)]">
          <p className="voz-etiqueta mb-2 text-[color:var(--tinta-suave)]">
            Colección curatorial verificada
          </p>
          <h1 id="catalogo-titulo" className="voz-h1 text-[color:var(--tinta)]">
            Obras
          </h1>
          <div
            aria-hidden="true"
            className="mt-[var(--espacio-12)] h-[2px] w-[var(--espacio-64)] bg-[color:var(--riel)]"
          />
        </header>

        {/* Barra de herramientas: búsqueda, botón "Filtros", orden y contador */}
        <div className="mb-[var(--espacio-24)] flex flex-wrap items-end justify-between gap-[var(--espacio-16)] border-b border-[color:var(--divisor)] pb-[var(--espacio-24)]">
          <div className="flex flex-1 flex-wrap items-end gap-[var(--espacio-16)]">
            <div className="relative min-w-[min(260px,100%)] flex-1 max-w-[var(--contenedor-formulario)]">
              <Input
                variante="caja"
                label="Buscar obra"
                type="search"
                placeholder="Título o técnica…"
                value={busqueda}
                onChange={(e) => actualizarParametros({ q: e.target.value || null })}
                className="pr-[var(--espacio-48)]"
              />
              <Search
                size={20}
                strokeWidth={1.5}
                aria-hidden="true"
                className="pointer-events-none absolute right-[var(--espacio-16)] bottom-[14px] text-[color:var(--tinta-suave)]"
              />
            </div>

            <div className="min-[960px]:hidden">
              <Button
                type="button"
                variante="secundario"
                onClick={() => setModalFiltrosMovil(true)}
              >
                <SlidersHorizontal size={18} strokeWidth={1.5} aria-hidden="true" />
                <span>Filtros{chipsActivos.length > 0 ? ` (${chipsActivos.length})` : ""}</span>
              </Button>
            </div>

            <div className="hidden min-[960px]:block">
              <Button
                type="button"
                variante="secundario"
                aria-expanded={filtrosAbiertosEscritorio}
                onClick={() => setFiltrosAbiertosEscritorio((prev) => !prev)}
              >
                <SlidersHorizontal size={18} strokeWidth={1.5} aria-hidden="true" />
                <span>Filtros{chipsActivos.length > 0 ? ` (${chipsActivos.length})` : ""}</span>
              </Button>
            </div>
          </div>

          <div className="flex flex-wrap items-end gap-[var(--espacio-24)]">
            <div className="min-w-[210px]">
              <Select
                label="Ordenar por"
                value={orden}
                onChange={(e) =>
                  actualizarParametros({ orden: e.target.value }, false)
                }
              >
                <option value="recientes">Más recientes</option>
                <option value="precio_menor">Precio menor</option>
                <option value="precio_mayor">Precio mayor</option>
                <option value="titulo_az">Título de A a Z</option>
              </Select>
            </div>

            <p
              aria-live="polite"
              className="precio-obra pb-[var(--espacio-12)] text-[length:var(--text-cuerpo-pequeno)] text-[color:var(--tinta-suave)]"
            >
              {obrasFiltradas.length} {obrasFiltradas.length === 1 ? "obra" : "obras"}
            </p>
          </div>
        </div>

        {/* Panel desplegable de filtros en escritorio (preserva el ancho completo 1040px para las 4 columnas Masonry) */}
        {filtrosAbiertosEscritorio && (
          <aside
            aria-label="Filtros del catálogo"
            className="mb-[var(--espacio-24)] hidden border border-[color:var(--divisor)] bg-[rgba(242,236,227,0.02)] p-[var(--espacio-24)] min-[960px]:block"
          >
            <div className="mb-4 flex items-center justify-between">
              <h2 className="voz-etiqueta text-[color:var(--tinta-suave)]">
                Filtrar colección
              </h2>
              <button
                type="button"
                onClick={() => setFiltrosAbiertosEscritorio(false)}
                aria-label="Ocultar panel de filtros"
                className="text-[color:var(--tinta-suave)] hover:text-[color:var(--tinta)] cursor-pointer"
              >
                <X size={18} strokeWidth={1.5} aria-hidden="true" />
              </button>
            </div>
            {renderControlesFiltro("escritorio")}
          </aside>
        )}

        {/* Chips de filtros aplicados con "×" y "Limpiar filtros" */}
        {chipsActivos.length > 0 && (
          <div
            aria-label="Filtros aplicados"
            className="mb-[var(--espacio-24)] flex flex-wrap items-center gap-[var(--espacio-8)]"
          >
            {chipsActivos.map((chip) => (
              <button
                key={chip.clave}
                type="button"
                onClick={chip.alQuitar}
                className="inline-flex min-h-[var(--alto-control-compacto)] items-center gap-[var(--espacio-8)] rounded-[var(--radio-pildora)] border border-[color:var(--riel)] bg-[color:var(--superficie-elevada)] px-[var(--espacio-16)] py-[var(--espacio-4)] font-[var(--fuente-texto)] text-[length:var(--text-cuerpo-pequeno)] text-[color:var(--tinta)] transition-colors duration-[var(--duracion-hover)] hover:border-white cursor-pointer"
              >
                <span>{chip.etiqueta}</span>
                <span aria-hidden="true" className="text-[color:var(--riel)]">
                  ×
                </span>
              </button>
            ))}

            <Button
              type="button"
              variante="terciario"
              onClick={limpiarFiltros}
              className="ml-[var(--espacio-8)]"
            >
              Limpiar filtros
            </Button>
          </div>
        )}

        {/* Cuadrícula de obras del catálogo */}
        <div>
          {isLoading && <SkeletonCardGrid cantidad={8} />}

          {!isLoading && obrasFiltradas.length === 0 && hayFiltrosActivos && (
            <EmptyState
              titulo="Ninguna obra coincide con tu búsqueda."
              accion={
                <Button variante="secundario" onClick={limpiarFiltros}>
                  Limpiar filtros
                </Button>
              }
            />
          )}

          {!isLoading && obrasFiltradas.length === 0 && !hayFiltrosActivos && isError && (
            <SectionError
              recurso="las obras"
              onReintentar={() => {
                void refetch();
              }}
            />
          )}

          {!isLoading && obrasPaginadas.length > 0 && (
            <>
              <div className="catalogo__masonry" role="list">
                {obrasPaginadas.map((obra, idx) => (
                  <ObraCard
                    key={obra.id_obra}
                    obra={obra}
                    prioridad={idx < 4}
                    onSelect={abrirLightboxObra}
                  />
                ))}
              </div>

              <Pagination
                paginaActual={paginaSegura}
                totalPaginas={totalPaginas}
                onChange={(nuevaPagina) => {
                  actualizarParametros(
                    { pagina: nuevaPagina > 1 ? String(nuevaPagina) : null },
                    false
                  );
                  window.scrollTo({ top: 0, behavior: "smooth" });
                }}
                className="mt-[var(--espacio-48)]"
              />
            </>
          )}
        </div>
      </div>

      {/* Lightbox interactivo sincronizado con ?obra=<slug> */}
      <ObraLightbox
        obra={obraLightboxActiva}
        indiceActual={Math.max(0, indiceObraLightbox)}
        totalObras={listaLightbox.length || (obrasBase?.length ?? 0)}
        onClose={cerrarLightbox}
        onPrev={irObraAnteriorLightbox}
        onNext={irObraSiguienteLightbox}
        triggerRef={triggerLightboxRef}
      />

      {/* Modal de pantalla completa para filtros en móvil */}
      {modalFiltrosMovil && (
        <div
          role="dialog"
          aria-modal="true"
          aria-label="Filtros"
          className="fixed inset-0 z-50 flex flex-col bg-[color:var(--fondo)] p-[var(--espacio-24)] min-[960px]:hidden"
        >
          <div className="flex items-center justify-between border-b border-[color:var(--divisor)] pb-[var(--espacio-16)]">
            <h2 className="voz-h3 text-[color:var(--tinta)]">Filtros</h2>
            <button
              type="button"
              onClick={() => setModalFiltrosMovil(false)}
              aria-label="Cerrar filtros"
              className="inline-grid h-[var(--area-tactil-min)] w-[var(--area-tactil-min)] place-items-center bg-transparent border-0 text-[color:var(--tinta)] cursor-pointer"
            >
              <X size={24} strokeWidth={1.5} aria-hidden="true" />
            </button>
          </div>

          <div className="flex-1 overflow-y-auto py-[var(--espacio-24)]">
            {renderControlesFiltro("movil")}
          </div>

          <div className="border-t border-[color:var(--divisor)] pt-[var(--espacio-16)]">
            <Button
              type="button"
              variante="primario"
              onClick={() => setModalFiltrosMovil(false)}
              className="w-full"
            >
              Ver {obrasFiltradas.length} {obrasFiltradas.length === 1 ? "obra" : "obras"}
            </Button>
          </div>
        </div>
      )}
    </section>
  );
}
</file>

<file path="src/pages/CheckoutPage.tsx">
import { useEffect, useState } from "react";
import { Link, Navigate, useLocation, useParams, useSearchParams } from "react-router-dom";
import { useQuery } from "@tanstack/react-query";
import { obtenerObra, urlPreviewObra } from "../api/obras";
import { crearTransaccion, obtenerCheckoutWompi } from "../api/transacciones";
import { useAuth } from "../context/AuthContext";
import { Ambiente } from "../components/escena/Ambiente";
import { Banner } from "../components/ui/Banner";
import { Button } from "../components/ui/Button";
import { EmptyState } from "../components/ui/EmptyState";
import { PageProgressBar, Skeleton } from "../components/ui/Skeleton";
import { formatearMoneda } from "../lib/formato";
import { NotFoundPage } from "./NotFoundPage";

export interface CheckoutPageProps {
  idObraProp?: number;
}

/**
 * 6.8 Checkout (Nivel 1 — máxima sobriedad):
 * Cabecera simplificada (marca y "Volver a la obra", sin menú global ni pie).
 * Dos columnas en escritorio:
 * - Izquierda (60 %): pasos en vertical numerados con Anton.
 * - Derecha (40 %, fija): miniatura de 96 px, título, artista, precio y total en H2.
 * Botón primario a ancho completo con el monto exacto: "Pagar $ 1.250.000 COP".
 * Móvil: barra inferior plegable con "Ver resumen".
 * Obra vendida durante el proceso: "Esta obra ya fue adquirida." con "Ver obras similares".
 */
export function CheckoutPage({ idObraProp }: CheckoutPageProps) {
  const { idObra: idParam } = useParams<{ idObra: string }>();
  const [searchParams] = useSearchParams();
  const location = useLocation();
  const { user } = useAuth();

  const idObra = idObraProp ?? Number(idParam ?? searchParams.get("obra") ?? "0");
  const idTransaccionExistente = Number(searchParams.get("transaccion") ?? "0");

  const [procesando, setProcesando] = useState(false);
  const [errorPago, setErrorPago] = useState(false);
  const [resumenMovilAbierto, setResumenMovilAbierto] = useState(false);

  const {
    data: obra,
    isLoading,
    isError,
  } = useQuery({
    queryKey: ["obra", idObra],
    queryFn: () => obtenerObra(idObra),
    enabled: idObra > 0,
  });

  useEffect(() => {
    document.title = obra ? `Pago · ${obra.titulo} · Pixel & Lienzo` : "Pago · Pixel & Lienzo";
  }, [obra]);

  if (!user) {
    return <Navigate to="/login" state={{ from: location }} replace />;
  }

  if (isLoading) {
    return (
      <div className="relative min-h-[calc(100vh-var(--alto-cabecera))] py-[var(--espacio-48)]">
        <PageProgressBar etiqueta="Cargando resumen de compra…" />
        <Ambiente nivel={1} />
        <div className="contenedor-pyl relative z-10 grid grid-cols-1 gap-[var(--espacio-48)] min-[1024px]:grid-cols-[3fr_2fr]">
          <div className="flex flex-col gap-[var(--espacio-24)]">
            <Skeleton className="h-[140px] w-full" />
            <Skeleton className="h-[180px] w-full" />
          </div>
          <Skeleton className="h-[260px] w-full" />
        </div>
      </div>
    );
  }

  if (isError || !obra || idObra <= 0) {
    return <NotFoundPage />;
  }

  // 6.8: Obra vendida durante el proceso -> pantalla de estado "Esta obra ya fue adquirida." con "Ver obras similares"
  if (obra.estado_obra === "Vendido") {
    return (
      <div className="relative flex min-h-[calc(100vh-var(--alto-cabecera))] items-center justify-center py-[var(--espacio-64)]">
        <Ambiente nivel={1} />
        <div className="contenedor-pyl relative z-10 max-w-[var(--contenedor-resultado)]">
          <EmptyState
            titulo="Esta obra ya fue adquirida."
            accion={
              <Link to={`/#coleccion?categoria=${obra.id_categoria}`}>
                <Button variante="secundario">Ver obras similares</Button>
              </Link>
            }
          />
        </div>
      </div>
    );
  }

  const montoFormateado = formatearMoneda(obra.precio_venta);

  const confirmarYPagar = async () => {
    if (procesando) return;
    setProcesando(true);
    setErrorPago(false);
    try {
      if (idTransaccionExistente > 0) {
        const reintento = await obtenerCheckoutWompi(idTransaccionExistente);
        window.location.href = reintento.checkout_url;
        return;
      }
      const transaccion = await crearTransaccion(obra.id_obra);
      window.location.href = transaccion.checkout_url;
    } catch {
      setErrorPago(true);
      setProcesando(false);
    }
  };

  return (
    <div className="relative min-h-[calc(100vh-var(--alto-cabecera))] pb-[calc(var(--alto-barra-compra-movil)+var(--espacio-48))] pt-[var(--espacio-48)] min-[1024px]:pb-[var(--espacio-64)]">
      <Ambiente nivel={1} />

      <div className="contenedor-pyl relative z-10">
        {errorPago && (
          <div className="mb-[var(--espacio-24)]">
            <Banner variante="aviso">
              No pudimos procesar el pago. Revisa los datos e inténtalo de nuevo.
            </Banner>
          </div>
        )}

        <div className="grid grid-cols-1 gap-[var(--espacio-48)] min-[1024px]:grid-cols-[3fr_2fr] min-[1024px]:items-start">
          {/* Columna izquierda (60 %): pasos en vertical numerados con Anton */}
          <div className="flex flex-col gap-[var(--espacio-24)]">
            {/* Paso 1: Datos del comprador (resumen de sesión) */}
            <section
              aria-labelledby="checkout-paso-1"
              className="border border-[color:var(--divisor)] bg-[color:var(--fondo)] p-[var(--espacio-24)]"
            >
              <div className="flex items-center justify-between gap-[var(--espacio-16)]">
                <div className="flex items-center gap-[var(--espacio-12)]">
                  <span className="font-[var(--fuente-poster)] text-[length:var(--text-etiqueta)] uppercase tracking-[0.12em] text-[color:var(--riel)]">
                    01
                  </span>
                  <h1 id="checkout-paso-1" className="voz-h3 text-[color:var(--tinta)]">
                    Datos del comprador
                  </h1>
                </div>
              </div>

              <dl className="mt-[var(--espacio-16)] grid grid-cols-1 gap-[var(--espacio-12)] border-t border-[color:var(--divisor)] pt-[var(--espacio-16)] sm:grid-cols-2">
                <div>
                  <dt className="voz-cuerpo-pequeno text-[color:var(--tinta-suave)]">Correo</dt>
                  <dd className="voz-cuerpo mt-[var(--espacio-4)] font-semibold text-[color:var(--tinta)]">
                    {user.correo_electronico}
                  </dd>
                </div>
                <div>
                  <dt className="voz-cuerpo-pequeno text-[color:var(--tinta-suave)]">Rol de cuenta</dt>
                  <dd className="voz-cuerpo mt-[var(--espacio-4)] font-semibold text-[color:var(--tinta)]">
                    Coleccionista
                  </dd>
                </div>
              </dl>
            </section>

            {/* Paso 2: Pago */}
            <section
              aria-labelledby="checkout-paso-2"
              className="border border-[color:var(--borde-reposo)] bg-[color:var(--fondo)] p-[var(--espacio-24)]"
            >
              <div className="flex items-center gap-[var(--espacio-12)]">
                <span className="font-[var(--fuente-poster)] text-[length:var(--text-etiqueta)] uppercase tracking-[0.12em] text-[color:var(--riel)]">
                  02
                </span>
                <h2 id="checkout-paso-2" className="voz-h3 text-[color:var(--tinta)]">
                  Pago
                </h2>
              </div>

              <p className="voz-cuerpo mt-[var(--espacio-16)] text-[color:var(--tinta-suave)]">
                Al continuar serás redirigido de forma segura a la pasarela de pagos Wompi para completar la transacción.
              </p>

              <div className="mt-[var(--espacio-24)]">
                <Button
                  type="button"
                  variante="primario"
                  cargando={procesando}
                  disabled={procesando}
                  onClick={confirmarYPagar}
                  className="w-full"
                >
                  Pagar {montoFormateado}
                </Button>
              </div>
            </section>
          </div>

          {/* Columna derecha (40 %, fija en escritorio): miniatura de 96 px, título, artista, precio y total en H2 */}
          <aside
            aria-label="Resumen del pedido"
            className="border border-[color:var(--borde-reposo)] bg-[color:var(--fondo)] p-[var(--espacio-24)] min-[1024px]:sticky min-[1024px]:top-[calc(var(--alto-cabecera)+var(--espacio-24))]"
          >
            <div className="flex items-center gap-[var(--espacio-16)] pb-[var(--espacio-24)] border-b border-[color:var(--divisor)]">
              <div className="flex h-[var(--miniatura-lista)] w-[var(--miniatura-lista)] shrink-0 items-center justify-center border border-[color:var(--divisor)] bg-[color:var(--vacio)] p-[var(--espacio-8)]">
                <img
                  src={urlPreviewObra(obra.id_obra)}
                  alt={obra.titulo}
                  className="h-full w-full object-contain"
                />
              </div>

              <div className="min-w-0 flex-1">
                <h3 className="voz-h3 truncate text-[color:var(--tinta)]">{obra.titulo}</h3>
                <p className="voz-cursiva mt-[var(--espacio-4)] text-[color:var(--tinta-suave)]">
                  Artista N.º {obra.id_artista}
                </p>
                <p className="voz-cuerpo-pequeno mt-[var(--espacio-4)] text-[color:var(--tinta-suave)]">
                  {obra.tecnica} · {obra.dimensiones}
                </p>
              </div>
            </div>

            <dl className="mt-[var(--espacio-24)] flex flex-col gap-[var(--espacio-12)]">
              <div className="flex items-baseline justify-between gap-[var(--espacio-16)]">
                <dt className="voz-cuerpo-pequeno text-[color:var(--tinta-suave)]">Precio de la obra</dt>
                <dd className="precio-obra voz-cuerpo-pequeno font-semibold text-[color:var(--tinta)]">
                  {montoFormateado}
                </dd>
              </div>
              <div className="flex items-baseline justify-between gap-[var(--espacio-16)] border-t border-[color:var(--divisor)] pt-[var(--espacio-16)]">
                <dt className="voz-cuerpo font-semibold text-[color:var(--tinta)]">Total</dt>
                <dd className="voz-h2 precio-obra text-[color:var(--tinta)]">{montoFormateado}</dd>
              </div>
            </dl>
          </aside>
        </div>
      </div>

      {/* Móvil: barra inferior plegable con el total siempre visible y "Ver resumen" */}
      <div className="fixed inset-x-0 bottom-0 z-40 border-t border-[color:var(--riel)] bg-[color:var(--fondo)] p-[var(--espacio-16)] min-[1024px]:hidden">
        {resumenMovilAbierto && (
          <div className="mb-[var(--espacio-16)] flex items-center gap-[var(--espacio-12)] border-b border-[color:var(--divisor)] pb-[var(--espacio-12)]">
            <div className="flex h-[var(--espacio-64)] w-[var(--espacio-64)] shrink-0 items-center justify-center border border-[color:var(--divisor)] bg-[color:var(--vacio)] p-[var(--espacio-4)]">
              <img
                src={urlPreviewObra(obra.id_obra)}
                alt={obra.titulo}
                className="h-full w-full object-contain"
              />
            </div>
            <div className="min-w-0 flex-1">
              <p className="truncate font-[var(--fuente-titulo)] text-[length:var(--text-cuerpo)] font-black text-[color:var(--tinta)]">
                {obra.titulo}
              </p>
              <p className="voz-cursiva text-[length:var(--text-cuerpo-pequeno)] text-[color:var(--tinta-suave)]">
                Artista N.º {obra.id_artista}
              </p>
            </div>
          </div>
        )}

        <div className="flex items-center justify-between gap-[var(--espacio-16)]">
          <div>
            <p className="voz-cuerpo-pequeno text-[color:var(--tinta-suave)]">Total</p>
            <p className="precio-obra font-[var(--fuente-titulo)] text-[length:var(--text-h3)] font-black text-[color:var(--tinta)]">
              {montoFormateado}
            </p>
          </div>

          <button
            type="button"
            onClick={() => setResumenMovilAbierto((v) => !v)}
            aria-expanded={resumenMovilAbierto}
            className="enlace-acceso bg-transparent border-0 p-0 text-[length:var(--text-cuerpo-pequeno)] cursor-pointer"
          >
            {resumenMovilAbierto ? "Ocultar resumen" : "Ver resumen"}
          </button>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/pages/CheckoutResultadoPage.tsx">
import { useEffect, useState } from "react";
import { Link, useParams } from "react-router-dom";
import { useQuery } from "@tanstack/react-query";
import { Check, Clock } from "lucide-react";
import clsx from "clsx";
import { obtenerTransaccion } from "../api/transacciones";
import { obtenerObra, urlPreviewObra } from "../api/obras";
import { obtenerCertificado } from "../api/certificados";
import { useAuth } from "../context/AuthContext";
import { Ambiente } from "../components/escena/Ambiente";
import { Button } from "../components/ui/Button";
import { SelloCertificado } from "../components/ui/SelloCertificado";
import { PageProgressBar, Skeleton } from "../components/ui/Skeleton";
import { formatearFecha, formatearMoneda } from "../lib/formato";
import { NotFoundPage } from "./NotFoundPage";

const INTERVALO_POLL_MS = 4000;
const MAX_INTENTOS = 30;

/**
 * 6.9 Resultado de checkout (Nivel 1):
 * Contenido centrado de 640 px con icono de 48 px, H1, texto, resumen de la compra
 * (obra, monto, fecha y referencia), aviso "Enviamos el comprobante a [correo]." y acciones.
 * Si la referencia no existe, 404.
 * Cuando un pago pendiente pasa a aprobado, la página se actualiza sola y el sello aparece con
 * un fundido de 800 ms.
 */
export function CheckoutResultadoPage() {
  const { idTransaccion } = useParams<{ idTransaccion: string }>();
  const { user } = useAuth();
  const id = Number(idTransaccion);

  const [intentos, setIntentos] = useState(0);
  const [selloVisible, setSelloVisible] = useState(false);

  const {
    data: transaccion,
    isLoading,
    isError,
  } = useQuery({
    queryKey: ["transaccion", id],
    queryFn: () => obtenerTransaccion(id),
    enabled: !Number.isNaN(id) && id > 0,
    refetchInterval: (query) => {
      const estado = query.state.data?.estado_pago;
      if (estado === "Procesando" && intentos < MAX_INTENTOS) return INTERVALO_POLL_MS;
      return false;
    },
  });

  const { data: obra } = useQuery({
    queryKey: ["obra", transaccion?.id_obra],
    queryFn: () => obtenerObra(transaccion!.id_obra),
    enabled: !!transaccion,
  });

  const esAprobado =
    transaccion?.estado_pago === "Confirmado" ||
    transaccion?.estado_pago === "Dispersado";

  const { data: certificado } = useQuery({
    queryKey: ["certificado", transaccion?.id_obra],
    queryFn: () => obtenerCertificado(transaccion!.id_obra),
    enabled: !!transaccion && esAprobado,
    retry: false,
  });

  useEffect(() => {
    if (transaccion?.estado_pago === "Procesando") {
      const timer = window.setTimeout(() => setIntentos((n) => n + 1), INTERVALO_POLL_MS);
      return () => window.clearTimeout(timer);
    }
  }, [transaccion, intentos]);

  // Único movimiento permitido: fundido de 800 ms del sello al aprobarse el pago
  useEffect(() => {
    if (!esAprobado) {
      setSelloVisible(false);
      return;
    }
    const timer = window.setTimeout(() => setSelloVisible(true), 40);
    return () => window.clearTimeout(timer);
  }, [esAprobado]);

  useEffect(() => {
    document.title = "Resultado del pago · Pixel & Lienzo";
  }, []);

  if (isLoading) {
    return (
      <div className="relative min-h-screen py-[var(--espacio-64)]">
        <PageProgressBar etiqueta="Consultando el estado de tu pago…" />
        <Ambiente nivel={1} />
        <div className="mx-auto flex max-w-[var(--contenedor-resultado)] flex-col items-center gap-[var(--espacio-24)] px-[var(--espacio-16)]">
          <Skeleton className="h-[var(--espacio-48)] w-[var(--espacio-48)] rounded-[var(--radio-circulo)]" />
          <Skeleton className="h-[var(--espacio-48)] w-2/3" />
          <Skeleton className="h-[var(--espacio-24)] w-3/4" />
          <Skeleton className="mt-[var(--espacio-16)] h-[220px] w-full" />
        </div>
      </div>
    );
  }

  if (isError || !transaccion || Number.isNaN(id) || id <= 0) {
    return <NotFoundPage />;
  }

  const esPendiente = transaccion.estado_pago === "Procesando";
  const esRechazado = !esAprobado && !esPendiente;

  const titulo = esAprobado
    ? "Pago aprobado"
    : esPendiente
      ? "Pago en proceso"
      : "El pago no se completó";

  const textoDescripcion = esAprobado
    ? certificado
      ? "Tu certificado de autenticidad ya está disponible."
      : "Estamos generando tu certificado. Te avisaremos por correo."
    : esPendiente
      ? "Estamos esperando la confirmación de tu banco. Esto puede tardar unos minutos."
      : "La pasarela de pago no completó la transacción. Puedes intentarlo de nuevo.";

  const referenciaTexto =
    transaccion.referencia_pasarela ?? `TX-${transaccion.id_transaccion}`;

  const destinoVerCertificado = certificado?.codigo_qr_validacion
    ? `/verificar/${certificado.codigo_qr_validacion}`
    : obra
      ? `/obras/${obra.id_obra}`
      : "/mis-compras";

  return (
    <div className="relative min-h-screen py-[var(--espacio-64)]">
      <Ambiente nivel={1} />

      <div className="relative z-10 mx-auto flex w-full max-w-[var(--contenedor-resultado)] flex-col items-center px-[var(--espacio-16)] text-center">
        {/* Icono de 48 px según variante */}
        {esAprobado ? (
          <Check
            size={48}
            strokeWidth={1.5}
            className="text-[color:var(--exito)]"
            aria-hidden="true"
          />
        ) : esPendiente ? (
          <Clock
            size={48}
            strokeWidth={1.5}
            className="text-[color:var(--tinta)]"
            aria-hidden="true"
          />
        ) : (
          <span
            aria-hidden="true"
            className="inline-grid h-[var(--espacio-48)] w-[var(--espacio-48)] place-items-center rounded-[var(--radio-circulo)] border border-[color:var(--aviso)] font-[var(--fuente-poster)] text-[length:var(--text-h2)] leading-none text-[color:var(--aviso)]"
          >
            !
          </span>
        )}

        <h1 className="voz-h1 mt-[var(--espacio-24)] text-[color:var(--tinta)]">
          {titulo}
        </h1>

        <p className="voz-cuerpo mt-[var(--espacio-12)] max-w-[var(--medida-lectura)] text-[color:var(--tinta-suave)]">
          {textoDescripcion}
        </p>

        {/* Sello de certificado con fundido de 800 ms al aprobarse el pago */}
        {esAprobado && (
          <div
            className={clsx(
              "mt-[var(--espacio-32)] transition-opacity duration-[var(--duracion-momento-min)] ease-[var(--curva-base)]",
              selloVisible ? "opacity-100" : "opacity-0"
            )}
          >
            <SelloCertificado
              etiqueta="CERTIFICADO"
              codigo={certificado?.codigo_qr_validacion ?? obra?.uid ?? referenciaTexto}
              valido
            />
          </div>
        )}

        {/* Resumen de la compra: obra, monto, fecha y referencia */}
        <section
          aria-label="Resumen de la compra"
          className="mt-[var(--espacio-32)] w-full border border-[color:var(--borde-reposo)] bg-[color:var(--fondo)] p-[var(--espacio-24)] text-left shadow-[var(--sombra-tarjeta)]"
        >
          {obra && (
            <div className="mb-[var(--espacio-24)] flex items-center gap-[var(--espacio-16)] border-b border-[color:var(--divisor)] pb-[var(--espacio-24)]">
              <div className="flex h-[var(--miniatura-lista)] w-[var(--miniatura-lista)] shrink-0 items-center justify-center border border-[color:var(--divisor)] bg-[color:var(--vacio)] p-[var(--espacio-8)]">
                <img
                  src={urlPreviewObra(obra.id_obra)}
                  alt={obra.titulo}
                  className="h-full w-full object-contain"
                />
              </div>
              <div className="min-w-0 flex-1">
                <h2 className="voz-h3 truncate text-[color:var(--tinta)]">{obra.titulo}</h2>
                <p className="voz-cursiva mt-[var(--espacio-4)] text-[color:var(--tinta-suave)]">
                  Artista N.º {obra.id_artista}
                </p>
              </div>
            </div>
          )}

          <dl className="divide-y divide-[color:var(--divisor)]">
            <div className="flex items-baseline justify-between gap-[var(--espacio-16)] py-[var(--espacio-12)]">
              <dt className="voz-cuerpo-pequeno text-[color:var(--tinta-suave)]">Monto</dt>
              <dd className="precio-obra voz-cuerpo font-semibold text-[color:var(--tinta)]">
                {formatearMoneda(transaccion.monto_total)}
              </dd>
            </div>
            <div className="flex items-baseline justify-between gap-[var(--espacio-16)] py-[var(--espacio-12)]">
              <dt className="voz-cuerpo-pequeno text-[color:var(--tinta-suave)]">Fecha</dt>
              <dd className="voz-cuerpo-pequeno font-semibold text-[color:var(--tinta)]">
                {formatearFecha(transaccion.fecha_pago)}
              </dd>
            </div>
            <div className="flex items-baseline justify-between gap-[var(--espacio-16)] py-[var(--espacio-12)]">
              <dt className="voz-cuerpo-pequeno text-[color:var(--tinta-suave)]">Referencia</dt>
              <dd className="codigo-certificado text-[length:var(--text-cuerpo-pequeno)] text-[color:var(--tinta)]">
                {referenciaTexto}
              </dd>
            </div>
          </dl>
        </section>

        {user?.correo_electronico && (
          <p className="voz-cuerpo-pequeno mt-[var(--espacio-16)] text-[color:var(--tinta-suave)]">
            Enviamos el comprobante a {user.correo_electronico}.
          </p>
        )}

        {/* Acciones según variante */}
        <div className="mt-[var(--espacio-32)] flex flex-wrap items-center justify-center gap-[var(--espacio-16)]">
          {esAprobado && (
            <>
              <Link to={destinoVerCertificado}>
                <Button variante="primario">Ver certificado</Button>
              </Link>
              <Link to="/mis-compras">
                <Button variante="secundario">Ir a mis compras</Button>
              </Link>
            </>
          )}

          {esPendiente && (
            <Link to="/mis-compras">
              <Button variante="primario">Ir a mis compras</Button>
            </Link>
          )}

          {esRechazado && (
            <>
              <Link
                to={
                  obra
                    ? `/obras/${obra.id_obra}?checkout=1&transaccion=${transaccion.id_transaccion}`
                    : "/mis-compras"
                }
              >
                <Button variante="primario">Intentar de nuevo</Button>
              </Link>
              <Link to={obra ? `/obras/${obra.id_obra}` : "/#coleccion"}>
                <Button variante="secundario">Volver a la obra</Button>
              </Link>
            </>
          )}
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/pages/CuentaPage.tsx">
import { useEffect, useState, type FormEvent } from "react";
import { Link, useNavigate } from "react-router-dom";
import { LayoutDashboard } from "lucide-react";
import { useAuth } from "../context/AuthContext";
import { rutaInicialPorRol } from "../lib/navegacion";
import { useToast } from "../context/ToastContext";
import { Ambiente } from "../components/escena/Ambiente";
import { BadgeEstadoValidacion } from "../components/ui/Badge";
import { Banner } from "../components/ui/Banner";
import { Button } from "../components/ui/Button";
import { EmptyState } from "../components/ui/EmptyState";
import { FileUpload } from "../components/ui/FileUpload";
import { FormErrorSummary, type ErrorCampoItem } from "../components/ui/FormErrorSummary";
import { Input } from "../components/ui/Input";
import { Modal } from "../components/ui/Modal";
import { Select } from "../components/ui/Select";
import { Skeleton } from "../components/ui/Skeleton";
import { Tabs, type ItemPestana } from "../components/ui/Tabs";
import { formatearFecha } from "../lib/formato";

type PestanaCuenta = "perfil" | "seguridad" | "notificaciones" | "facturacion";

interface DatosPerfil {
  nombreCompleto: string;
  correo: string;
  telefono: string;
  fotoNombre: string | null;
  fotoTamano?: number;
}

interface DatosNotificaciones {
  comprasYCertificados: boolean;
  estadoDePagos: boolean;
  novedadesCatalogo: boolean;
}

interface DatosFacturacion {
  tipoDocumento: string;
  numeroDocumento: string;
  nombreFiscal: string;
  direccion: string;
  ciudad: string;
  departamento: string;
}

interface SesionActiva {
  id: string;
  dispositivo: string;
  ubicacion: string;
  ultimaActividad: string;
  actual: boolean;
}

const SESIONES_INICIALES: SesionActiva[] = [
  {
    id: "ses-actual",
    dispositivo: "Navegador actual · Windows",
    ubicacion: "Bogotá, Colombia",
    ultimaActividad: "Activa ahora",
    actual: true,
  },
  {
    id: "ses-movil",
    dispositivo: "Safari · iPhone",
    ubicacion: "Medellín, Colombia",
    ultimaActividad: "Hace 2 días",
    actual: false,
  },
];

function nombreInicialDesdeCorreo(correo: string): string {
  const local = correo.split("@")[0] ?? "Usuario";
  return local
    .split(/[._-]+/)
    .filter(Boolean)
    .map((parte) => parte.charAt(0).toUpperCase() + parte.slice(1))
    .join(" ");
}

/**
 * 6.11 Cuenta (Nivel 1 — Funcional):
 * Navegación interna con pestañas: Perfil, Seguridad, Notificaciones y Datos de facturación.
 * Campos en formato caja y guardado explícito ("Guardar cambios" deshabilitado hasta que algo cambia).
 * Al guardar aparece un toast salvia: "Cambios guardados".
 * Al final, zona de peligro con "Eliminar cuenta" y modal destructivo que pide contraseña.
 */
export function CuentaPage() {
  const { user, cargando: loading, logout } = useAuth();
  const { notificar } = useToast();
  const navigate = useNavigate();

  const [pestana, setPestana] = useState<PestanaCuenta>("perfil");

  // Estado base y editable: Perfil
  const [perfilBase, setPerfilBase] = useState<DatosPerfil>({
    nombreCompleto: "",
    correo: "",
    telefono: "+57 300 000 0000",
    fotoNombre: null,
  });
  const [perfilForm, setPerfilForm] = useState<DatosPerfil>(perfilBase);

  // Estado: Seguridad (contraseña y sesiones)
  const [passwordActual, setPasswordActual] = useState("");
  const [passwordNueva, setPasswordNueva] = useState("");
  const [passwordConfirmar, setPasswordConfirmar] = useState("");
  const [erroresPassword, setErroresPassword] = useState<ErrorCampoItem[]>([]);
  const [sesiones, setSesiones] = useState<SesionActiva[]>(SESIONES_INICIALES);

  // Estado base y editable: Notificaciones
  const [notifBase, setNotifBase] = useState<DatosNotificaciones>({
    comprasYCertificados: true,
    estadoDePagos: true,
    novedadesCatalogo: false,
  });
  const [notifForm, setNotifForm] = useState<DatosNotificaciones>(notifBase);

  // Estado base y editable: Facturación
  const [factBase, setFactBase] = useState<DatosFacturacion>({
    tipoDocumento: "CC",
    numeroDocumento: "",
    nombreFiscal: "",
    direccion: "",
    ciudad: "Bogotá",
    departamento: "Cundinamarca",
  });
  const [factForm, setFactForm] = useState<DatosFacturacion>(factBase);

  // Modal destructivo: Eliminar cuenta
  const [modalEliminarAbierto, setModalEliminarAbierto] = useState(false);
  const [passwordEliminar, setPasswordEliminar] = useState("");
  const [errorEliminar, setErrorEliminar] = useState<string | undefined>(undefined);

  useEffect(() => {
    document.title = "Cuenta · Pixel & Lienzo";
  }, []);

  useEffect(() => {
    if (!user) return;
    const nombreSugerido = nombreInicialDesdeCorreo(user.correo_electronico);
    const inicialPerfil: DatosPerfil = {
      nombreCompleto: nombreSugerido,
      correo: user.correo_electronico,
      telefono: "+57 300 000 0000",
      fotoNombre: null,
    };
    setPerfilBase(inicialPerfil);
    setPerfilForm(inicialPerfil);

    setFactBase((prev) => {
      const actualizado = { ...prev, nombreFiscal: prev.nombreFiscal || nombreSugerido };
      setFactForm(actualizado);
      return actualizado;
    });
  }, [user]);

  const itemsPestanas: ItemPestana<PestanaCuenta>[] = [
    { id: "perfil", etiqueta: "Perfil" },
    { id: "seguridad", etiqueta: "Seguridad" },
    { id: "notificaciones", etiqueta: "Notificaciones" },
    { id: "facturacion", etiqueta: "Datos de facturación" },
  ];

  const hayCambiosPerfil =
    perfilForm.nombreCompleto.trim() !== perfilBase.nombreCompleto.trim() ||
    perfilForm.correo.trim() !== perfilBase.correo.trim() ||
    perfilForm.telefono.trim() !== perfilBase.telefono.trim() ||
    perfilForm.fotoNombre !== perfilBase.fotoNombre;

  const hayCambiosPassword =
    passwordActual.length > 0 || passwordNueva.length > 0 || passwordConfirmar.length > 0;

  const hayCambiosNotif =
    notifForm.comprasYCertificados !== notifBase.comprasYCertificados ||
    notifForm.estadoDePagos !== notifBase.estadoDePagos ||
    notifForm.novedadesCatalogo !== notifBase.novedadesCatalogo;

  const hayCambiosFact =
    factForm.tipoDocumento !== factBase.tipoDocumento ||
    factForm.numeroDocumento.trim() !== factBase.numeroDocumento.trim() ||
    factForm.nombreFiscal.trim() !== factBase.nombreFiscal.trim() ||
    factForm.direccion.trim() !== factBase.direccion.trim() ||
    factForm.ciudad.trim() !== factBase.ciudad.trim() ||
    factForm.departamento.trim() !== factBase.departamento.trim();

  const guardarPerfil = (e: FormEvent) => {
    e.preventDefault();
    if (!hayCambiosPerfil) return;
    setPerfilBase(perfilForm);
    notificar("Cambios guardados", "exito");
  };

  const guardarPassword = (e: FormEvent) => {
    e.preventDefault();
    const nuevosErrores: ErrorCampoItem[] = [];

    if (!passwordActual) {
      nuevosErrores.push({
        idCampo: "cuenta-password-actual",
        etiqueta: "Contraseña actual",
        mensaje: "Ingresa tu contraseña actual.",
      });
    }
    if (passwordNueva.length < 8) {
      nuevosErrores.push({
        idCampo: "cuenta-password-nueva",
        etiqueta: "Nueva contraseña",
        mensaje: "La nueva contraseña debe tener al menos 8 caracteres.",
      });
    }
    if (passwordNueva !== passwordConfirmar) {
      nuevosErrores.push({
        idCampo: "cuenta-password-confirmar",
        etiqueta: "Confirmar contraseña",
        mensaje: "Las contraseñas no coinciden.",
      });
    }

    setErroresPassword(nuevosErrores);
    if (nuevosErrores.length > 0) return;

    setPasswordActual("");
    setPasswordNueva("");
    setPasswordConfirmar("");
    notificar("Cambios guardados", "exito");
  };

  const cerrarTodasLasSesiones = () => {
    setSesiones((prev) => prev.filter((s) => s.actual));
    notificar("Cambios guardados", "exito");
  };

  const guardarNotificaciones = (e: FormEvent) => {
    e.preventDefault();
    if (!hayCambiosNotif) return;
    setNotifBase(notifForm);
    notificar("Cambios guardados", "exito");
  };

  const guardarFacturacion = (e: FormEvent) => {
    e.preventDefault();
    if (!hayCambiosFact) return;
    setFactBase(factForm);
    notificar("Cambios guardados", "exito");
  };

  const confirmarEliminarCuenta = async (e: FormEvent) => {
    e.preventDefault();
    if (!passwordEliminar.trim()) {
      setErrorEliminar("Ingresa tu contraseña para confirmar la eliminación.");
      return;
    }
    setErrorEliminar(undefined);
    setModalEliminarAbierto(false);
    await logout();
    notificar("Tu solicitud de eliminación de cuenta fue registrada.", "exito");
    navigate("/");
  };

  if (loading) {
    return (
      <div className="relative min-h-[calc(100vh-var(--alto-cabecera))]">
        <Ambiente nivel={1} />
        <div className="relative z-10 mx-auto max-w-[var(--contenedor-formulario-amplio)] px-[var(--espacio-16)] py-[var(--espacio-48)] sm:px-[var(--espacio-24)]">
          <Skeleton className="h-[var(--espacio-48)] w-48" />
          <Skeleton className="mt-[var(--espacio-24)] h-[var(--alto-control)] w-full" />
          <Skeleton className="mt-[var(--espacio-32)] h-64 w-full" />
        </div>
      </div>
    );
  }

  if (!user) {
    return (
      <div className="relative min-h-[calc(100vh-var(--alto-cabecera))]">
        <Ambiente nivel={1} />
        <div className="relative z-10 mx-auto max-w-[var(--contenedor-max)] px-[var(--espacio-16)] py-[var(--espacio-64)] sm:px-[var(--espacio-24)]">
          <EmptyState
            titulo="Inicia sesión para gestionar tu cuenta."
            descripcion="Desde aquí puedes actualizar tus datos personales, seguridad, notificaciones y facturación."
            accion={
              <Link to="/login">
                <Button variante="primario">Ingresar</Button>
              </Link>
            }
          />
        </div>
      </div>
    );
  }

  return (
    <div className="relative min-h-[calc(100vh-var(--alto-cabecera))]">
      <Ambiente nivel={1} />

      <div className="relative z-10 mx-auto max-w-[var(--contenedor-formulario-amplio)] px-[var(--espacio-16)] py-[var(--espacio-48)] sm:px-[var(--espacio-24)]">
        {/* Cabecera */}
        <header className="mb-[var(--espacio-32)]">
          <div className="flex flex-wrap items-center justify-between gap-[var(--espacio-16)]">
            <div>
              <h1 className="voz-h1 text-[color:var(--tinta)]">Cuenta</h1>
              <div className="regla-titulo mt-[var(--espacio-12)]" aria-hidden="true" />
            </div>
            <div className="flex flex-wrap items-center gap-[var(--espacio-12)]">
              {(user.rol === "Artista" ||
                user.rol === "Curador" ||
                user.rol === "Administrador") && (
                <Link to={rutaInicialPorRol(user.rol)} className="no-underline">
                  <Button variante="primario" tamano="compacto">
                    <LayoutDashboard size={16} strokeWidth={1.6} aria-hidden="true" />
                    <span>
                      {user.rol === "Artista"
                        ? "Volver al Panel del artista"
                        : user.rol === "Curador"
                          ? "Volver al Panel de curaduría"
                          : "Volver al Panel institucional"}
                    </span>
                  </Button>
                </Link>
              )}
              <span className="inline-flex h-[var(--alto-estado)] items-center rounded-[var(--radio-recto)] border border-[color:var(--riel)] px-[var(--espacio-8)] font-[var(--fuente-poster)] text-[length:var(--text-etiqueta)] uppercase tracking-[0.12em] text-[color:var(--tinta)]">
                {user.rol}
              </span>
              <span className="voz-cuerpo-pequeno text-[color:var(--tinta-suave)]">
                Registro: {formatearFecha(user.fecha_registro)}
              </span>
            </div>
          </div>
        </header>

        {/* Pestañas */}
        <Tabs<PestanaCuenta>
          items={itemsPestanas}
          activa={pestana}
          onChange={(nuevaPestana) => setPestana(nuevaPestana)}
          ariaLabel="Secciones de cuenta"
          className="mb-[var(--espacio-32)]"
        />

        {/* Pestaña 1: Perfil */}
        {pestana === "perfil" && (
          <form
            onSubmit={guardarPerfil}
            noValidate
            className="flex flex-col gap-[var(--espacio-24)] border border-[color:var(--borde-reposo)] bg-[color:var(--superficie-elevada)] p-[var(--espacio-24)] sm:p-[var(--espacio-32)]"
          >
            <h2 className="voz-h3 text-[color:var(--tinta)]">Datos personales</h2>

            <Input
              id="cuenta-nombre"
              variante="caja"
              label="Nombre completo"
              value={perfilForm.nombreCompleto}
              onChange={(e) =>
                setPerfilForm((prev) => ({ ...prev, nombreCompleto: e.target.value }))
              }
              autoComplete="name"
            />

            <Input
              id="cuenta-correo"
              variante="caja"
              type="email"
              label="Correo electrónico"
              value={perfilForm.correo}
              onChange={(e) => setPerfilForm((prev) => ({ ...prev, correo: e.target.value }))}
              ayuda="Enviaremos comprobantes y avisos de seguridad a esta dirección."
              autoComplete="email"
            />

            <Input
              id="cuenta-telefono"
              variante="caja"
              type="tel"
              label="Teléfono"
              value={perfilForm.telefono}
              onChange={(e) => setPerfilForm((prev) => ({ ...prev, telefono: e.target.value }))}
              autoComplete="tel"
            />

            <FileUpload
              label="Fotografía de perfil"
              ayuda="JPG, PNG o WebP, máximo 5 MB."
              accept="image/jpeg,image/png,image/webp"
              archivoActual={
                perfilForm.fotoNombre
                  ? { nombre: perfilForm.fotoNombre, tamanoBytes: perfilForm.fotoTamano }
                  : null
              }
              onSelectFile={(file) =>
                setPerfilForm((prev) => ({
                  ...prev,
                  fotoNombre: file.name,
                  fotoTamano: file.size,
                }))
              }
            />

            <div className="flex justify-end border-t border-[color:var(--divisor)] pt-[var(--espacio-24)]">
              <Button type="submit" variante="primario" disabled={!hayCambiosPerfil}>
                Guardar cambios
              </Button>
            </div>
          </form>
        )}

        {/* Pestaña 2: Seguridad */}
        {pestana === "seguridad" && (
          <div className="flex flex-col gap-[var(--espacio-32)]">
            <form
              onSubmit={guardarPassword}
              noValidate
              className="flex flex-col gap-[var(--espacio-24)] border border-[color:var(--borde-reposo)] bg-[color:var(--superficie-elevada)] p-[var(--espacio-24)] sm:p-[var(--espacio-32)]"
            >
              <div className="flex flex-wrap items-center justify-between gap-[var(--espacio-12)]">
                <h2 className="voz-h3 text-[color:var(--tinta)]">Cambiar contraseña</h2>
                <BadgeEstadoValidacion estado={user.mfa_activado ? "Verificado" : "Pendiente"} />
              </div>

              {erroresPassword.length > 0 && <FormErrorSummary errores={erroresPassword} />}

              <Input
                id="cuenta-password-actual"
                variante="caja"
                type="password"
                label="Contraseña actual"
                value={passwordActual}
                onChange={(e) => setPasswordActual(e.target.value)}
                autoComplete="current-password"
                error={erroresPassword.find((e) => e.idCampo === "cuenta-password-actual")?.mensaje}
              />

              <Input
                id="cuenta-password-nueva"
                variante="caja"
                type="password"
                label="Nueva contraseña"
                value={passwordNueva}
                onChange={(e) => setPasswordNueva(e.target.value)}
                ayuda="Mínimo 8 caracteres."
                autoComplete="new-password"
                error={erroresPassword.find((e) => e.idCampo === "cuenta-password-nueva")?.mensaje}
              />

              <Input
                id="cuenta-password-confirmar"
                variante="caja"
                type="password"
                label="Confirmar nueva contraseña"
                value={passwordConfirmar}
                onChange={(e) => setPasswordConfirmar(e.target.value)}
                autoComplete="new-password"
                error={
                  erroresPassword.find((e) => e.idCampo === "cuenta-password-confirmar")?.mensaje
                }
              />

              <div className="flex justify-end border-t border-[color:var(--divisor)] pt-[var(--espacio-24)]">
                <Button type="submit" variante="primario" disabled={!hayCambiosPassword}>
                  Guardar cambios
                </Button>
              </div>
            </form>

            {/* Sesiones activas */}
            <section className="flex flex-col gap-[var(--espacio-24)] border border-[color:var(--borde-reposo)] bg-[color:var(--superficie-elevada)] p-[var(--espacio-24)] sm:p-[var(--espacio-32)]">
              <div className="flex flex-wrap items-center justify-between gap-[var(--espacio-16)]">
                <div>
                  <h2 className="voz-h3 text-[color:var(--tinta)]">Sesiones activas</h2>
                  <p className="voz-cuerpo-pequeno mt-[var(--espacio-4)] text-[color:var(--tinta-suave)]">
                    Dispositivos con acceso activo a tu cuenta.
                  </p>
                </div>
                {sesiones.length > 1 && (
                  <Button variante="secundario" tamano="compacto" onClick={cerrarTodasLasSesiones}>
                    Cerrar todas las sesiones
                  </Button>
                )}
              </div>

              <ul className="flex flex-col divide-y divide-[color:var(--divisor)] list-none p-0 m-0">
                {sesiones.map((sesion) => (
                  <li
                    key={sesion.id}
                    className="flex flex-wrap items-center justify-between gap-[var(--espacio-16)] py-[var(--espacio-16)] first:pt-0 last:pb-0"
                  >
                    <div className="flex flex-col gap-[var(--espacio-4)]">
                      <span className="voz-cuerpo text-[color:var(--tinta)]">
                        {sesion.dispositivo}
                      </span>
                      <span className="voz-cuerpo-pequeno text-[color:var(--tinta-suave)]">
                        {sesion.ubicacion} · {sesion.ultimaActividad}
                      </span>
                    </div>
                    {sesion.actual ? (
                      <span className="inline-flex h-[var(--alto-estado)] items-center rounded-[var(--radio-recto)] border border-[color:var(--exito)] px-[var(--espacio-8)] font-[var(--fuente-poster)] text-[length:var(--text-etiqueta)] uppercase tracking-[0.12em] text-[color:var(--exito)]">
                        Sesión actual
                      </span>
                    ) : (
                      <Button
                        variante="terciario"
                        onClick={() => {
                          setSesiones((prev) => prev.filter((item) => item.id !== sesion.id));
                          notificar("Cambios guardados", "exito");
                        }}
                      >
                        Cerrar sesión
                      </Button>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          </div>
        )}

        {/* Pestaña 3: Notificaciones */}
        {pestana === "notificaciones" && (
          <form
            onSubmit={guardarNotificaciones}
            className="flex flex-col gap-[var(--espacio-24)] border border-[color:var(--borde-reposo)] bg-[color:var(--superficie-elevada)] p-[var(--espacio-24)] sm:p-[var(--espacio-32)]"
          >
            <h2 className="voz-h3 text-[color:var(--tinta)]">Preferencias de notificación</h2>

            <div className="flex flex-col divide-y divide-[color:var(--divisor)]">
              <label className="flex items-start justify-between gap-[var(--espacio-16)] py-[var(--espacio-16)] first:pt-0 cursor-pointer">
                <span className="flex flex-col gap-[var(--espacio-4)]">
                  <span className="voz-cuerpo text-[color:var(--tinta)]">
                    Compras y certificados de autenticidad
                  </span>
                  <span className="voz-cuerpo-pequeno text-[color:var(--tinta-suave)]">
                    Avisos cuando se emite un certificado verificable o cambia la titularidad de una obra.
                  </span>
                </span>
                <input
                  type="checkbox"
                  checked={notifForm.comprasYCertificados}
                  onChange={(e) =>
                    setNotifForm((prev) => ({
                      ...prev,
                      comprasYCertificados: e.target.checked,
                    }))
                  }
                  className="mt-[var(--espacio-4)] h-[var(--espacio-20)] w-[var(--espacio-20)] shrink-0 accent-[color:var(--carmesi)]"
                />
              </label>

              <label className="flex items-start justify-between gap-[var(--espacio-16)] py-[var(--espacio-16)] cursor-pointer">
                <span className="flex flex-col gap-[var(--espacio-4)]">
                  <span className="voz-cuerpo text-[color:var(--tinta)]">
                    Confirmaciones de pago y facturación
                  </span>
                  <span className="voz-cuerpo-pequeno text-[color:var(--tinta-suave)]">
                    Comprobantes y actualizaciones bancarias sobre transacciones en curso.
                  </span>
                </span>
                <input
                  type="checkbox"
                  checked={notifForm.estadoDePagos}
                  onChange={(e) =>
                    setNotifForm((prev) => ({ ...prev, estadoDePagos: e.target.checked }))
                  }
                  className="mt-[var(--espacio-4)] h-[var(--espacio-20)] w-[var(--espacio-20)] shrink-0 accent-[color:var(--carmesi)]"
                />
              </label>

              <label className="flex items-start justify-between gap-[var(--espacio-16)] py-[var(--espacio-16)] last:pb-0 cursor-pointer">
                <span className="flex flex-col gap-[var(--espacio-4)]">
                  <span className="voz-cuerpo text-[color:var(--tinta)]">
                    Nuevas obras y exposiciones del catálogo
                  </span>
                  <span className="voz-cuerpo-pequeno text-[color:var(--tinta-suave)]">
                    Selección mensual de piezas publicadas por curaduría.
                  </span>
                </span>
                <input
                  type="checkbox"
                  checked={notifForm.novedadesCatalogo}
                  onChange={(e) =>
                    setNotifForm((prev) => ({ ...prev, novedadesCatalogo: e.target.checked }))
                  }
                  className="mt-[var(--espacio-4)] h-[var(--espacio-20)] w-[var(--espacio-20)] shrink-0 accent-[color:var(--carmesi)]"
                />
              </label>
            </div>

            <div className="flex justify-end border-t border-[color:var(--divisor)] pt-[var(--espacio-24)]">
              <Button type="submit" variante="primario" disabled={!hayCambiosNotif}>
                Guardar cambios
              </Button>
            </div>
          </form>
        )}

        {/* Pestaña 4: Datos de facturación */}
        {pestana === "facturacion" && (
          <form
            onSubmit={guardarFacturacion}
            noValidate
            className="flex flex-col gap-[var(--espacio-24)] border border-[color:var(--borde-reposo)] bg-[color:var(--superficie-elevada)] p-[var(--espacio-24)] sm:p-[var(--espacio-32)]"
          >
            <h2 className="voz-h3 text-[color:var(--tinta)]">Datos de facturación</h2>

            <div className="grid grid-cols-1 gap-[var(--espacio-16)] sm:grid-cols-2">
              <Select
                id="cuenta-tipo-doc"
                variante="caja"
                label="Tipo de documento"
                value={factForm.tipoDocumento}
                onChange={(e) =>
                  setFactForm((prev) => ({ ...prev, tipoDocumento: e.target.value }))
                }
              >
                <option value="CC">Cédula de ciudadanía (CC)</option>
                <option value="CE">Cédula de extranjería (CE)</option>
                <option value="NIT">NIT</option>
                <option value="PAS">Pasaporte</option>
              </Select>

              <Input
                id="cuenta-num-doc"
                variante="caja"
                label="Número de documento"
                value={factForm.numeroDocumento}
                onChange={(e) =>
                  setFactForm((prev) => ({ ...prev, numeroDocumento: e.target.value }))
                }
              />
            </div>

            <Input
              id="cuenta-nombre-fiscal"
              variante="caja"
              label="Nombre completo o razón social"
              value={factForm.nombreFiscal}
              onChange={(e) =>
                setFactForm((prev) => ({ ...prev, nombreFiscal: e.target.value }))
              }
            />

            <Input
              id="cuenta-direccion"
              variante="caja"
              label="Dirección fiscal"
              value={factForm.direccion}
              onChange={(e) => setFactForm((prev) => ({ ...prev, direccion: e.target.value }))}
            />

            <div className="grid grid-cols-1 gap-[var(--espacio-16)] sm:grid-cols-2">
              <Input
                id="cuenta-ciudad"
                variante="caja"
                label="Ciudad"
                value={factForm.ciudad}
                onChange={(e) => setFactForm((prev) => ({ ...prev, ciudad: e.target.value }))}
              />

              <Input
                id="cuenta-departamento"
                variante="caja"
                label="Departamento"
                value={factForm.departamento}
                onChange={(e) =>
                  setFactForm((prev) => ({ ...prev, departamento: e.target.value }))
                }
              />
            </div>

            <div className="flex justify-end border-t border-[color:var(--divisor)] pt-[var(--espacio-24)]">
              <Button type="submit" variante="primario" disabled={!hayCambiosFact}>
                Guardar cambios
              </Button>
            </div>
          </form>
        )}

        {/* Zona de peligro: Eliminar cuenta */}
        <section
          aria-labelledby="titulo-zona-peligro"
          className="mt-[var(--espacio-48)] flex flex-col gap-[var(--espacio-16)] border border-[color:var(--peligro)] bg-[color:var(--superficie-elevada)] p-[var(--espacio-24)] sm:flex-row sm:items-center sm:justify-between sm:p-[var(--espacio-32)]"
        >
          <div className="flex flex-col gap-[var(--espacio-4)]">
            <h2 id="titulo-zona-peligro" className="voz-h3 text-[color:var(--tinta)]">
              Eliminar cuenta
            </h2>
            <p className="voz-cuerpo-pequeno text-[color:var(--tinta-suave)]">
              Desactiva de forma permanente tu acceso. Las compras y los certificados ya emitidos se conservan.
            </p>
          </div>
          <Button
            variante="destructivo"
            onClick={() => {
              setPasswordEliminar("");
              setErrorEliminar(undefined);
              setModalEliminarAbierto(true);
            }}
          >
            Eliminar cuenta
          </Button>
        </section>
      </div>

      {/* Modal destructivo: Eliminar cuenta */}
      <Modal
        abierto={modalEliminarAbierto}
        onCerrar={() => setModalEliminarAbierto(false)}
        titulo="Eliminar cuenta"
        descripcion="Esta acción cerrará tu cuenta de forma permanente. Las compras y los certificados de autenticidad ya emitidos se conservan para garantizar su verificación pública."
        destructivo
      >
        <form onSubmit={(e) => void confirmarEliminarCuenta(e)} className="flex flex-col gap-[var(--espacio-24)]">
          <Banner variante="aviso">
            Para confirmar que eres el titular de la cuenta, escribe tu contraseña actual.
          </Banner>

          <Input
            id="confirmar-password-eliminar"
            variante="caja"
            type="password"
            label="Contraseña actual"
            value={passwordEliminar}
            onChange={(e) => {
              setPasswordEliminar(e.target.value);
              if (errorEliminar) setErrorEliminar(undefined);
            }}
            error={errorEliminar}
            autoComplete="current-password"
          />

          <div className="flex justify-end gap-[var(--espacio-12)]">
            <Button
              type="button"
              variante="secundario"
              onClick={() => setModalEliminarAbierto(false)}
            >
              Cancelar
            </Button>
            <Button
              type="submit"
              variante="destructivo"
              disabled={!passwordEliminar.trim()}
            >
              Eliminar cuenta
            </Button>
          </div>
        </form>
      </Modal>
    </div>
  );
}
</file>

<file path="src/pages/EstudioMotionPage.tsx">
import { useEffect, useMemo, useRef, useState } from "react";
import { Link } from "react-router-dom";
import { useQuery } from "@tanstack/react-query";
import { Maximize2, Pause, Play, Volume2, VolumeX } from "lucide-react";
import clsx from "clsx";
import { listarCatalogo, urlPreviewObra } from "../api/obras";
import { Ambiente } from "../components/escena/Ambiente";
import { Button } from "../components/ui/Button";
import { EmptyState } from "../components/ui/EmptyState";
import { Skeleton } from "../components/ui/Skeleton";

interface PiezaMotion {
  id: string;
  idObra?: number;
  titulo: string;
  artista: string;
  anio: string;
  duracionTexto: string;
  duracionSegundos: number;
  descripcion: string;
  posterUrl?: string;
}

const PIEZAS_BASE: PiezaMotion[] = [
  {
    id: "noche-sobre-el-rio",
    titulo: "Noche sobre el río",
    artista: "Estudio Palacio",
    anio: "2024",
    duracionTexto: "01:24",
    duracionSegundos: 84,
    descripcion:
      "Una superficie oscura recorrida por un pulso cálido. La pieza fue concebida para proyectarse en sala en absoluto silencio.",
  },
  {
    id: "geometria-de-sal",
    titulo: "Geometría de sal",
    artista: "Estudio Palacio",
    anio: "2023",
    duracionTexto: "02:05",
    duracionSegundos: 125,
    descripcion:
      "Planos superpuestos que modulan su contraste de forma gradual, dejando respirar el grano del soporte original.",
  },
  {
    id: "umbral",
    titulo: "Umbral",
    artista: "Estudio Palacio",
    anio: "2025",
    duracionTexto: "01:48",
    duracionSegundos: 108,
    descripcion:
      "Un claro circular en el centro del lienzo cuya penumbra se desplaza lentamente a lo largo de la proyección.",
  },
];

function formatearSegundos(seg: number): string {
  const m = Math.floor(seg / 60);
  const s = Math.floor(seg % 60);
  return `${m < 10 ? `0${m}` : m}:${s < 10 ? `0${s}` : s}`;
}

/**
 * 6.6 Estudio Motion (Nivel 2):
 * H1 "Estudio Motion" con la cursiva "Obras en movimiento".
 * Escenario principal 16:9 sobre --vacio con borde --riel al 40 % y controles propios
 * (reproducir/pausar, barra de tiempo de 2 px en --riel, volumen y pantalla completa).
 * Información de la pieza + botón "Ver obra".
 * Tira horizontal de miniaturas 16:9 con la duración en Anton.
 * Inicia siempre en pausa con un póster; sin autoplay y sin sonido al entrar.
 */
export function EstudioMotionPage() {
  const escenarioRef = useRef<HTMLDivElement>(null);
  const pistaRef = useRef<HTMLDivElement>(null);

  const [indiceActivo, setIndiceActivo] = useState(0);
  const [reproduciendo, setReproduciendo] = useState(false);
  const [silenciado, setSilenciado] = useState(true);
  const [tiempoActual, setTiempoActual] = useState(0);
  const [errorVideo, setErrorVideo] = useState(false);
  const [arrastrandoPista, setArrastrandoPista] = useState(false);
  const dragInicioXRef = useRef(0);
  const dragScrollInicialRef = useRef(0);

  const { data: obrasCatalogo, isLoading } = useQuery({
    queryKey: ["catalogo", "estudio-motion"],
    queryFn: () => listarCatalogo(),
  });

  useEffect(() => {
    document.title = "Estudio Motion · Pixel & Lienzo";
  }, []);

  const piezas: PiezaMotion[] = useMemo(() => {
    if (!obrasCatalogo || obrasCatalogo.length === 0) {
      return PIEZAS_BASE;
    }
    return obrasCatalogo.slice(0, 6).map((obra, idx) => {
      const base = PIEZAS_BASE[idx % PIEZAS_BASE.length];
      return {
        id: `obra-${obra.id_obra}`,
        idObra: obra.id_obra,
        titulo: obra.titulo,
        artista: `Artista N.º ${obra.id_artista}`,
        anio: obra.anio_creacion ? String(obra.anio_creacion) : base.anio,
        duracionTexto: base.duracionTexto,
        duracionSegundos: base.duracionSegundos,
        descripcion: `${obra.tecnica} · ${obra.dimensiones}. ${base.descripcion}`,
        posterUrl: urlPreviewObra(obra.id_obra),
      };
    });
  }, [obrasCatalogo]);

  const piezaActiva = piezas[Math.min(indiceActivo, piezas.length - 1)] ?? PIEZAS_BASE[0];

  // Al cambiar de pieza: reinicia siempre en pausa con póster y sin sonido
  const seleccionarPieza = (nuevoIndice: number) => {
    setIndiceActivo(nuevoIndice);
    setReproduciendo(false);
    setTiempoActual(0);
    setErrorVideo(false);
  };

  // Avance del tiempo cuando el usuario pulsa Reproducir manualmente
  useEffect(() => {
    if (!reproduciendo || errorVideo) return;
    const timer = window.setInterval(() => {
      setTiempoActual((prev) => {
        if (prev + 0.25 >= piezaActiva.duracionSegundos) {
          setReproduciendo(false);
          return 0;
        }
        return prev + 0.25;
      });
    }, 250);
    return () => window.clearInterval(timer);
  }, [reproduciendo, errorVideo, piezaActiva.duracionSegundos]);

  const progresoPorcentaje = Math.min(
    100,
    Math.max(0, (tiempoActual / Math.max(1, piezaActiva.duracionSegundos)) * 100)
  );

  const alternarPantallaCompleta = () => {
    const el = escenarioRef.current;
    if (!el) return;
    if (document.fullscreenElement) {
      void document.exitFullscreen();
    } else {
      void el.requestFullscreen?.();
    }
  };

  const destinoVerObra = piezaActiva.idObra ? `/obras/${piezaActiva.idObra}` : "/#coleccion";

  return (
    <div className="relative min-h-screen py-[var(--espacio-48)]">
      <Ambiente nivel={2} />

      <div className="contenedor-pyl relative z-10 flex flex-col gap-[var(--espacio-32)]">
        {/* Cabecera: H1 "Estudio Motion" con la cursiva "Obras en movimiento" */}
        <header>
          <h1 className="voz-h1 text-[color:var(--tinta)]">Estudio Motion</h1>
          <p className="voz-acento mt-[var(--espacio-8)] text-[color:var(--tinta-suave)]">
            Obras en movimiento
          </p>
        </header>

        {/* Escenario principal: reproductor 16:9 sobre --vacio con borde --riel al 40 % */}
        {isLoading ? (
          <Skeleton className="aspect-video w-full" />
        ) : errorVideo ? (
          <div className="flex aspect-video w-full items-center justify-center border border-[color:var(--borde-reposo)] bg-[color:var(--vacio)] p-[var(--espacio-24)]">
            <EmptyState
              titulo="No pudimos reproducir este video. Inténtalo de nuevo."
              icono={
                <span className="inline-grid h-[var(--espacio-32)] w-[var(--espacio-32)] place-items-center rounded-[var(--radio-circulo)] border border-[color:var(--aviso)] font-[var(--fuente-poster)] text-[length:var(--text-h3)] leading-none text-[color:var(--aviso)]">
                  !
                </span>
              }
              accion={
                <Button
                  variante="secundario"
                  onClick={() => {
                    setErrorVideo(false);
                    setTiempoActual(0);
                    setReproduciendo(false);
                  }}
                >
                  Reintentar
                </Button>
              }
            />
          </div>
        ) : (
          <div
            ref={escenarioRef}
            className="relative flex aspect-video w-full flex-col justify-between overflow-hidden border border-[color:var(--borde-reposo)] bg-[color:var(--vacio)]"
          >
            {/* Lienzo / Póster de la pieza sobre --vacio (sin recorte, sin texto encima) */}
            <div className="relative flex flex-1 min-h-0 items-center justify-center p-[var(--espacio-24)]">
              <div
                aria-hidden="true"
                className="pointer-events-none absolute inset-0 transition-opacity duration-[var(--duracion-momento-min)] ease-[var(--curva-base)]"
                style={{
                  opacity: reproduciendo ? 0.9 : 0.45,
                  background:
                    "radial-gradient(ellipse 60% 55% at 50% 55%, var(--luz-escenario-obra), transparent 72%)",
                }}
              />

              {piezaActiva.posterUrl ? (
                <img
                  src={piezaActiva.posterUrl}
                  alt={piezaActiva.titulo}
                  decoding="async"
                  className="relative z-10 h-full w-full object-contain"
                />
              ) : (
                <div
                  aria-label={piezaActiva.titulo}
                  className="relative z-10 h-4/5 w-4/5 border border-[color:var(--borde-reposo)]"
                  style={{
                    background:
                      "radial-gradient(circle at 50% 50%, var(--vacio) 0 28%, transparent 29%), linear-gradient(180deg, var(--profundidad), var(--carmesi))",
                  }}
                />
              )}
            </div>

            {/* Controles propios y sobrios: reproducir/pausar, barra de tiempo de 2 px en --riel, volumen y pantalla completa */}
            <div className="relative z-20 flex flex-col gap-[var(--espacio-12)] border-t border-[color:var(--divisor)] bg-[color:var(--fondo)]/90 px-[var(--espacio-24)] py-[var(--espacio-12)]">
              {/* Barra de tiempo de 2 px en --riel */}
              <div
                role="slider"
                tabIndex={0}
                aria-label="Posición de reproducción"
                aria-valuemin={0}
                aria-valuemax={piezaActiva.duracionSegundos}
                aria-valuenow={Math.round(tiempoActual)}
                onClick={(e) => {
                  const rect = e.currentTarget.getBoundingClientRect();
                  const ratio = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
                  setTiempoActual(ratio * piezaActiva.duracionSegundos);
                }}
                onKeyDown={(e) => {
                  if (e.key === "ArrowRight") {
                    e.preventDefault();
                    setTiempoActual((t) => Math.min(piezaActiva.duracionSegundos, t + 5));
                  } else if (e.key === "ArrowLeft") {
                    e.preventDefault();
                    setTiempoActual((t) => Math.max(0, t - 5));
                  }
                }}
                className="flex h-[var(--espacio-16)] w-full cursor-pointer items-center"
              >
                <div className="h-[2px] w-full bg-[color:var(--divisor)]">
                  <div
                    className="h-full bg-[color:var(--riel)] transition-[width] duration-[var(--duracion-micro)]"
                    style={{ width: `${progresoPorcentaje}%` }}
                  />
                </div>
              </div>

              <div className="flex flex-wrap items-center justify-between gap-[var(--espacio-16)]">
                <div className="flex items-center gap-[var(--espacio-16)]">
                  <button
                    type="button"
                    onClick={() => setReproduciendo((r) => !r)}
                    aria-label={reproduciendo ? "Pausar" : "Reproducir"}
                    className="inline-flex min-h-[var(--alto-control-compacto)] items-center gap-[var(--espacio-8)] rounded-[var(--radio-pildora)] border border-[color:var(--riel)] bg-transparent px-[var(--espacio-16)] py-[var(--espacio-4)] font-[var(--fuente-texto)] text-[length:var(--text-cuerpo-pequeno)] font-semibold text-[color:var(--tinta)] hover:border-white cursor-pointer"
                  >
                    {reproduciendo ? (
                      <>
                        <Pause size={16} strokeWidth={1.5} aria-hidden="true" />
                        <span>Pausar</span>
                      </>
                    ) : (
                      <>
                        <Play size={16} strokeWidth={1.5} aria-hidden="true" />
                        <span>Reproducir</span>
                      </>
                    )}
                  </button>

                  <span className="codigo-certificado text-[length:var(--text-cuerpo-pequeno)] text-[color:var(--tinta-suave)]">
                    {formatearSegundos(tiempoActual)} / {piezaActiva.duracionTexto}
                  </span>
                </div>

                <div className="flex items-center gap-[var(--espacio-12)]">
                  <button
                    type="button"
                    onClick={() => setSilenciado((s) => !s)}
                    aria-label={silenciado ? "Activar sonido" : "Silenciar"}
                    aria-pressed={!silenciado}
                    className="inline-grid h-[var(--alto-control-compacto)] w-[var(--alto-control-compacto)] place-items-center rounded-[var(--radio-pildora)] border border-[color:var(--borde-reposo)] bg-transparent text-[color:var(--tinta)] hover:border-white cursor-pointer"
                  >
                    {silenciado ? (
                      <VolumeX size={18} strokeWidth={1.5} aria-hidden="true" />
                    ) : (
                      <Volume2 size={18} strokeWidth={1.5} aria-hidden="true" />
                    )}
                  </button>

                  <button
                    type="button"
                    onClick={alternarPantallaCompleta}
                    aria-label="Pantalla completa"
                    className="inline-grid h-[var(--alto-control-compacto)] w-[var(--alto-control-compacto)] place-items-center rounded-[var(--radio-pildora)] border border-[color:var(--borde-reposo)] bg-transparent text-[color:var(--tinta)] hover:border-white cursor-pointer"
                  >
                    <Maximize2 size={18} strokeWidth={1.5} aria-hidden="true" />
                  </button>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* Información de la pieza: título, artista, año, duración, descripción y botón "Ver obra" */}
        <section
          aria-label="Información de la pieza en proyección"
          className="flex flex-col justify-between gap-[var(--espacio-24)] border-b border-[color:var(--divisor)] pb-[var(--espacio-32)] min-[768px]:flex-row min-[768px]:items-start"
        >
          <div className="max-w-[var(--medida-lectura)]">
            <h2 className="voz-h2 text-[color:var(--tinta)]">{piezaActiva.titulo}</h2>
            <p className="voz-cursiva mt-[var(--espacio-4)] text-[color:var(--tinta-suave)]">
              {piezaActiva.artista} · {piezaActiva.anio} ·{" "}
              <span className="font-[var(--fuente-poster)] not-italic tracking-[0.12em] text-[color:var(--tinta)]">
                {piezaActiva.duracionTexto}
              </span>
            </p>
            <p className="voz-cuerpo mt-[var(--espacio-16)] text-[color:var(--tinta-suave)]">
              {piezaActiva.descripcion}
            </p>
          </div>

          <div className="shrink-0">
            <Link to={destinoVerObra}>
              <Button variante="primario">Ver obra</Button>
            </Link>
          </div>
        </section>

        {/* Otras piezas: tira horizontal de miniaturas 16:9 con la duración en Anton */}
        <section aria-labelledby="heading-otras-piezas-motion">
          <h3
            id="heading-otras-piezas-motion"
            className="voz-etiqueta mb-[var(--espacio-16)] text-[color:var(--tinta-suave)]"
          >
            Otras piezas
          </h3>

          <div
            ref={pistaRef}
            tabIndex={0}
            aria-label="Otras piezas en movimiento: desliza horizontalmente"
            onWheel={(e) => {
              const pista = pistaRef.current;
              if (!pista) return;
              if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
                e.preventDefault();
                pista.scrollLeft += e.deltaY;
              }
            }}
            onMouseDown={(e) => {
              if (e.button !== 0 || !pistaRef.current) return;
              setArrastrandoPista(true);
              dragInicioXRef.current = e.clientX;
              dragScrollInicialRef.current = pistaRef.current.scrollLeft;
            }}
            onMouseMove={(e) => {
              if (!arrastrandoPista || !pistaRef.current) return;
              const dx = e.clientX - dragInicioXRef.current;
              pistaRef.current.scrollLeft = dragScrollInicialRef.current - dx;
            }}
            onMouseUp={() => setArrastrandoPista(false)}
