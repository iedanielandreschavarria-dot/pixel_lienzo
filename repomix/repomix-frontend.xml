                    className="block px-[var(--espacio-16)] py-[var(--espacio-8)] font-[var(--fuente-texto)] font-medium text-[length:var(--text-cuerpo-pequeno)] text-[color:var(--tinta)] no-underline hover:bg-[color:var(--fila-hover)]"
