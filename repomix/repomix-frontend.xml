import { useMemo, useState } from "react";
import { Link } from "react-router-dom";
import { useQuery } from "@tanstack/react-query";
import { listarMisTransacciones, obtenerCheckoutWompi } from "../api/transacciones";
import { obtenerObra, urlPreviewObra } from "../api/obras";
import { obtenerPerfilArtista } from "../api/artistas";
import { obtenerCertificado } from "../api/certificados";
import { obtenerMensajeError } from "../api/client";
import { Ambiente } from "../components/escena/Ambiente";
import { BadgeEstadoPago } from "../components/ui/Badge";
import { Button } from "../components/ui/Button";
import { CompraCard } from "../components/ui/CompraCard";
import { EmptyState } from "../components/ui/EmptyState";
import { Modal } from "../components/ui/Modal";
import { Pagination } from "../components/ui/Pagination";
import { SectionError } from "../components/ui/SectionError";
import { SelloCertificado } from "../components/ui/SelloCertificado";
import { Skeleton } from "../components/ui/Skeleton";
import { Tabs, type ItemPestana } from "../components/ui/Tabs";
import { useToast } from "../context/ToastContext";
import { formatearFecha, formatearMoneda } from "../lib/formato";
import type { Certificado, Obra, Transaccion } from "../types";

type PestanaCompras = "todas" | "aprobadas" | "pendientes";

const COMPRAS_POR_PAGINA = 10;

export interface DetalleCompraSeleccionada {
  transaccion: Transaccion;
  obra?: Obra;
  nombreArtista: string;
  certificado?: Certificado | null;
}

function obtenerMetodoPagoEnmascarado(referencia: string | null): string {
  if (!referencia) return "Pasarela Wompi";
  const soloDigitos = referencia.replace(/\D/g, "");
  if (soloDigitos.length >= 4) {
    return `Terminada en •••• ${soloDigitos.slice(-4)}`;
  }
  return "Pasarela Wompi";
}

function ItemCompra({
  transaccion,
  onAbrirDetalle,
}: {
  transaccion: Transaccion;
  onAbrirDetalle: (detalle: DetalleCompraSeleccionada) => void;
}) {
  const { notificar } = useToast();
  const [continuando, setContinuando] = useState(false);

  const aprobada =
    transaccion.estado_pago === "Confirmado" || transaccion.estado_pago === "Dispersado";

  const { data: obra } = useQuery({
    queryKey: ["obra", transaccion.id_obra],
    queryFn: () => obtenerObra(transaccion.id_obra),
  });

  const { data: perfilArtista } = useQuery({
    queryKey: ["artista", obra?.id_artista],
    queryFn: () => obtenerPerfilArtista(obra!.id_artista),
    enabled: Boolean(obra?.id_artista),
  });

  const { data: certificado } = useQuery({
    queryKey: ["certificado-obra", transaccion.id_obra],
    queryFn: () => obtenerCertificado(transaccion.id_obra),
    enabled: aprobada,
    retry: false,
  });

  const nombreArtista = useMemo(() => {
    if (perfilArtista) {
      return `Artista N.º ${perfilArtista.id_artista}`;
    }
    if (obra?.id_artista) {
      return `Artista N.º ${obra.id_artista}`;
    }
    return "Artista del catálogo";
  }, [perfilArtista, obra]);

  const sello = certificado?.codigo_qr_validacion ?? obra?.codigo_qr_obra ?? null;

  const continuarPago = async () => {
    setContinuando(true);
    try {
      const { checkout_url } = await obtenerCheckoutWompi(transaccion.id_transaccion);
      window.location.href = checkout_url;
    } catch (error) {
      notificar(obtenerMensajeError(error, "No fue posible continuar el pago"), "error");
      setContinuando(false);
    }
  };

  const abrirModal = () => {
    onAbrirDetalle({
      transaccion,
      obra,
      nombreArtista,
      certificado: certificado ?? null,
    });
  };

  return (
    <CompraCard
      idTransaccion={transaccion.id_transaccion}
      idObra={transaccion.id_obra}
      titulo={obra?.titulo ?? `Obra #${transaccion.id_obra}`}
      artista={nombreArtista}
      fechaIso={transaccion.fecha_pago}
      precio={transaccion.monto_total}
      estado={transaccion.estado_pago}
      imagenUrl={obra ? urlPreviewObra(obra.id_obra) : undefined}
      certificadoUrl={certificado?.pdf_certificado_url}
      selloVerificacion={sello}
      onVerCertificado={aprobada ? abrirModal : undefined}
      onVerComprobante={abrirModal}
      onContinuarPago={transaccion.estado_pago === "Procesando" ? continuarPago : undefined}
      continuandoPago={continuando}
    />
  );
}

/**
 * 6.10 Mis compras
 * Nivel 1 — Funcional.
 * H1 "Mis compras", pestañas "Todas", "Aprobadas" y "Pendientes",
 * lista de tarjetas de compra según 4.5, ordenadas por fecha descendente, 10 por página.
 */
export function MisComprasPage() {
  const { notificar } = useToast();
  const [pestana, setPestana] = useState<PestanaCompras>("todas");
  const [pagina, setPagina] = useState(1);
  const [detalleActivo, setDetalleActivo] = useState<DetalleCompraSeleccionada | null>(null);

  const {
    data: transacciones,
    isLoading,
    isError,
    refetch,
  } = useQuery({
    queryKey: ["mis-transacciones"],
    queryFn: listarMisTransacciones,
  });

  const transaccionesOrdenadas = useMemo(() => {
    if (!transacciones) return [];
    return transacciones
      .slice()
      .sort((a, b) => new Date(b.fecha_pago).getTime() - new Date(a.fecha_pago).getTime());
  }, [transacciones]);

  const conteos = useMemo(() => {
    let aprobadas = 0;
    let pendientes = 0;
    for (const tx of transaccionesOrdenadas) {
      if (tx.estado_pago === "Confirmado" || tx.estado_pago === "Dispersado") {
        aprobadas += 1;
      } else if (tx.estado_pago === "Procesando") {
        pendientes += 1;
      }
    }
    return {
      todas: transaccionesOrdenadas.length,
      aprobadas,
      pendientes,
    };
  }, [transaccionesOrdenadas]);

  const itemsPestanas: ItemPestana<PestanaCompras>[] = [
    { id: "todas", etiqueta: "Todas", conteo: conteos.todas },
    { id: "aprobadas", etiqueta: "Aprobadas", conteo: conteos.aprobadas },
    { id: "pendientes", etiqueta: "Pendientes", conteo: conteos.pendientes },
  ];

  const transaccionesFiltradas = useMemo(() => {
    if (pestana === "aprobadas") {
      return transaccionesOrdenadas.filter(
        (tx) => tx.estado_pago === "Confirmado" || tx.estado_pago === "Dispersado"
      );
    }
    if (pestana === "pendientes") {
      return transaccionesOrdenadas.filter((tx) => tx.estado_pago === "Procesando");
    }
    return transaccionesOrdenadas;
  }, [transaccionesOrdenadas, pestana]);

  const totalPaginas = Math.max(1, Math.ceil(transaccionesFiltradas.length / COMPRAS_POR_PAGINA));
  const paginaSegura = Math.min(pagina, totalPaginas);

  const transaccionesPaginadas = useMemo(() => {
    const inicio = (paginaSegura - 1) * COMPRAS_POR_PAGINA;
    return transaccionesFiltradas.slice(inicio, inicio + COMPRAS_POR_PAGINA);
  }, [transaccionesFiltradas, paginaSegura]);

  const cambiarPestana = (nueva: PestanaCompras) => {
    setPestana(nueva);
    setPagina(1);
  };

  const copiarEnlaceVerificacion = async (codigo: string) => {
    const url = `${window.location.origin}/verificar/${encodeURIComponent(codigo)}`;
    try {
      await navigator.clipboard.writeText(url);
      notificar("Enlace copiado al portapapeles", "exito");
    } catch {
      notificar("No pudimos copiar el enlace automáticamente", "error");
    }
  };

  const detalleAprobado =
    detalleActivo?.transaccion.estado_pago === "Confirmado" ||
    detalleActivo?.transaccion.estado_pago === "Dispersado";

  const codigoCertificadoDetalle =
    detalleActivo?.certificado?.codigo_qr_validacion ??
    detalleActivo?.obra?.codigo_qr_obra ??
    (detalleActivo ? `CERT-${detalleActivo.transaccion.id_obra}-${detalleActivo.transaccion.id_transaccion}` : "");

  return (
    <div className="relative min-h-[calc(100vh-var(--alto-cabecera))]">
      <Ambiente nivel={1} />

      <div className="relative z-10 mx-auto max-w-[var(--contenedor-max)] px-[var(--espacio-16)] py-[var(--espacio-48)] sm:px-[var(--espacio-24)]">
        {/* Cabecera */}
        <header className="mb-[var(--espacio-32)]">
          <h1 className="voz-h1 text-[color:var(--tinta)]">Mis compras</h1>
          <div className="regla-titulo mt-[var(--espacio-12)]" aria-hidden="true" />
        </header>

        {/* Pestañas */}
        <Tabs
          items={itemsPestanas}
          activa={pestana}
          onChange={cambiarPestana}
          ariaLabel="Filtrar compras por estado"
          className="mb-[var(--espacio-32)]"
        />

        {/* Estado de carga: 3 esqueletos */}
        {isLoading && (
          <div className="flex flex-col gap-[var(--espacio-16)]" role="status" aria-label="Cargando compras">
            {Array.from({ length: 3 }).map((_, idx) => (
              <div
                key={idx}
                className="flex flex-col justify-between gap-[var(--espacio-16)] border border-[color:var(--borde-reposo)] bg-[color:var(--superficie-elevada)] p-[var(--espacio-24)] sm:flex-row sm:items-center"
              >
                <div className="flex items-start gap-[var(--espacio-16)]">
                  <Skeleton className="h-[var(--miniatura-96)] w-[var(--miniatura-96)] shrink-0" />
                  <div className="flex flex-col gap-[var(--espacio-8)]">
                    <Skeleton className="h-[var(--espacio-24)] w-48" />
                    <Skeleton className="h-[var(--espacio-16)] w-32" />
                    <Skeleton className="h-[var(--espacio-16)] w-24" />
                    <Skeleton className="h-[var(--espacio-20)] w-36" />
                  </div>
                </div>
                <div className="flex flex-col items-start gap-[var(--espacio-12)] sm:items-end">
                  <Skeleton className="h-[var(--espacio-24)] w-28" />
                  <div className="flex gap-[var(--espacio-8)]">
                    <Skeleton className="h-[var(--alto-control)] w-32" />
                    <Skeleton className="h-[var(--alto-control)] w-24" />
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}

        {/* Estado de error */}
        {isError && !isLoading && (
          <SectionError
            recurso="tus compras"
            onReintentar={() => {
              void refetch();
            }}
          />
        )}

        {/* Estado vacío global */}
        {!isLoading && !isError && transaccionesOrdenadas.length === 0 && (
          <EmptyState
            titulo="Aún no tienes compras."
            descripcion="Explora las obras disponibles en el catálogo y adquiere piezas con certificado verificable."
            accion={
              <Link to="/?vista=catalogo">
                <Button variante="primario">Explorar obras</Button>
              </Link>
            }
          />
        )}

        {/* Estado vacío en pestaña filtrada */}
        {!isLoading &&
          !isError &&
          transaccionesOrdenadas.length > 0 &&
          transaccionesFiltradas.length === 0 && (
            <EmptyState
              titulo={
                pestana === "aprobadas"
                  ? "No tienes compras aprobadas."
                  : "No tienes compras pendientes."
              }
              accion={
                <Button variante="secundario" onClick={() => cambiarPestana("todas")}>
                  Ver todas las compras
                </Button>
              }
            />
          )}

        {/* Lista de tarjetas de compra */}
        {!isLoading && !isError && transaccionesPaginadas.length > 0 && (
          <div className="flex flex-col gap-[var(--espacio-16)]">
            {transaccionesPaginadas.map((tx) => (
              <ItemCompra
                key={tx.id_transaccion}
                transaccion={tx}
                onAbrirDetalle={setDetalleActivo}
              />
            ))}

            <Pagination
              paginaActual={paginaSegura}
              totalPaginas={totalPaginas}
              onChange={(nuevaPagina) => {
                setPagina(nuevaPagina);
                window.scrollTo({ top: 0, behavior: "smooth" });
              }}
              className="mt-[var(--espacio-24)]"
            />
          </div>
        )}
      </div>

      {/* Modal de detalle de compra y certificado */}
      <Modal
        abierto={Boolean(detalleActivo)}
        onCerrar={() => setDetalleActivo(null)}
        titulo={detalleActivo?.obra?.titulo ?? "Detalle de la compra"}
        descripcion={detalleActivo ? `Artista: ${detalleActivo.nombreArtista}` : undefined}
      >
        {detalleActivo && (
          <div className="flex flex-col gap-[var(--espacio-24)]">
            {/* Resumen de la compra */}
            <dl className="flex flex-col gap-[var(--espacio-12)] border border-[color:var(--borde-reposo)] bg-[color:var(--superficie-elevada)] p-[var(--espacio-16)]">
              <div className="flex items-center justify-between gap-[var(--espacio-12)]">
                <dt className="voz-cuerpo-pequeno text-[color:var(--tinta-suave)]">Estado</dt>
                <dd>
                  <BadgeEstadoPago estado={detalleActivo.transaccion.estado_pago} />
                </dd>
              </div>
              <div className="flex items-center justify-between gap-[var(--espacio-12)]">
                <dt className="voz-cuerpo-pequeno text-[color:var(--tinta-suave)]">Referencia</dt>
                <dd className="codigo-certificado text-[length:var(--text-cuerpo-pequeno)] text-[color:var(--tinta)]">
                  {detalleActivo.transaccion.referencia_pasarela ??
                    `TX-${detalleActivo.transaccion.id_transaccion}`}
                </dd>
              </div>
              <div className="flex items-center justify-between gap-[var(--espacio-12)]">
                <dt className="voz-cuerpo-pequeno text-[color:var(--tinta-suave)]">Fecha</dt>
                <dd className="voz-dato text-[color:var(--tinta)]">
                  {formatearFecha(detalleActivo.transaccion.fecha_pago)}
                </dd>
              </div>
              <div className="flex items-center justify-between gap-[var(--espacio-12)]">
                <dt className="voz-cuerpo-pequeno text-[color:var(--tinta-suave)]">Método de pago</dt>
                <dd className="voz-cuerpo-pequeno text-[color:var(--tinta)]">
                  {obtenerMetodoPagoEnmascarado(detalleActivo.transaccion.referencia_pasarela)}
                </dd>
              </div>
              <div className="flex items-center justify-between gap-[var(--espacio-12)] border-t border-[color:var(--divisor)] pt-[var(--espacio-12)]">
                <dt className="voz-cuerpo-pequeno text-[color:var(--tinta-suave)]">Monto total</dt>
                <dd className="voz-dato text-[color:var(--tinta)]">
                  {formatearMoneda(detalleActivo.transaccion.monto_total)}
                </dd>
              </div>
            </dl>

            {/* Nota si está pendiente */}
            {detalleActivo.transaccion.estado_pago === "Procesando" && (
              <p className="voz-cuerpo-pequeno text-[color:var(--tinta-suave)]">
                Actualizaremos este estado cuando el banco confirme.
              </p>
            )}

            {/* Bloque de certificado (solo en compras aprobadas) */}
            {detalleAprobado && (
              <div className="flex flex-col items-center gap-[var(--espacio-16)] border border-[color:var(--borde-reposo)] bg-[color:var(--vacio)] p-[var(--espacio-24)] text-center">
                <SelloCertificado
                  etiqueta="CERTIFICADO"
                  codigo={codigoCertificadoDetalle}
                  valido
                />
                <div className="flex flex-col gap-[var(--espacio-4)]">
                  <span className="voz-etiqueta text-[color:var(--tinta-suave)]">
                    Código de verificación
                  </span>
                  <span className="codigo-certificado break-all text-[length:var(--text-cuerpo-pequeno)] text-[color:var(--tinta)]">
                    {codigoCertificadoDetalle}
                  </span>
                </div>

                <div className="flex w-full flex-col gap-[var(--espacio-12)] sm:flex-row sm:justify-center">
                  {detalleActivo.certificado?.pdf_certificado_url ? (
                    <a
                      href={detalleActivo.certificado.pdf_certificado_url}
                      target="_blank"
                      rel="noreferrer"
                    >
                      <Button variante="primario" tamano="compacto">
                        Descargar certificado
                      </Button>
                    </a>
                  ) : (
                    <Link to={`/verificar/${encodeURIComponent(codigoCertificadoDetalle)}`}>
                      <Button variante="primario" tamano="compacto">
                        Descargar certificado
                      </Button>
                    </Link>
                  )}

                  <Button
                    variante="secundario"
                    tamano="compacto"
                    onClick={() => void copiarEnlaceVerificacion(codigoCertificadoDetalle)}
                  >
                    Copiar enlace de verificación
                  </Button>
                </div>
              </div>
            )}

            <div className="flex justify-end gap-[var(--espacio-12)]">
              <Link to={`/obras/${detalleActivo.transaccion.id_obra}`}>
                <Button variante="terciario">Ver obra</Button>
              </Link>
              <Button variante="secundario" onClick={() => setDetalleActivo(null)}>
                Cerrar
              </Button>
            </div>
          </div>
        )}
      </Modal>
    </div>
  );
}
</file>

<file path="src/pages/NotFoundPage.tsx">
import { useEffect } from "react";
import { Link, useLocation } from "react-router-dom";
import { useAuth } from "../context/AuthContext";
import { Ambiente } from "../components/escena/Ambiente";
import { Disco } from "../components/escena/Disco";
import { Button } from "../components/ui/Button";
import { EmptyState } from "../components/ui/EmptyState";
import { ArtistasPage } from "./ArtistasPage";
import { CuentaPage } from "./CuentaPage";
import { PanelInstitucionalPage } from "./institucional/Paginas";
import { LegalContactoPage, type VistaLegal } from "./LegalContactoPage";
import { VerificarCertificadoPage } from "./VerificarCertificadoPage";

function resolverRutaLegal(pathname: string): VistaLegal | null {
  if (pathname === "/terminos" || pathname === "/legal/terminos") return "terminos";
  if (pathname === "/privacidad" || pathname === "/legal/privacidad") return "privacidad";
  if (pathname === "/acerca" || pathname === "/legal/acerca") return "acerca";
  if (pathname === "/contacto" || pathname === "/legal/contacto") return "contacto";
  return null;
}

/**
 * 6.17 Errores: 404, 403 y 500
 * - 404 (Nivel 3): el vacío. Un disco centrado de min(60 vmin, 420 px) con "404" en Playfair 900
 *   y, debajo, la cursiva "Esta página no existe.". Botones "Volver al inicio" (primario)
 *   y "Ver obras" (secundario). Luz estática y cabecera mínima.
 */
export function NotFoundPage() {
  const { pathname } = useLocation();
  const esRutaCuenta = pathname === "/cuenta";
  const esRutaInstitucional =
    pathname === "/institucional" || pathname.startsWith("/institucional/");
  const esRutaArtistas = pathname === "/artistas";
  const esRutaVerificar = pathname === "/verificar-certificado";
  const vistaLegal = resolverRutaLegal(pathname);

  const esRutaDelegada =
    esRutaCuenta ||
    esRutaInstitucional ||
    esRutaArtistas ||
    esRutaVerificar ||
    vistaLegal !== null;

  useEffect(() => {
    if (!esRutaDelegada) {
      document.title = "404 · Pixel & Lienzo";
    }
  }, [esRutaDelegada]);

  if (esRutaCuenta) {
    return <CuentaPage />;
  }

  if (esRutaInstitucional) {
    return <PanelInstitucionalPage />;
  }

  if (esRutaArtistas) {
    return <ArtistasPage />;
  }

  if (esRutaVerificar) {
    return <VerificarCertificadoPage />;
  }

  if (vistaLegal) {
    return <LegalContactoPage vistaInicial={vistaLegal} />;
  }

  return (
    <div className="relative flex min-h-[calc(100vh-var(--alto-cabecera))] flex-col items-center justify-center bg-[color:var(--vacio)] px-[var(--espacio-16)] py-[var(--espacio-64)] text-center">
      <Ambiente nivel={3} luzEstatica />

      <div className="relative z-10 flex flex-col items-center gap-[var(--espacio-32)]">
        <Disco
          nivel={3}
          variante="error"
          titulo="404"
          subtitulo="Esta página no existe."
        />

        <div className="flex flex-wrap items-center justify-center gap-[var(--espacio-16)]">
          <Link to="/">
            <Button variante="primario">Volver al inicio</Button>
          </Link>
          <Link to="/#coleccion">
            <Button variante="secundario">Ver obras</Button>
          </Link>
        </div>
      </div>
    </div>
  );
}

/**
 * 6.17 — 403 (Nivel 3):
 * El mismo patrón con "403" y "No tienes acceso a esta página.".
 * Sin sesión, el botón primario es "Ingresar"; con sesión, "Volver al inicio".
 */
export function ForbiddenPage() {
  const { user } = useAuth();

  useEffect(() => {
    document.title = "403 · Pixel & Lienzo";
  }, []);

  return (
    <div className="relative flex min-h-[calc(100vh-var(--alto-cabecera))] flex-col items-center justify-center bg-[color:var(--vacio)] px-[var(--espacio-16)] py-[var(--espacio-64)] text-center">
      <Ambiente nivel={3} luzEstatica />

      <div className="relative z-10 flex flex-col items-center gap-[var(--espacio-32)]">
        <Disco
          nivel={3}
          variante="error"
          titulo="403"
          subtitulo="No tienes acceso a esta página."
        />

        <div className="flex flex-wrap items-center justify-center gap-[var(--espacio-16)]">
          {user ? (
            <Link to="/">
              <Button variante="primario">Volver al inicio</Button>
            </Link>
          ) : (
            <Link to="/login">
              <Button variante="primario">Ingresar</Button>
            </Link>
          )}
          <Link to="/#coleccion">
            <Button variante="secundario">Ver obras</Button>
          </Link>
        </div>
      </div>
    </div>
  );
}

/**
 * 6.17 — 500 (Nivel 1):
 * Vacío pequeño con el icono "!" en ámbar, H1 "Algo salió mal" y el texto
 * "Ocurrió un error de nuestro lado. Inténtalo de nuevo en unos minutos.",
 * con el botón "Reintentar" y el enlace "Volver al inicio".
 * Si existe un código de referencia, se muestra abajo.
 */
export function ServerErrorPage({
  codigoReferencia,
  onReintentar,
}: {
  codigoReferencia?: string;
  onReintentar?: () => void;
}) {
  useEffect(() => {
    document.title = "Error · Pixel & Lienzo";
  }, []);

  const reintentar = () => {
    if (onReintentar) {
      onReintentar();
    } else {
      window.location.reload();
    }
  };

  return (
    <div className="relative flex min-h-[calc(100vh-var(--alto-cabecera))] flex-col items-center justify-center px-[var(--espacio-16)] py-[var(--espacio-64)] text-center">
      <Ambiente nivel={1} />

      <div className="relative z-10 flex max-w-[var(--contenedor-verificar)] flex-col items-center">
        <EmptyState
          titulo=""
          icono={
            <span className="inline-grid h-[var(--espacio-32)] w-[var(--espacio-32)] place-items-center rounded-[var(--radio-circulo)] border border-[color:var(--aviso)] font-[var(--fuente-poster)] text-[length:var(--text-h3)] leading-none text-[color:var(--aviso)]">
              !
            </span>
          }
          className="!py-0"
        />

        <h1 className="voz-h1 mt-[var(--espacio-16)] text-[color:var(--tinta)]">
          Algo salió mal
        </h1>

        <p className="voz-cuerpo mt-[var(--espacio-12)] text-[color:var(--tinta-suave)]">
          Ocurrió un error de nuestro lado. Inténtalo de nuevo en unos minutos.
        </p>

        <div className="mt-[var(--espacio-24)] flex flex-wrap items-center justify-center gap-[var(--espacio-24)]">
          <Button variante="primario" onClick={reintentar}>
            Reintentar
          </Button>
          <Link to="/">
            <Button variante="terciario">Volver al inicio</Button>
          </Link>
        </div>

        {codigoReferencia && (
          <p className="codigo-certificado mt-[var(--espacio-24)] text-[length:var(--text-cuerpo-pequeno)] text-[color:var(--tinta-suave)]">
            {codigoReferencia}
          </p>
        )}
      </div>
    </div>
  );
}
</file>

<file path="src/pages/ObraDetallePage.tsx">
import { useEffect, useMemo, useRef, useState } from "react";
import { Link, useNavigate, useParams, useSearchParams } from "react-router-dom";
import { useQuery } from "@tanstack/react-query";
import { Box, FileText, Maximize2, QrCode, ShieldCheck, ShoppingBag, X } from "lucide-react";
import clsx from "clsx";
import { listarCatalogo, obtenerObra, obtenerObraPorUid, urlQrObra } from "../api/obras";
import { obtenerPerfilArtista } from "../api/artistas";
import { obtenerCertificado, urlQrCertificado } from "../api/certificados";
import { obtenerTrazabilidad } from "../api/trazabilidad";
import { crearTransaccion } from "../api/transacciones";
import { useAuth } from "../context/AuthContext";
import { useCart } from "../context/CartContext";
import { useToast } from "../context/ToastContext";
import { Ambiente } from "../components/escena/Ambiente";
import { ObraCard } from "../components/ObraCard";
import { ObraVisor3DModal } from "../components/catalogo/ObraVisor3DModal";
import {
  OBRAS_MUESTRA_PALACIO,
  esObraMuestraLocal,
  resolverNombreArtistaObra,
  resolverUrlImagenObra,
} from "../lib/obrasMuestraPalacio";
import { LineaTrazabilidad } from "../components/LineaTrazabilidad";
import { Button } from "../components/ui/Button";
import { BadgeEstadoObra } from "../components/ui/Badge";
import { Banner } from "../components/ui/Banner";
import { Breadcrumbs } from "../components/ui/Breadcrumbs";
import { SelloCertificado } from "../components/ui/SelloCertificado";
import { PageProgressBar, Skeleton } from "../components/ui/Skeleton";
import { formatearFecha, formatearMoneda } from "../lib/formato";
import { obtenerMensajeError } from "../api/client";
import { CheckoutPage } from "./CheckoutPage";
import { NotFoundPage } from "./NotFoundPage";

type VistaEscenario = "obra" | "qr";

/**
 * 6.4 Detalle de obra (Nivel 2):
 * Dos columnas en escritorio (60 % obra sobre --vacio con luz roja suave de encendido 800 ms,
 * contain, máx 80 vh y visor "Ampliar"; 40 % migas, H1, artista en cursiva, etiquetas de
 * técnica/año/dimensiones, precio en H2, estado, "Comprar obra" a ancho completo, bloque
 * "Certificado de autenticidad" con SelloCertificado, descripción, ficha técnica clave-valor
 * y procedencia). Debajo, "Más de [Artista]" con 4 tarjetas de obra. En móvil, barra inferior
 * fija de 72 px al pasar el bloque de compra.
 */
export function ObraDetallePage() {
  const { idObra } = useParams<{ idObra: string }>();
  const [searchParams] = useSearchParams();
  const { user } = useAuth();
  const { agregarObra, abrirCarrito, estaEnCarrito } = useCart();
  const { notificar } = useToast();
  const navigate = useNavigate();

  const enModoCheckout = searchParams.get("checkout") === "1";

  const [comprando, setComprando] = useState(false);
  const [luzEncendida, setLuzEncendida] = useState(false);
  const [vistaActiva, setVistaActiva] = useState<VistaEscenario>("obra");
  const [visorAbierto, setVisorAbierto] = useState(false);
  const [visor3DAbierto, setVisor3DAbierto] = useState(false);
  const [zoomVisor, setZoomVisor] = useState(false);
  const [mostrarBarraMovil, setMostrarBarraMovil] = useState(false);
  const [fallbackImagenFamosa, setFallbackImagenFamosa] = useState(false);

  const bloqueCompraRef = useRef<HTMLDivElement>(null);
  const botonAmpliarRef = useRef<HTMLButtonElement>(null);

  const esIdNumerico = /^\d+$/.test(idObra ?? "");

  const obraMuestraFallback = useMemo(() => {
    if (!idObra) return undefined;
    if (esIdNumerico) {
      return OBRAS_MUESTRA_PALACIO.find((o) => o.id_obra === Number(idObra));
    }
    return OBRAS_MUESTRA_PALACIO.find((o) => o.uid.toLowerCase() === idObra.toLowerCase());
  }, [idObra, esIdNumerico]);

  const {
    data: obraApi,
    isLoading,
    isError,
  } = useQuery({
    queryKey: esIdNumerico ? ["obra", Number(idObra)] : ["obra-uid", idObra],
    queryFn: () => (esIdNumerico ? obtenerObra(Number(idObra)) : obtenerObraPorUid(idObra!)),
    enabled: !!idObra && !obraMuestraFallback,
    retry: 1,
  });

  const obra = obraApi ?? obraMuestraFallback;

  const { data: perfilArtista } = useQuery({
    queryKey: ["artista", obra?.id_artista],
    queryFn: () => obtenerPerfilArtista(obra!.id_artista),
    enabled: !!obra,
  });

  const { data: certificado } = useQuery({
    queryKey: ["certificado", obra?.id_obra],
    queryFn: () => obtenerCertificado(obra!.id_obra),
    enabled: !!obra,
    retry: false,
  });

  const { data: trazabilidad } = useQuery({
    queryKey: ["trazabilidad", obra?.id_obra],
    queryFn: () => obtenerTrazabilidad(obra!.id_obra),
    enabled: !!obra,
  });

  const { data: obrasDelArtista } = useQuery({
    queryKey: ["catalogo", "mas-del-artista", obra?.id_artista],
    queryFn: () => listarCatalogo({ id_artista: obra!.id_artista }),
    enabled: !!obra,
  });

  const masObras = useMemo(
    () => (obrasDelArtista ?? []).filter((item) => item.id_obra !== obra?.id_obra).slice(0, 4),
    [obrasDelArtista, obra?.id_obra]
  );

  // Momento teatral: la luz detrás de la obra se enciende de 0 a 1 en 800 ms al entrar
  useEffect(() => {
    setLuzEncendida(false);
    setVistaActiva("obra");
    setFallbackImagenFamosa(false);
    const timer = window.setTimeout(() => setLuzEncendida(true), 40);
    return () => window.clearTimeout(timer);
  }, [obra?.id_obra]);

  useEffect(() => {
    if (obra?.titulo) {
      document.title = `${obra.titulo} · Pixel & Lienzo`;
    }
  }, [obra?.titulo]);

  // Cierre del visor a pantalla completa con Escape
  useEffect(() => {
    if (!visorAbierto) return;
    const alTecla = (e: KeyboardEvent) => {
      if (e.key === "Escape") {
        setVisorAbierto(false);
        setZoomVisor(false);
        botonAmpliarRef.current?.focus();
      }
    };
    window.addEventListener("keydown", alTecla);
    return () => window.removeEventListener("keydown", alTecla);
  }, [visorAbierto]);

  // En móvil, al pasar el bloque de compra, "Comprar obra" queda fijo en una barra inferior de 72 px
  useEffect(() => {
    const el = bloqueCompraRef.current;
    if (!el) return;
    const observer = new IntersectionObserver(
      ([entry]) => {
        const pasoHaciaAbajo = !entry.isIntersecting && entry.boundingClientRect.top < 0;
        setMostrarBarraMovil(pasoHaciaAbajo);
      },
      { threshold: 0 }
    );
    observer.observe(el);
    return () => observer.disconnect();
  }, [obra?.id_obra]);

  if (isLoading) {
    return (
      <div className="relative min-h-screen py-[var(--espacio-48)]">
        <PageProgressBar etiqueta="Cargando obra…" />
        <Ambiente nivel={2} />
        <div className="contenedor-pyl relative z-10 grid grid-cols-1 gap-[var(--espacio-48)] min-[1024px]:grid-cols-[3fr_2fr]">
          <Skeleton className="h-[68vh] w-full" />
          <div className="flex flex-col gap-[var(--espacio-16)]">
            <Skeleton className="h-[var(--espacio-16)] w-1/3" />
            <Skeleton className="h-[var(--espacio-48)] w-3/4" />
            <Skeleton className="h-[var(--espacio-24)] w-1/2" />
            <Skeleton className="mt-[var(--espacio-16)] h-[var(--espacio-48)] w-1/3" />
            <Skeleton className="mt-[var(--espacio-16)] h-[var(--alto-control)] w-full rounded-[var(--radio-pildora)]" />
          </div>
        </div>
      </div>
    );
  }

  if ((isError || !obra) && !obraMuestraFallback) {
    return <NotFoundPage />;
  }
  if (!obra) {
    return <NotFoundPage />;
  }

  if (enModoCheckout) {
    return <CheckoutPage idObraProp={obra.id_obra} />;
  }

  // 6.4: "En revisión o retirada, el público ve una 404 y su artista ve un banner con el estado."
  const enRevisionORetirada =
    obra.estado_obra === "Pendiente" ||
    obra.estado_obra === "Mantenimiento" ||
    obra.estado_obra === "En Préstamo";

  const esAutorizadoParaVerNoPublicada =
    user?.rol === "Artista" || user?.rol === "Curador" || user?.rol === "Administrador";

  if (enRevisionORetirada && !esAutorizadoParaVerNoPublicada) {
    return <NotFoundPage />;
  }

  const disponible = obra.estado_obra === "Publicado";
  const vendida = obra.estado_obra === "Vendido";
  const reservada = obra.estado_obra === "Reservado";

  const comprar = async () => {
    if (!user) {
      navigate("/login", { state: { from: { pathname: `/obras/${obra.id_obra}` } } });
      return;
    }
    if (user.rol !== "Comprador") {
      notificar("Solo una cuenta de Coleccionista puede adquirir obras.", "error");
      return;
    }
    setComprando(true);
    try {
      const transaccion = await crearTransaccion(obra.id_obra);
      window.location.href = transaccion.checkout_url;
    } catch (error) {
      notificar(obtenerMensajeError(error, "No fue posible iniciar el pago."), "error");
      setComprando(false);
    }
  };

  const esMuestraLocal = esObraMuestraLocal(obra);
  const urlImagenPrincipal = resolverUrlImagenObra(obra, esMuestraLocal || fallbackImagenFamosa);
  const urlImagenActiva =
    vistaActiva === "qr" && obra.codigo_qr_obra ? urlQrObra(obra.id_obra) : urlImagenPrincipal;
  const nombreArtista = resolverNombreArtistaObra(obra);

  return (
    <div className="relative min-h-screen pb-[calc(var(--alto-barra-compra-movil)+var(--espacio-48))] pt-[var(--espacio-32)] min-[1024px]:pb-[var(--espacio-96)]">
      <Ambiente nivel={2} />

      <div className="contenedor-pyl relative z-10">
        {enRevisionORetirada && (
          <div className="mb-[var(--espacio-24)]">
            <Banner variante="informativo">
              Esta obra se encuentra en estado <strong>{obra.estado_obra}</strong> y no es visible para el público general.
            </Banner>
          </div>
        )}

        {/* Estructura en escritorio: dos columnas 60 % / 40 % */}
        <div className="grid grid-cols-1 gap-[var(--espacio-48)] min-[1024px]:grid-cols-[3fr_2fr] min-[1024px]:items-start">
          {/* Columna izquierda (60 %): la obra sobre escenario --vacio con luz roja suave de encendido 800 ms */}
          <div className="flex flex-col gap-[var(--espacio-16)]">
            <div className="relative flex min-h-[360px] items-center justify-center border border-[color:var(--borde-reposo)] bg-[color:var(--vacio)] p-[var(--espacio-24)] min-[768px]:p-[var(--espacio-32)]">
              {/* Momento teatral: luz roja suave detrás de la obra (0 -> 1 en 800 ms) */}
              <div
                aria-hidden="true"
                className={clsx(
                  "pointer-events-none absolute inset-0 transition-opacity duration-[var(--duracion-momento-min)] ease-[var(--curva-base)]",
                  luzEncendida ? "opacity-100" : "opacity-0"
                )}
                style={{
                  background:
                    "radial-gradient(ellipse 65% 60% at 50% 50%, var(--luz-escenario-obra), transparent 72%)",
                }}
              />

              <img
                src={urlImagenActiva}
                alt={vistaActiva === "qr" ? `Código QR de ${obra.titulo}` : obra.titulo}
                decoding="async"
                onError={() => {
                  if (!fallbackImagenFamosa) setFallbackImagenFamosa(true);
                }}
                className="relative z-10 max-h-[80vh] w-full object-contain"
              />
            </div>

            {/* Bajo la obra: miniaturas de vistas y botón "Ampliar" */}
            <div className="flex flex-wrap items-center justify-between gap-[var(--espacio-16)]">
              <div className="flex items-center gap-[var(--espacio-12)]">
                <button
                  type="button"
                  onClick={() => setVistaActiva("obra")}
                  aria-label="Vista principal de la obra"
                  aria-pressed={vistaActiva === "obra"}
                  className={clsx(
                    "h-[var(--espacio-64)] w-[var(--espacio-64)] overflow-hidden border bg-[color:var(--vacio)] p-[var(--espacio-4)] transition-colors duration-[var(--duracion-hover)] cursor-pointer",
                    vistaActiva === "obra"
                      ? "border-[color:var(--riel)]"
                      : "border-[color:var(--divisor)] hover:border-[color:var(--borde-hover)]"
                  )}
                >
                  <img
                    src={urlImagenPrincipal}
                    alt=""
                    className="h-full w-full object-contain"
                  />
                </button>

                {obra.codigo_qr_obra && (
                  <button
                    type="button"
                    onClick={() => setVistaActiva("qr")}
                    aria-label="Ver código QR físico de la obra"
                    aria-pressed={vistaActiva === "qr"}
                    className={clsx(
                      "inline-flex h-[var(--espacio-64)] w-[var(--espacio-64)] flex-col items-center justify-center gap-[var(--espacio-4)] border bg-[color:var(--vacio)] p-[var(--espacio-4)] text-[color:var(--tinta-suave)] transition-colors duration-[var(--duracion-hover)] cursor-pointer",
                      vistaActiva === "qr"
                        ? "border-[color:var(--riel)] text-[color:var(--tinta)]"
                        : "border-[color:var(--divisor)] hover:border-[color:var(--borde-hover)]"
                    )}
                  >
                    <QrCode size={20} strokeWidth={1.5} aria-hidden="true" />
                    <span className="font-[var(--fuente-poster)] text-[length:var(--text-minimo)] uppercase">
                      QR
                    </span>
                  </button>
                )}
              </div>

              <div className="flex flex-wrap items-center gap-[var(--espacio-12)]">
                <Button
                  type="button"
                  variante="primario"
                  onClick={() => setVisor3DAbierto(true)}
                >
                  <Box size={19} strokeWidth={1.7} aria-hidden="true" />
                  <span>Ver en 3D y escala real</span>
                </Button>

                <Button
                  ref={botonAmpliarRef}
                  type="button"
                  variante="secundario"
                  onClick={() => {
                    setZoomVisor(false);
                    setVisorAbierto(true);
                  }}
                >
                  <Maximize2 size={20} strokeWidth={1.5} aria-hidden="true" />
                  <span>Ampliar</span>
                </Button>
              </div>
            </div>
          </div>

          {/* Columna derecha (40 %): migas, H1, artista en cursiva, etiquetas, precio en H2, estado, acción y ficha */}
          <div className="flex flex-col gap-[var(--espacio-24)]">
            <Breadcrumbs
              items={[
                { etiqueta: "Obras", to: "/#coleccion" },
                { etiqueta: obra.titulo },
              ]}
            />

            <div>
              <h1 className="voz-h1 text-[color:var(--tinta)]">{obra.titulo}</h1>
              <p className="mt-[var(--espacio-8)]">
                <Link
                  to={`/artistas/${obra.id_artista}`}
                  className="voz-acento text-[color:var(--tinta-suave)] underline-offset-4 hover:text-[color:var(--tinta)] hover:underline"
                >
                  {nombreArtista}
                </Link>
              </p>
            </div>

            {/* Etiquetas de técnica, año y dimensiones */}
            <div className="flex flex-wrap items-center gap-[var(--espacio-8)]">
              <span className="inline-flex items-center border border-[color:var(--borde-reposo)] px-[var(--espacio-12)] py-[var(--espacio-4)] font-[var(--fuente-poster)] text-[length:var(--text-minimo)] uppercase tracking-[0.12em] text-[color:var(--tinta)]">
                {obra.tecnica}
              </span>
              {obra.anio_creacion && (
                <span className="inline-flex items-center border border-[color:var(--borde-reposo)] px-[var(--espacio-12)] py-[var(--espacio-4)] font-[var(--fuente-poster)] text-[length:var(--text-minimo)] uppercase tracking-[0.12em] text-[color:var(--tinta)]">
                  {obra.anio_creacion}
                </span>
              )}
              <span className="inline-flex items-center border border-[color:var(--borde-reposo)] px-[var(--espacio-12)] py-[var(--espacio-4)] font-[var(--fuente-poster)] text-[length:var(--text-minimo)] uppercase tracking-[0.12em] text-[color:var(--tinta)]">
                {obra.dimensiones}
              </span>
            </div>

            {/* Precio en H2 y Estado */}
            <div className="flex flex-wrap items-center justify-between gap-[var(--espacio-16)] border-y border-[color:var(--divisor)] py-[var(--espacio-16)]">
              <h2 className="voz-h2 precio-obra text-[color:var(--tinta)]">
                {formatearMoneda(obra.precio_venta)}
              </h2>
              <BadgeEstadoObra estado={obra.estado_obra} />
            </div>

            {/* Bloque de compra según el estado de la obra */}
            <div ref={bloqueCompraRef} className="flex flex-col gap-[var(--espacio-12)]">
              {reservada && (
                <Banner variante="informativo">
                  Otra persona está comprando esta obra. Vuelve en unos minutos.
                </Banner>
              )}

              {vendida ? (
                <>
                  <Button type="button" variante="secundario" disabled className="w-full">
                    Obra adquirida
                  </Button>
                  <div className="text-center">
                    <Link
                      to={`/arte?categoria=${obra.id_categoria}`}
                      className="enlace-acceso text-[length:var(--text-cuerpo-pequeno)]"
                    >
                      Ver obras similares
                    </Link>
                  </div>
                </>
              ) : (
                <div className="flex flex-col gap-[var(--espacio-12)] sm:flex-row">
                  <Button
                    type="button"
                    variante="primario"
                    disabled={!disponible}
                    cargando={comprando}
                    onClick={comprar}
                    className="flex-1"
                  >
                    Comprar obra
                  </Button>
                  <Button
                    type="button"
                    variante="secundario"
                    disabled={!disponible}
                    onClick={() => {
                      if (estaEnCarrito(obra.id_obra)) {
                        abrirCarrito();
                      } else {
                        agregarObra(obra);
                        notificar("Obra agregada al carrito de compra", "exito");
                        abrirCarrito();
                      }
                    }}
                    className="flex-1"
                  >
                    <ShoppingBag size={18} strokeWidth={1.6} aria-hidden="true" />
                    <span>{estaEnCarrito(obra.id_obra) ? "En el carrito" : "Agregar al carrito"}</span>
                  </Button>
                </div>
              )}
            </div>

