                  }}
                />

                {/* Cara frontal del cuadro: Marco de madera natural clara + sombra interior + lienzo de la pintura */}
                <div
                  className=" absolute inset-0 box-border flex items-center justify-center"
                  style={{
                    transform: `translateZ(${grosorMarco / 2}px)`,
                    padding: "11px",
