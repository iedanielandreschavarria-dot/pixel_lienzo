                        <div className="grid grid-cols-1 gap-[var(--espacio-12)] sm:grid-cols-2">
                          <Button
                            variante="secundario"
                            onClick={() => setModalCambiosAbierto(true)}
                            disabled={mutacionDecisionObra.isPending}
                          >
                            Solicitar cambios
                          </Button>
                          <Button
                            variante="destructivo"
                            onClick={() => setModalRechazarAbierto(true)}
                            disabled={mutacionDecisionObra.isPending}
                          >
                            Rechazar
                          </Button>
                        </div>
