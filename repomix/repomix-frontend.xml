            {!cargandoCertificados &&
              !errorCertificados &&
              sinCertificado &&
              sinCertificado.length > 0 && (
                <Table
                  columnas={columnasCertificados}
                  datos={sinCertificado}
                  obtenerClave={(f) => f.id_obra}
