                  >
                    Cerrar sesión
                  </button>
                </li>
              </ul>
            </div>
          )}
        </div>
        {renderBotonWhatsApp()}
      </div>
    );
  };

  const renderDrawerCarrito = () => {
    if (!carritoAbierto) return null;
    return (
      <div
        role="dialog"
