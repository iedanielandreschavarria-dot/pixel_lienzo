const CONFIRMACION_NEUTRA = "Si el correo está registrado, recibirás un enlace en unos minutos.";

export function RecuperarPasswordPage() {
  const { notificar } = useToast();

  useEffect(() => {
    document.title = "Recuperar contraseña · Pixel & Lienzo";
