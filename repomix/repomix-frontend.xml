<file path="src/components/layout/Layout.tsx">
import { useEffect } from "react";
import { Outlet, useLocation } from "react-router-dom";
import { Header, type VarianteCabecera } from "./Header";
import { Footer } from "./Footer";
import { OfflineBanner } from "../ui/Banner";
import { registrarEscenaActual } from "../../lib/transicionEscena";

const PREFIJOS_NIVEL_3 = [
  "/login",
  "/ingresar",
  "/mfa",
  "/registro",
  "/verificar-email",
  "/recuperar-password",
  "/recuperar",
  "/restablecer-password",
];

const PATRONES_CONOCIDOS_NIVEL_1_2: RegExp[] = [
  /^\/$/,
  /^\/kit$/,
  /^\/sala-palacio-nacional(\/[^/]+)?$/,
  /^\/exposiciones(\/[^/]+)?$/,
  /^\/arte(\/[^/]+)?$/,
  /^\/colecciones(\/[^/]+)?$/,
  /^\/mas(\/[^/]+)?$/,
  /^\/obras\/[^/]+$/,
  /^\/verificar\/[^/]+$/,
  /^\/verificar-certificado$/,
  /^\/estudio$/,
  /^\/estudio-motion$/,
  /^\/artistas(\/[^/]+)?$/,
  /^\/compras\/[^/]+\/resultado$/,
  /^\/checkout\/[^/]+(\/resultado)?$/,
  /^\/mis-compras(\/[^/]+)?$/,
  /^\/cuenta$/,
  /^\/artista(\/.*)?$/,
  /^\/curaduria(\/.*)?$/,
  /^\/institucional(\/.*)?$/,
  /^\/terminos$/,
  /^\/privacidad$/,
  /^\/acerca$/,
  /^\/contacto$/,
  /^\/legal\/(terminos|privacidad|acerca|contacto)$/,
];

function esRutaNivel3(pathname: string): boolean {
  if (PREFIJOS_NIVEL_3.some((p) => pathname === p || pathname.startsWith(`${p}/`))) {
    return true;
  }
  const esConocidaNivel1o2 = PATRONES_CONOCIDOS_NIVEL_1_2.some((re) => re.test(pathname));
  return !esConocidaNivel1o2;
}

function esRutaPanel(pathname: string): boolean {
  return (
    pathname.startsWith("/artista/") ||
    pathname === "/artista" ||
    pathname.startsWith("/curaduria") ||
    pathname.startsWith("/institucional")
  );
}

/**
 * Estructura base de aplicación:
 * - En Inicio (escena con arco y actos) se muestra siempre la cabecera completa
 *   con logo, barra de búsqueda central, carrito de compra, ingresar y las opciones
 *   (Sala Palacio Nacional, Artistas, Exposiciones, Arte, Colecciones, Más).
 */
export function Layout() {
  const { pathname, hash, search } = useLocation();

  const enInicioEscena =
    pathname === "/" &&
    hash !== "#coleccion" &&
    hash !== "#artistas" &&
    search.length === 0;
  const nivel3 = enInicioEscena || esRutaNivel3(pathname);
  const enCheckout =
    (pathname.startsWith("/checkout/") && !pathname.endsWith("/resultado")) ||
    (pathname.startsWith("/obras/") && new URLSearchParams(search).get("checkout") === "1");
  const enPanel = esRutaPanel(pathname);

  useEffect(() => {
    if (!nivel3) {
      registrarEscenaActual("otra", pathname);
    }
  }, [nivel3, pathname]);

  const varianteHeader: VarianteCabecera = enCheckout
    ? "checkout"
    : enInicioEscena
      ? "completa"
      : nivel3
        ? "minima"
        : "completa";

  const mostrarPie = (!nivel3 || enInicioEscena) && !enCheckout && !enPanel;

  return (
    <div className="flex min-h-screen flex-col bg-[color:var(--fondo)] text-[color:var(--tinta)]">
      <a
        href="#contenido-principal"
        className="sr-only focus:not-sr-only focus:fixed focus:left-[var(--espacio-16)] focus:top-[var(--espacio-16)] focus:z-50 focus:rounded-[var(--radio-pildora)] focus:border focus:border-white focus:bg-[color:var(--carmesi)] focus:px-[var(--espacio-24)] focus:py-[var(--espacio-12)] focus:font-[var(--fuente-texto)] focus:font-semibold focus:text-[color:var(--tinta)] focus:no-underline"
      >
        Saltar al contenido
      </a>

      {!enPanel && (
        <Header
          variante={varianteHeader}
          fija={nivel3 && !enInicioEscena}
          hrefVolverObra={enCheckout && pathname.startsWith("/obras/") ? pathname : undefined}
        />
      )}

      <main id="contenido-principal" className="flex-1">
        <Outlet />
      </main>

      {mostrarPie && <Footer />}
      <OfflineBanner />
    </div>
  );
}
</file>

<file path="src/components/layout/PanelShell.tsx">
import { useState, type ReactNode } from "react";
import { Link, NavLink, useLocation, useNavigate } from "react-router-dom";
import {
  BarChart3,
  Building2,
  ClipboardCheck,
  FileSpreadsheet,
  FolderKanban,
  History,
  LayoutDashboard,
  LogOut,
  Menu,
  Palette,
  PlusCircle,
  ShieldCheck,
  ShoppingBag,
  UserCheck,
  UserCog,
  Users,
  X,
  type LucideIcon,
} from "lucide-react";
import clsx from "clsx";
import { useAuth } from "../../context/AuthContext";
import { Ambiente } from "../escena/Ambiente";
import { Breadcrumbs, type ItemMiga } from "../ui/Breadcrumbs";
import { LogoMarca } from "../ui/LogoMarca";
import type { NombreRol } from "../../types";

export interface EnlaceLateralPanel {
  to: string;
  etiqueta: string;
  icono: LucideIcon;
  end?: boolean;
}

export interface PanelShellProps {
  eyebrow?: string;
  migas?: ItemMiga[];
  titulo: string;
  descripcion?: string;
  acciones?: ReactNode;
  enlacesLaterales?: EnlaceLateralPanel[];
  children: ReactNode;
}

function enlacesPorDefecto(rol: NombreRol | undefined): EnlaceLateralPanel[] {
  switch (rol) {
    case "Artista":
      return [
        { to: "/artista", etiqueta: "Resumen", icono: LayoutDashboard, end: true },
        { to: "/artista?seccion=obras", etiqueta: "Mis obras", icono: Palette },
        { to: "/artista/obras/nueva", etiqueta: "Subir obra", icono: PlusCircle },
        { to: "/artista?seccion=ventas", etiqueta: "Ventas", icono: ShoppingBag },
        { to: "/artista/perfil", etiqueta: "Perfil público", icono: UserCog },
        { to: "/cuenta", etiqueta: "Cuenta", icono: UserCheck },
      ];
    case "Curador":
      return [
        { to: "/curaduria", etiqueta: "Cola de revisión", icono: ClipboardCheck, end: true },
        { to: "/curaduria?seccion=artistas", etiqueta: "Artistas", icono: Users },
        { to: "/curaduria?seccion=certificados", etiqueta: "Certificados", icono: ShieldCheck },
        { to: "/curaduria?seccion=historial", etiqueta: "Historial", icono: History },
      ];
    case "Administrador":
      return [
        { to: "/institucional", etiqueta: "Resumen", icono: LayoutDashboard, end: true },
        { to: "/institucional?seccion=colecciones", etiqueta: "Colecciones", icono: FolderKanban },
        { to: "/institucional?seccion=artistas", etiqueta: "Artistas asociados", icono: Palette },
        { to: "/institucional?seccion=reportes", etiqueta: "Reportes", icono: FileSpreadsheet },
        { to: "/institucional?seccion=perfil", etiqueta: "Perfil de la institución", icono: Building2 },
        { to: "/institucional?seccion=equipo", etiqueta: "Equipo", icono: BarChart3 },
      ];
    default:
      return [{ to: "/", etiqueta: "Catálogo", icono: Palette, end: true }];
  }
}

function inicialesDeCorreo(correo: string): string {
  const base = correo.split("@")[0] ?? "U";
  const partes = base.split(/[._-]+/).filter(Boolean);
  if (partes.length >= 2) {
    return `${partes[0][0] ?? ""}${partes[1][0] ?? ""}`.toUpperCase();
  }
  return base.slice(0, 2).toUpperCase();
}

/**
 * 6.12 Estructura común de los paneles:
 * Barra lateral: 240 px fija en escritorio. Arriba la marca; en el centro la navegación vertical
 * con icono y texto, donde el elemento activo lleva un borde izquierdo de 2 px en --riel;
 * abajo el avatar con el rol y "Cerrar sesión".
 * Cabecera de página: migas, H1 y la acción primaria a la derecha.
 * Contenido: contenedor de 1200 px, con tarjetas métricas, tablas y formularios en formato caja.
 * Móvil: la barra lateral se convierte en un menú de pantalla completa.
 */
export function PanelShell({
  eyebrow,
  migas,
  titulo,
  descripcion,
  acciones,
  enlacesLaterales,
  children,
}: PanelShellProps) {
  const { user, logout } = useAuth();
  const navigate = useNavigate();
  const location = useLocation();
  const [menuMovilAbierto, setMenuMovilAbierto] = useState(false);

  const enlaces = enlacesLaterales ?? enlacesPorDefecto(user?.rol);
  const migasFinales: ItemMiga[] =
    migas ?? (eyebrow ? [{ etiqueta: eyebrow }, { etiqueta: titulo }] : [{ etiqueta: titulo }]);

  const esEnlaceActivo = (item: EnlaceLateralPanel, isActiveRouter: boolean): boolean => {
    const tieneQuery = item.to.includes("?");
    if (tieneQuery) {
      return `${location.pathname}${location.search}` === item.to;
    }
    if (item.end) {
      return location.pathname === item.to && location.search === "";
    }
    return isActiveRouter;
  };

  const cerrarSesion = async () => {
    await logout();
    setMenuMovilAbierto(false);
    navigate("/");
  };

  return (
    <div className="relative min-h-screen bg-[color:var(--fondo)] text-[color:var(--tinta)]">
      <Ambiente nivel={1} />
      {/* Barra superior móvil (< 1024px) */}
      <header className="sticky top-0 z-40 flex h-[var(--alto-cabecera)] items-center justify-between border-b border-[color:var(--divisor)] bg-[color:var(--cabecera-fondo)] px-[var(--espacio-16)] min-[1024px]:hidden">
        <Link to="/" className="no-underline">
          <LogoMarca variante="riel" tamano="md" />
        </Link>
        <button
          type="button"
          onClick={() => setMenuMovilAbierto(true)}
          aria-label="Abrir navegación del panel"
          className="inline-grid h-[var(--area-tactil-min)] w-[var(--area-tactil-min)] place-items-center bg-transparent border-0 text-[color:var(--tinta)] cursor-pointer"
        >
          <Menu size={24} strokeWidth={1.5} aria-hidden="true" />
        </button>
      </header>

      {/* Barra lateral fija en escritorio (240px) */}
      <aside
        aria-label="Navegación del panel"
        className="fixed inset-y-0 left-0 z-30 hidden w-[var(--sidebar-ancho)] flex-col justify-between border-r border-[color:var(--divisor)] bg-[color:var(--fondo)] p-[var(--espacio-24)] min-[1024px]:flex"
      >
        <div>
          <Link to="/" className="inline-block no-underline">
            <LogoMarca variante="riel" tamano="md" />
          </Link>

          <nav aria-label="Secciones del panel" className="mt-[var(--espacio-32)] flex flex-col gap-[var(--espacio-8)]">
            {enlaces.map((item) => {
              const Icono = item.icono;
              return (
                <NavLink
                  key={item.to}
                  to={item.to}
                  end={item.end}
                  className={({ isActive }) =>
                    clsx(
                      "flex min-h-[var(--alto-control)] items-center gap-[var(--espacio-12)] border-l-2 px-[var(--espacio-16)] py-[var(--espacio-8)] font-[var(--fuente-texto)] font-semibold text-[length:var(--text-dato)] no-underline transition-colors duration-[var(--duracion-hover)]",
                      esEnlaceActivo(item, isActive)
                        ? "border-l-[color:var(--riel)] bg-[color:var(--superficie-elevada)] text-[color:var(--tinta)]"
                        : "border-l-transparent text-[color:var(--tinta-suave)] hover:text-[color:var(--tinta)]"
                    )
                  }
                >
                  <Icono size={20} strokeWidth={1.5} aria-hidden="true" />
                  <span>{item.etiqueta}</span>
                </NavLink>
              );
            })}
          </nav>
        </div>

        <div className="border-t border-[color:var(--divisor)] pt-[var(--espacio-16)]">
          {user && (
            <div className="mb-[var(--espacio-16)] flex items-center gap-[var(--espacio-12)]">
              <span
                aria-hidden="true"
                className="inline-grid h-[var(--alto-control-compacto)] w-[var(--alto-control-compacto)] shrink-0 place-items-center rounded-[var(--radio-circulo)] border border-[color:var(--riel)] bg-[color:var(--vacio)] font-[var(--fuente-poster)] text-[length:var(--text-minimo)] uppercase text-[color:var(--tinta)]"
              >
                {inicialesDeCorreo(user.correo_electronico)}
              </span>
              <div className="min-w-0 flex-1">
                <p className="voz-cuerpo-pequeno truncate text-[color:var(--tinta)]">{user.correo_electronico}</p>
                <p className="voz-etiqueta mt-[var(--espacio-4)] text-[color:var(--tinta-suave)]">{user.rol}</p>
              </div>
            </div>
          )}

          <button
            type="button"
            onClick={cerrarSesion}
            className="flex w-full items-center gap-[var(--espacio-8)] bg-transparent border-0 px-0 py-[var(--espacio-8)] font-[var(--fuente-texto)] font-semibold text-[length:var(--text-cuerpo-pequeno)] text-[color:var(--tinta-suave)] hover:text-[color:var(--tinta)] cursor-pointer"
          >
            <LogOut size={18} strokeWidth={1.5} aria-hidden="true" />
            <span>Cerrar sesión</span>
          </button>
        </div>
      </aside>

      {/* Menú móvil a pantalla completa */}
      {menuMovilAbierto && (
        <div
          role="dialog"
          aria-modal="true"
          aria-label="Menú del panel"
          className="fixed inset-0 z-50 flex flex-col justify-between bg-[color:var(--vacio)] p-[var(--espacio-24)] min-[1024px]:hidden"
        >
          <div className="flex items-center justify-between">
            <Link
              to="/"
              onClick={() => setMenuMovilAbierto(false)}
              className="no-underline"
            >
              <LogoMarca variante="riel" tamano="md" />
            </Link>
            <button
              type="button"
              onClick={() => setMenuMovilAbierto(false)}
              aria-label="Cerrar menú"
              className="inline-grid h-[var(--area-tactil-min)] w-[var(--area-tactil-min)] place-items-center bg-transparent border-0 text-[color:var(--tinta)] cursor-pointer"
            >
              <X size={24} strokeWidth={1.5} aria-hidden="true" />
            </button>
          </div>

          <nav aria-label="Navegación móvil del panel" className="flex flex-col items-center gap-[var(--espacio-24)] text-center">
            {enlaces.map((item) => (
              <NavLink
                key={item.to}
                to={item.to}
                end={item.end}
                onClick={() => setMenuMovilAbierto(false)}
                className={({ isActive }) =>
                  clsx(
                    "font-[var(--fuente-titulo)] font-black text-[length:var(--text-h1-movil)] no-underline",
                    esEnlaceActivo(item, isActive)
                      ? "border-b-2 border-[color:var(--riel)] text-[color:var(--tinta)]"
                      : "text-[color:var(--tinta)] hover:text-[color:var(--riel)]"
                  )
                }
              >
                {item.etiqueta}
              </NavLink>
            ))}
          </nav>

          <div className="flex flex-col items-center gap-[var(--espacio-12)] border-t border-[color:var(--divisor)] pt-[var(--espacio-16)]">
            {user && <p className="voz-etiqueta text-[color:var(--tinta-suave)]">{user.rol}</p>}
            <button
              type="button"
              onClick={cerrarSesion}
              className="bg-transparent border-0 border-b border-[color:var(--borde-terciario)] pb-[var(--espacio-4)] font-[var(--fuente-texto)] font-semibold text-[length:var(--text-cuerpo)] text-[color:var(--tinta)] cursor-pointer"
            >
              Cerrar sesión
            </button>
          </div>
        </div>
      )}

      {/* Contenido principal (contenedor de 1200px) */}
      <div className="relative z-10 min-[1024px]:pl-[var(--sidebar-ancho)]">
        <div className="mx-auto w-full max-w-[var(--contenedor-panel)] px-[var(--espacio-16)] py-[var(--espacio-32)] min-[600px]:px-[var(--espacio-24)] min-[1024px]:px-[var(--espacio-48)] min-[1024px]:py-[var(--espacio-48)]">
          <div className="flex flex-wrap items-end justify-between gap-[var(--espacio-24)] border-b border-[color:var(--divisor)] pb-[var(--espacio-24)]">
            <div className="flex flex-col gap-[var(--espacio-8)]">
              <Breadcrumbs items={migasFinales} />
              <h1 className="voz-h1 text-[color:var(--tinta)]">{titulo}</h1>
              {descripcion && (
                <p className="voz-cuerpo-pequeno text-[color:var(--tinta-suave)]">{descripcion}</p>
              )}
            </div>
            {acciones && (
              <div className="flex flex-wrap items-center gap-[var(--espacio-12)]">{acciones}</div>
            )}
          </div>

          <div className="mt-[var(--espacio-32)]">{children}</div>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/components/motion/TarjetaExpandible.tsx">
"use client";

import { useEffect, useId, useRef, useState } from "react";
import { createPortal } from "react-dom";
import { AnimatePresence, motion, useReducedMotion } from "framer-motion";

const MUELLE = { type: "spring" as const, stiffness: 300, damping: 25 };
const SIN_MOVIMIENTO = { duration: 0 };

export interface PiezaTarjeta {
  id: string;
  titulo: string;
  tecnica: string;
  imagen: string;
  imagenAlt: string;
  artista: string;
  precio: string;
  anio: string;
  descripcion: string;
}

export function TarjetaExpandible({ pieza }: { pieza: PiezaTarjeta }) {
  const [abierta, setAbierta] = useState(false);
  const [portalListo, setPortalListo] = useState(false);
  const reducirMovimiento = useReducedMotion();
  const transicion = reducirMovimiento ? SIN_MOVIMIENTO : MUELLE;
  const tituloId = useId();
  const cerrarRef = useRef<HTMLButtonElement>(null);
  const marco = `marco-${pieza.id}`;
  const imagen = `imagen-${pieza.id}`;
  const badge = `badge-${pieza.id}`;
  const titulo = `titulo-${pieza.id}`;

  useEffect(() => {
    setPortalListo(true);
  }, []);

  useEffect(() => {
    if (!abierta) return;

    const alPulsarTecla = (evento: KeyboardEvent) => {
      if (evento.key === "Escape") setAbierta(false);
    };

    const overflowAnterior = document.body.style.overflow;
    document.body.style.overflow = "hidden";
    window.addEventListener("keydown", alPulsarTecla);
    cerrarRef.current?.focus();

    return () => {
      document.body.style.overflow = overflowAnterior;
      window.removeEventListener("keydown", alPulsarTecla);
    };
  }, [abierta]);

  const cerrar = () => setAbierta(false);

  const dialogo = (
    <AnimatePresence>
      {abierta && (
        <motion.div key="capa" className="fixed inset-0 z-50" role="presentation">
          <motion.button
            type="button"
            aria-label="Cerrar detalles"
            className="absolute inset-0 bg-[color:var(--velo-modal)] border-0 cursor-pointer"
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0 }}
            transition={reducirMovimiento ? SIN_MOVIMIENTO : { duration: 0.2 }}
            onClick={cerrar}
          />

          <div className="pointer-events-none absolute inset-0 flex items-center justify-center p-[var(--espacio-16)] sm:p-[var(--espacio-32)]">
            <motion.article
              layoutId={marco}
              transition={transicion}
              exit={{ opacity: 1, transition: transicion }}
              role="dialog"
              aria-modal="true"
              aria-labelledby={tituloId}
              className="pointer-events-auto grid max-h-[min(40rem,100%)] w-full max-w-3xl grid-cols-1 overflow-hidden border border-[color:var(--borde-reposo)] bg-[color:var(--fondo)] shadow-[var(--sombra-tarjeta)] sm:grid-cols-[0.9fr_1.1fr]"
            >
              <div className="flex items-center justify-center bg-[color:var(--vacio)] p-[var(--espacio-16)]">
                <motion.img
                  layoutId={imagen}
                  src={pieza.imagen}
                  alt={pieza.imagenAlt}
                  transition={transicion}
                  className="max-h-64 w-full object-contain sm:max-h-full"
                />
              </div>

              <div className="flex min-h-0 flex-col p-[var(--espacio-24)] sm:p-[var(--espacio-32)]">
                <div className="flex items-start justify-between gap-[var(--espacio-16)]">
                  <motion.p
                    layoutId={badge}
                    transition={transicion}
                    className="voz-etiqueta text-[color:var(--riel)]"
                  >
                    {pieza.tecnica}
                  </motion.p>
                  <button
                    ref={cerrarRef}
                    type="button"
                    onClick={cerrar}
                    className="enlace-acceso shrink-0 bg-transparent border-0 text-[length:var(--text-cuerpo-pequeno)] cursor-pointer"
                  >
                    Cerrar
                  </button>
                </div>

                <motion.h2
                  layoutId={titulo}
                  id={tituloId}
                  transition={transicion}
                  className="voz-h2 mt-[var(--espacio-12)] text-[color:var(--tinta)]"
                >
                  {pieza.titulo}
                </motion.h2>

                <motion.div
                  initial={reducirMovimiento ? false : { opacity: 0, y: 10 }}
                  animate={{ opacity: 1, y: 0 }}
                  exit={{ opacity: 0 }}
                  transition={reducirMovimiento ? SIN_MOVIMIENTO : { ...MUELLE, delay: 0.06 }}
                >
                  <p className="voz-cursiva mt-[var(--espacio-12)] text-[color:var(--tinta-suave)]">
                    {pieza.artista} · {pieza.anio}
                  </p>
                  <p className="voz-cuerpo mt-[var(--espacio-16)] text-[color:var(--tinta-suave)]">
                    {pieza.descripcion}
                  </p>
                  <p className="precio-obra mt-[var(--espacio-24)] font-[var(--fuente-texto)] text-[length:var(--text-h3)] font-semibold text-[color:var(--tinta)]">
                    {pieza.precio}
                  </p>
                </motion.div>
              </div>
            </motion.article>
          </div>
        </motion.div>
      )}
    </AnimatePresence>
  );

  return (
    <div className="w-full max-w-sm">
      {abierta ? (
        <div className="invisible" aria-hidden>
          <div className="aspect-[4/5] w-full" />
        </div>
      ) : (
        <motion.button
          type="button"
          layoutId={marco}
          transition={transicion}
          onClick={() => setAbierta(true)}
          aria-haspopup="dialog"
          aria-expanded={false}
          aria-label={`Ver detalles de ${pieza.titulo}`}
          whileHover={reducirMovimiento ? undefined : { y: -4 }}
          whileTap={reducirMovimiento ? undefined : { scale: 0.98 }}
          className="group block w-full overflow-hidden border border-[color:var(--borde-reposo)] bg-[color:var(--fondo)] text-left shadow-[var(--sombra-tarjeta)] hover:border-[color:var(--borde-hover)] cursor-pointer"
        >
          <div className="flex aspect-[4/5] w-full items-center justify-center bg-[color:var(--vacio)] p-[var(--espacio-12)]">
            <motion.img
              layoutId={imagen}
              src={pieza.imagen}
              alt={pieza.imagenAlt}
              transition={transicion}
              className="h-full w-full object-contain"
            />
          </div>
          <div className="flex items-end justify-between gap-[var(--espacio-16)] border-t border-[color:var(--divisor)] p-[var(--espacio-24)]">
            <div>
              <motion.p
                layoutId={badge}
                transition={transicion}
                className="voz-etiqueta text-[color:var(--riel)]"
              >
                {pieza.tecnica}
              </motion.p>
              <motion.h3
                layoutId={titulo}
                transition={transicion}
                className="voz-h3 mt-[var(--espacio-4)] text-[color:var(--tinta)]"
              >
                {pieza.titulo}
              </motion.h3>
            </div>
            <span className="voz-etiqueta shrink-0 border border-[color:var(--borde-reposo)] px-[var(--espacio-12)] py-[var(--espacio-8)] text-[color:var(--tinta)]">
              Ver obra
            </span>
          </div>
        </motion.button>
      )}

      {portalListo ? createPortal(dialogo, document.body) : null}
    </div>
  );
}
</file>

<file path="src/components/ui/ArtistaCard.tsx">
import { Link } from "react-router-dom";
import { Star } from "lucide-react";

export interface ArtistaCardProps {
  idArtista: number | string;
  nombre: string;
  disciplina: string;
  obrasPublicadas: number;
  fotoUrl?: string;
  href?: string;
  promedioEstrellas?: number;
  totalResenas?: number;
  comentarioDestacado?: string;
  salaPalacio?: string;
}

/**
 * Tarjeta de artista enriquecida con retrato/obra representativa, nombre,
 * disciplina, calificación promedio con estrellas doradas, conteo de reseñas
 * y extracto de reseña destacada.
 */
export function ArtistaCard({
  idArtista,
  nombre,
  disciplina,
  obrasPublicadas,
  fotoUrl,
  href,
  promedioEstrellas = 5.0,
  totalResenas = 2,
  comentarioDestacado,
  salaPalacio,
}: ArtistaCardProps) {
  const destino = href ?? `/artistas/${idArtista}`;
  const iniciales = nombre
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((p) => p[0]?.toUpperCase() ?? "")
    .join("");

  const estrellasRedondeadas = Math.round(promedioEstrellas);

  return (
    <Link
      to={destino}
      className="group flex flex-col rounded-[var(--catalog-radius)] border border-[color:var(--borde-reposo)] bg-[color:var(--superficie-elevada)] no-underline shadow-[var(--sombra-tarjeta)] transition-all duration-[var(--duracion-hover)] ease-[var(--curva-base)] hover:-translate-y-1 hover:border-[color:var(--borde-hover)]"
    >
      <div className="relative aspect-square w-full overflow-hidden rounded-t-[var(--catalog-radius)] border-b border-[color:var(--borde-reposo)] bg-[color:var(--vacio)]">
        {fotoUrl ? (
          <img
            src={fotoUrl}
            alt={`Obra representativa de ${nombre}, ${disciplina}`}
            loading="lazy"
            className="block h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
          />
        ) : (
          <div
            aria-hidden="true"
            className="grid h-full w-full place-items-center"
            style={{
              background:
                "radial-gradient(circle at 50% 50%, var(--vacio) 0 32%, transparent 33%), linear-gradient(180deg, var(--profundidad), var(--carmesi))",
            }}
          >
            <span className="voz-etiqueta text-[length:var(--text-h2)] text-[color:var(--tinta)]">
              {iniciales || "A"}
            </span>
          </div>
        )}

        {/* Insignia flotante de calificación con estrellas en la esquina superior derecha */}
        <div className="absolute top-3 right-3 inline-flex items-center gap-1.5 rounded-[var(--radio-pildora)] border border-[color:var(--riel)] bg-[#181614]/90 px-3 py-1 backdrop-blur-xs shadow-md">
          <Star size={14} className="fill-[#e6b050] text-[#e6b050]" aria-hidden="true" />
          <span className="font-[var(--fuente-texto)] text-[0.92rem] font-bold text-[color:var(--tinta)]">
            {promedioEstrellas.toFixed(1)}
          </span>
          <span className="font-[var(--fuente-texto)] text-[0.82rem] text-[color:var(--tinta-suave)]">
            ({totalResenas})
          </span>
        </div>

        {salaPalacio && (
          <div className="absolute bottom-2.5 left-2.5 rounded-xs border border-[color:var(--borde-reposo)] bg-[#181614]/88 px-2.5 py-0.5 font-[var(--fuente-poster)] text-[0.72rem] uppercase tracking-[0.1em] text-[color:var(--riel)]">
            {salaPalacio}
          </div>
        )}
      </div>

      <div className="flex flex-1 flex-col justify-between gap-[var(--espacio-12)] p-[var(--espacio-16)] sm:p-[var(--espacio-24)]">
        <div>
          <h3 className="voz-h3 line-clamp-2 text-[color:var(--tinta)] group-hover:text-[color:var(--riel)] transition-colors">
            {nombre}
          </h3>
          <p className="voz-cursiva mt-[var(--espacio-4)] text-[color:var(--tinta-suave)]">
            {disciplina}
          </p>

          {/* Fila de 5 estrellas con conteo de reseñas */}
          <div className="mt-2.5 flex items-center gap-2">
            <div className="flex items-center gap-0.5" aria-label={`Calificación: ${promedioEstrellas} de 5 estrellas`}>
              {[1, 2, 3, 4, 5].map((n) => (
                <Star
                  key={n}
                  size={15}
                  className={
                    n <= estrellasRedondeadas
                      ? "fill-[#e6b050] text-[#e6b050]"
                      : "fill-transparent text-[color:var(--tinta-suave)]/45"
                  }
                />
              ))}
            </div>
            <span className="font-[var(--fuente-texto)] text-[0.92rem] text-[color:var(--tinta-suave)]">
              {totalResenas} {totalResenas === 1 ? "reseña" : "reseñas"}
            </span>
          </div>

          {comentarioDestacado && (
            <p className="mt-3 line-clamp-2 border-l-2 border-[color:var(--riel)]/60 pl-2.5 font-[var(--fuente-texto)] text-[0.95rem] italic text-[color:var(--tinta-suave)]">
              “{comentarioDestacado}”
            </p>
          )}
        </div>

        <div className="flex items-center justify-between border-t border-[color:var(--divisor)] pt-3">
          <span className="voz-cuerpo-pequeno text-[color:var(--tinta-suave)]">
            {obrasPublicadas} {obrasPublicadas === 1 ? "obra publicada" : "obras publicadas"}
          </span>
          <span className="font-[var(--fuente-texto)] text-[0.95rem] font-semibold text-[color:var(--riel)] group-hover:underline">
            Ver obras y reseñas →
          </span>
        </div>
      </div>
    </Link>
  );
}
</file>

<file path="src/components/ui/Badge.tsx">
import clsx from "clsx";
import {
  AlertTriangle,
  Archive,
  Check,
  Clock,
  FileEdit,
  RotateCcw,
  ShoppingBag,
  type LucideIcon,
} from "lucide-react";
import type { EstadoObra, EstadoPago, EstadoValidacion } from "../../types";

export type EstadoGuia =
  | "Borrador"
  | "En revisión"
  | "Requiere cambios"
  | "Publicada"
  | "Vendida"
  | "Retirada"
  | "Pago pendiente"
  | "Pago aprobado"
  | "Pago rechazado"
  | "Reembolsado";

interface ConfigEstado {
  etiqueta: string;
  icono: LucideIcon;
  clases: string;
}

const ESTILOS_GUIA: Record<EstadoGuia, ConfigEstado> = {
  Borrador: {
    etiqueta: "Borrador",
    icono: FileEdit,
    clases: "border-[color:var(--tinta-suave)] text-[color:var(--tinta-suave)] bg-transparent",
  },
  "En revisión": {
    etiqueta: "En revisión",
    icono: Clock,
    clases: "border-[color:var(--riel)] text-[color:var(--tinta)] bg-transparent",
  },
  "Requiere cambios": {
    etiqueta: "Requiere cambios",
    icono: AlertTriangle,
    clases: "border-[color:var(--aviso)] text-[color:var(--aviso)] bg-transparent",
  },
  Publicada: {
    etiqueta: "Publicada",
    icono: Check,
    clases: "border-[color:var(--exito)] text-[color:var(--exito)] bg-transparent",
  },
  Vendida: {
    etiqueta: "Vendida",
    icono: ShoppingBag,
    clases: "border-[color:var(--carmesi)] bg-[color:var(--carmesi)] text-[color:var(--tinta-inversa)]",
  },
  Retirada: {
    etiqueta: "Retirada",
    icono: Archive,
    clases: "border-[color:var(--tinta-suave)] text-[color:var(--tinta-suave)] bg-transparent",
  },
  "Pago pendiente": {
    etiqueta: "Pago pendiente",
    icono: Clock,
    clases: "border-[color:var(--riel)] text-[color:var(--tinta)] bg-transparent",
  },
  "Pago aprobado": {
    etiqueta: "Pago aprobado",
    icono: Check,
    clases: "border-[color:var(--exito)] text-[color:var(--exito)] bg-transparent",
  },
  "Pago rechazado": {
    etiqueta: "Pago rechazado",
    icono: AlertTriangle,
    clases: "border-[color:var(--aviso)] text-[color:var(--aviso)] bg-transparent",
  },
  Reembolsado: {
    etiqueta: "Reembolsado",
    icono: RotateCcw,
    clases: "border-[color:var(--tinta-suave)] text-[color:var(--tinta-suave)] bg-transparent",
  },
};

function mapearEstadoObra(estado: EstadoObra | EstadoGuia): ConfigEstado {
  if (estado in ESTILOS_GUIA) return ESTILOS_GUIA[estado as EstadoGuia];
  switch (estado) {
    case "Publicado":
      return ESTILOS_GUIA.Publicada;
    case "Pendiente":
    case "Reservado":
      return ESTILOS_GUIA["En revisión"];
    case "Vendido":
      return ESTILOS_GUIA.Vendida;
    case "En Préstamo":
      return ESTILOS_GUIA.Retirada;
    case "Mantenimiento":
    default:
      return ESTILOS_GUIA["Requiere cambios"];
  }
}

function mapearEstadoPago(estado: EstadoPago | EstadoGuia): ConfigEstado {
  if (estado in ESTILOS_GUIA) return ESTILOS_GUIA[estado as EstadoGuia];
  switch (estado) {
    case "Procesando":
      return ESTILOS_GUIA["Pago pendiente"];
    case "Confirmado":
    case "Dispersado":
      return ESTILOS_GUIA["Pago aprobado"];
    case "Rechazado":
      return ESTILOS_GUIA["Pago rechazado"];
    case "Reembolsado":
    default:
      return ESTILOS_GUIA.Reembolsado;
  }
}

function mapearEstadoValidacion(estado: EstadoValidacion): ConfigEstado {
  switch (estado) {
    case "Verificado":
      return {
        etiqueta: "Verificado",
        icono: Check,
        clases: "border-[color:var(--exito)] text-[color:var(--exito)] bg-transparent",
      };
    case "Pendiente":
      return ESTILOS_GUIA["En revisión"];
    case "Rechazado":
      return ESTILOS_GUIA["Requiere cambios"];
  }
}

/**
 * 4.7 Estados (etiquetas):
 * Rectángulo de 28 px de alto, esquinas rectas, Anton de 1 rem en mayúsculas,
 * borde de 1 px, icono de 16 px a la izquierda.
 */
export function EtiquetaEstado({
  config,
  textoPersonalizado,
  className,
}: {
  config: ConfigEstado;
  textoPersonalizado?: string;
  className?: string;
}) {
  const Icono = config.icono;
  return (
    <span
      className={clsx(
        "inline-flex h-[var(--alto-estado)] items-center gap-[var(--espacio-8)] rounded-[var(--radio-recto)] border px-[var(--espacio-8)] font-[var(--fuente-poster)] text-[length:var(--text-etiqueta)] uppercase tracking-[0.12em] leading-none whitespace-nowrap",
        config.clases,
        className
      )}
    >
      <Icono size={16} strokeWidth={1.5} className="shrink-0" aria-hidden="true" />
      <span>{textoPersonalizado ?? config.etiqueta}</span>
    </span>
  );
}

export function BadgeEstado({ estado, className }: { estado: EstadoGuia; className?: string }) {
  return <EtiquetaEstado config={ESTILOS_GUIA[estado]} className={className} />;
}

export function BadgeEstadoObra({ estado, className }: { estado: EstadoObra | EstadoGuia; className?: string }) {
  return <EtiquetaEstado config={mapearEstadoObra(estado)} className={className} />;
}

export function BadgeEstadoPago({ estado, className }: { estado: EstadoPago | EstadoGuia; className?: string }) {
  return <EtiquetaEstado config={mapearEstadoPago(estado)} className={className} />;
}

export function BadgeEstadoValidacion({ estado, className }: { estado: EstadoValidacion; className?: string }) {
  return <EtiquetaEstado config={mapearEstadoValidacion(estado)} className={className} />;
}
</file>

