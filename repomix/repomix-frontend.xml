import { useEffect, useRef, useState } from "react";
import { Link, useNavigate } from "react-router-dom";
import { Box, ChevronLeft, ChevronRight, Share2, ShieldCheck, ShoppingBag, X } from "lucide-react";
import { useCart } from "../../context/CartContext";
import {
  calcularDimensionesObra,
  obtenerSlugObra,
} from "../ObraCard";
import {
  esObraMuestraLocal,
  resolverNombreArtistaObra,
  resolverUrlImagenObra,
} from "../../lib/obrasMuestraPalacio";
import { Button } from "../ui/Button";
import { BadgeEstado } from "../ui/Badge";
import { formatearMoneda } from "../../lib/formato";
import { ObraVisor3DModal } from "./ObraVisor3DModal";
import type { Obra } from "../../types";

export interface ObraLightboxProps {
  obra: Obra | null;
  nombreArtista?: string;
  indiceActual: number;
  totalObras: number;
  onClose: () => void;
  onPrev: () => void;
  onNext: () => void;
  triggerRef?: React.RefObject<HTMLElement | null>;
}

/**
 * Lightbox interactivo del catálogo con sincronización de URL (?obra=<slug>):
 * - Backdrop rgba(0, 0, 0, 0.8)
 * - Imagen centrada sin recortar (object-fit: contain)
 * - Panel lateral en desktop / inferior en móvil con título, artista, técnica, dimensiones, precio y CTA píldora
 * - Accesibilidad WAI-ARIA: role="dialog", aria-modal="true", trampa de foco, cierre con Esc/backdrop,
 *   navegación con ArrowLeft / ArrowRight y bloqueo del scroll de fondo.
 */
export function ObraLightbox({
  obra,
  nombreArtista,
  indiceActual,
  totalObras,
  onClose,
  onPrev,
  onNext,
  triggerRef,
}: ObraLightboxProps) {
  const navigate = useNavigate();
  const { agregarObra, abrirCarrito, estaEnCarrito } = useCart();
  const dialogRef = useRef<HTMLDivElement>(null);
  const closeBtnRef = useRef<HTMLButtonElement>(null);

  const [errorImagen, setErrorImagen] = useState(false);
  const [imagenCargada, setImagenCargada] = useState(false);
  const [enlaceCopiado, setEnlaceCopiado] = useState(false);
  const [visor3DAbierto, setVisor3DAbierto] = useState(false);

  // Reiniciar estados visuales cuando cambia la obra activa en el Lightbox
  useEffect(() => {
    setErrorImagen(false);
    setImagenCargada(false);
    setEnlaceCopiado(false);
  }, [obra?.id_obra]);

  // Bloqueo de scroll del body y gestión del foco inicial + restauración al cerrar
  useEffect(() => {
    if (!obra) return;

    const overflowPrevio = document.body.style.overflow;
    document.body.style.overflow = "hidden";

    const focoPrevio =
      triggerRef?.current ??
      (document.activeElement instanceof HTMLElement ? document.activeElement : null);

    const timerFoco = window.setTimeout(() => {
      closeBtnRef.current?.focus();
    }, 20);

    return () => {
      window.clearTimeout(timerFoco);
      document.body.style.overflow = overflowPrevio;
      if (focoPrevio && typeof focoPrevio.focus === "function") {
        focoPrevio.focus();
      }
    };
  }, [Boolean(obra), triggerRef]);

  // Teclado: Esc para cerrar, ArrowLeft / ArrowRight para navegar, Tab para trampa de foco
  useEffect(() => {
    if (!obra) return;

    const manejarTeclado = (e: KeyboardEvent) => {
      if (e.key === "Escape") {
        e.preventDefault();
        onClose();
        return;
      }

      if (e.key === "ArrowLeft" && totalObras > 1) {
        e.preventDefault();
        onPrev();
        return;
      }

      if (e.key === "ArrowRight" && totalObras > 1) {
        e.preventDefault();
        onNext();
        return;
      }

      if (e.key === "Tab" && dialogRef.current) {
        const focusables = Array.from(
          dialogRef.current.querySelectorAll<HTMLElement>(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
          )
        );
        if (focusables.length === 0) return;
        const primero = focusables[0];
        const ultimo = focusables[focusables.length - 1];

        if (e.shiftKey && document.activeElement === primero) {
          e.preventDefault();
          ultimo.focus();
        } else if (!e.shiftKey && document.activeElement === ultimo) {
          e.preventDefault();
          primero.focus();
        }
      }
    };

    window.addEventListener("keydown", manejarTeclado);
    return () => window.removeEventListener("keydown", manejarTeclado);
  }, [obra, totalObras, onClose, onPrev, onNext]);

  if (!obra) return null;

  const artistaTexto = resolverNombreArtistaObra(obra, nombreArtista);
  const vendida = obra.estado_obra === "Vendido";
  const { width, height } = calcularDimensionesObra(obra);
  const slug = obtenerSlugObra(obra);
  const usarLienzoMuestra = esObraMuestraLocal(obra);

  const copiarEnlaceCompartible = async () => {
    try {
      const url = new URL(window.location.href);
      url.searchParams.set("obra", slug);
      await navigator.clipboard.writeText(url.toString());
      setEnlaceCopiado(true);
      window.setTimeout(() => setEnlaceCopiado(false), 2400);
    } catch {
      setEnlaceCopiado(false);
    }
  };

  return (
    <div
      role="dialog"
      aria-modal="true"
      aria-labelledby="lightbox-obra-titulo"
      aria-describedby="lightbox-obra-ficha"
      onClick={(e) => {
        if (e.target === e.currentTarget) {
          onClose();
        }
      }}
      className="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6"
      style={{ backgroundColor: "rgba(0, 0, 0, 0.8)" }}
    >
      <div
        ref={dialogRef}
        className="relative flex max-h-[92vh] w-[min(calc(100vw-24px),1160px)] flex-col overflow-hidden border border-[color:var(--borde-reposo)] bg-[color:var(--superficie-elevada)] shadow-[var(--sombra-modal)] min-[960px]:h-[min(86vh,780px)] min-[960px]:flex-row"
        style={{ borderRadius: "var(--catalog-radius)" }}
      >
        {/* Barra superior flotante con contador y botón de cierre */}
        <div className="absolute top-3 right-3 z-20 flex items-center gap-2">
          {totalObras > 1 && (
            <span
              aria-live="polite"
              className="border border-[color:var(--borde-reposo)] bg-[color:var(--superficie-elevada)]/95 px-3 py-1.5 font-[var(--fuente-texto)] text-[0.9rem] text-[color:var(--tinta-suave)]"
            >
              {indiceActual + 1} / {totalObras}
            </span>
          )}
          <button
            ref={closeBtnRef}
            type="button"
            onClick={onClose}
            aria-label="Cerrar vista ampliada (Esc)"
            className="inline-grid h-11 w-11 place-items-center border border-[color:var(--borde-reposo)] bg-[color:var(--superficie-elevada)]/95 text-[color:var(--tinta)] transition-colors duration-200 hover:border-[color:var(--carmesi)] hover:text-[color:var(--carmesi)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--carmesi)] cursor-pointer"
          >
            <X size={22} strokeWidth={1.5} aria-hidden="true" />
          </button>
        </div>

        {/* Escenario de imagen centrada sin recortar (object-fit: contain) */}
        <div
          className="relative flex min-h-[280px] flex-1 items-center justify-center overflow-hidden bg-[color:var(--vacio)] p-4 sm:p-8 min-[960px]:h-full"
        >
          {totalObras > 1 && (
            <button
              type="button"
              onClick={onPrev}
              aria-label="Obra anterior (Flecha izquierda)"
              className="absolute left-3 top-1/2 z-10 inline-grid h-11 w-11 -translate-y-1/2 place-items-center border border-[color:var(--borde-reposo)] bg-[color:var(--superficie-elevada)]/90 text-[color:var(--tinta)] transition-colors duration-200 hover:border-[color:var(--carmesi)] hover:text-[color:var(--carmesi)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--carmesi)] cursor-pointer"
            >
              <ChevronLeft size={22} strokeWidth={1.5} aria-hidden="true" />
            </button>
          )}

          {!usarLienzoMuestra && !imagenCargada && !errorImagen && obra.fotografia_hd_url && (
            <div
              aria-hidden="true"
              className="esqueleto-pulso h-[65%] w-[65%] max-w-[460px]"
            />
          )}

          {!usarLienzoMuestra && !errorImagen && obra.fotografia_hd_url ? (
            <img
              src={resolverUrlImagenObra(obra, false)}
              alt={`${obra.titulo} — ${artistaTexto} (${obra.tecnica})`}
              width={width}
              height={height}
              decoding="async"
              onLoad={() => setImagenCargada(true)}
              onError={() => setErrorImagen(true)}
              className="max-h-[48vh] w-auto max-w-full object-contain transition-opacity duration-300 min-[960px]:max-h-[calc(86vh-64px)]"
              style={{ opacity: imagenCargada ? 1 : 0 }}
            />
          ) : (
            <img
              src={resolverUrlImagenObra(obra, true)}
              alt={`${obra.titulo} — ${artistaTexto} (${obra.tecnica})`}
              width={width}
              height={height}
              decoding="async"
              className="max-h-[48vh] w-auto max-w-full rounded-[var(--catalog-radius)] object-contain shadow-2xl min-[960px]:max-h-[calc(86vh-64px)]"
            />
          )}

          {totalObras > 1 && (
            <button
              type="button"
              onClick={onNext}
              aria-label="Obra siguiente (Flecha derecha)"
              className="absolute right-3 top-1/2 z-10 inline-grid h-11 w-11 -translate-y-1/2 place-items-center border border-[color:var(--borde-reposo)] bg-[color:var(--superficie-elevada)]/90 text-[color:var(--tinta)] transition-colors duration-200 hover:border-[color:var(--carmesi)] hover:text-[color:var(--carmesi)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--carmesi)] cursor-pointer"
            >
              <ChevronRight size={22} strokeWidth={1.5} aria-hidden="true" />
            </button>
          )}
        </div>

        {/* Panel lateral en desktop / panel inferior en móvil */}
        <aside
          id="lightbox-obra-ficha"
          className="flex w-full flex-col justify-between gap-6 overflow-y-auto border-t border-[color:var(--divisor)] bg-[color:var(--superficie-elevada)] p-6 sm:p-8 min-[960px]:w-[380px] min-[960px]:shrink-0 min-[960px]:border-t-0 min-[960px]:border-l"
        >
          <div className="flex flex-col gap-4">
            <div className="flex flex-wrap items-center gap-2">
              <span className="voz-etiqueta text-[color:var(--riel)]">Ficha curatorial</span>
              {obra.es_patrimonio_historico && (
                <span className="border border-[color:var(--borde-reposo)] bg-[color:var(--vacio)] px-2.5 py-0.5 font-[var(--fuente-texto)] text-[0.8rem] text-[color:var(--tinta)]">
                  Patrimonio Histórico
                </span>
              )}
              {vendida && <BadgeEstado estado="Vendida" />}
            </div>

            <div>
              <h2
                id="lightbox-obra-titulo"
                className="font-[var(--fuente-titulo)] text-[1.65rem] font-black leading-[1.12] text-[color:var(--tinta)]"
              >
                {obra.titulo}
              </h2>
              <p className="mt-1.5 font-[var(--fuente-texto)] text-[1.15rem] text-[color:var(--tinta-suave)]">
                <Link
                  to={`/artistas/${obra.id_artista}`}
                  onClick={onClose}
                  className="underline decoration-[color:var(--riel)] underline-offset-4 transition-colors hover:text-[color:var(--carmesi)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[color:var(--carmesi)]"
                >
                  {artistaTexto}
                </Link>
              </p>
            </div>

            <div
              aria-hidden="true"
              className="h-[1px] w-full bg-[color:var(--divisor)]"
            />

            <dl className="grid grid-cols-1 gap-3 font-[var(--fuente-texto)] text-[1rem]">
              <div className="flex items-baseline justify-between gap-4">
                <dt className="text-[color:var(--tinta-suave)]">Técnica</dt>
                <dd className="text-right font-medium text-[color:var(--tinta)]">{obra.tecnica}</dd>
              </div>

              {obra.dimensiones && (
                <div className="flex items-baseline justify-between gap-4">
                  <dt className="text-[color:var(--tinta-suave)]">Dimensiones</dt>
                  <dd className="text-right font-medium text-[color:var(--tinta)]">{obra.dimensiones}</dd>
                </div>
              )}

              {obra.anio_creacion && (
                <div className="flex items-baseline justify-between gap-4">
                  <dt className="text-[color:var(--tinta-suave)]">Año</dt>
                  <dd className="text-right font-medium text-[color:var(--tinta)]">{obra.anio_creacion}</dd>
                </div>
              )}

              <div className="flex items-baseline justify-between gap-4">
                <dt className="text-[color:var(--tinta-suave)]">Certificado QR</dt>
                <dd className="codigo-certificado text-right text-[0.88rem] text-[color:var(--tinta-suave)]">
                  {obra.uid.slice(0, 13).toUpperCase()}
                </dd>
              </div>
            </dl>

            <div
              aria-hidden="true"
              className="h-[1px] w-full bg-[color:var(--divisor)]"
            />

            <div className="flex items-baseline justify-between gap-4">
              <span className="font-[var(--fuente-texto)] text-[1rem] text-[color:var(--tinta-suave)]">
                {vendida ? "Estado" : "Valor de adquisición"}
              </span>
              <span className="voz-dato text-[1.45rem] text-[color:var(--tinta)]">
                {vendida ? "Adquirida" : formatearMoneda(obra.precio_venta)}
              </span>
            </div>
          </div>

          {/* Acciones con botones principales en estilo píldora */}
          <div className="flex flex-col gap-3 pt-2">
            <Button
              type="button"
              variante="primario"
              onClick={() => navigate(`/obras/${obra.id_obra}`)}
              className="w-full"
            >
              {vendida ? "Ver ficha y certificado" : "Adquirir / Ver ficha completa"}
            </Button>

            <Button
              type="button"
              variante="secundario"
              onClick={() => setVisor3DAbierto(true)}
              className="w-full"
            >
              <Box size={17} strokeWidth={1.6} aria-hidden="true" />
              <span>Ver en 3D y escala real</span>
            </Button>

            {!vendida && obra.estado_obra === "Publicado" && (
              <Button
                type="button"
                variante="secundario"
                onClick={() => {
                  if (!estaEnCarrito(obra.id_obra)) {
                    agregarObra(obra);
                  }
                  onClose();
                  abrirCarrito();
                }}
                className="w-full"
              >
                <ShoppingBag size={17} strokeWidth={1.6} aria-hidden="true" />
                <span>{estaEnCarrito(obra.id_obra) ? "Ver en el carrito" : "Agregar al carrito"}</span>
              </Button>
            )}

            <div className="flex items-center gap-2">
              <Button
                type="button"
                variante="secundario"
                onClick={() => navigate(`/verificar/${obra.uid}`)}
                className="flex-1 text-[0.95rem]"
              >
                <ShieldCheck size={17} strokeWidth={1.5} aria-hidden="true" />
                <span>Certificado</span>
              </Button>

              <Button
                type="button"
                variante="secundario"
                onClick={() => {
                  void copiarEnlaceCompartible();
                }}
                className="flex-1 text-[0.95rem]"
              >
                <Share2 size={17} strokeWidth={1.5} aria-hidden="true" />
                <span>{enlaceCopiado ? "Copiado" : "Compartir"}</span>
              </Button>
            </div>
          </div>
        </aside>
      </div>
      <ObraVisor3DModal
        obra={obra}
        nombreArtista={artistaTexto}
        abierto={visor3DAbierto}
        onCerrar={() => setVisor3DAbierto(false)}
      />
    </div>
  );
}
</file>

<file path="src/components/catalogo/ObraVisor3DModal.tsx">
import { useCallback, useEffect, useMemo, useRef, useState, type PointerEvent as ReactPointerEvent, type WheelEvent as ReactWheelEvent } from "react";
import { ChevronDown, ChevronLeft, ChevronRight, ChevronUp, X, ZoomIn, ZoomOut } from "lucide-react";
import type { Obra } from "../../types";
import { resolverNombreArtistaObra, resolverUrlImagenObra } from "../../lib/obrasMuestraPalacio";

export interface ObraVisor3DModalProps {
  obra: Obra | null;
  nombreArtista?: string;
  abierto: boolean;
  onCerrar: () => void;
}

/**
 * Extrae el ancho y alto reales en centímetros desde `obra.dimensiones` (ej. "73.7 x 92.1 cm" o "120 x 140 cm").
 * Si no viene o el formato varía, usa 90 x 100 cm por defecto.
 */
function parsearDimensionesCm(dimensiones: string | undefined): { anchoCm: number; altoCm: number } {
  if (!dimensiones) return { anchoCm: 95, altoCm: 95 };
  const match = dimensiones.match(/(\d+(?:[.,]\d+)?)\s*[x×X*]\s*(\d+(?:[.,]\d+)?)/);
  if (!match) return { anchoCm: 95, altoCm: 95 };
  const v1 = parseFloat(match[1].replace(",", "."));
  const v2 = parseFloat(match[2].replace(",", "."));
  if (!Number.isFinite(v1) || !Number.isFinite(v2) || v1 <= 0 || v2 <= 0) {
    return { anchoCm: 95, altoCm: 95 };
  }
  return {
    anchoCm: Math.min(240, Math.max(30, v1)),
    altoCm: Math.min(220, Math.max(30, v2)),
  };
}

/**
 * Visualizador 3D interactivo estilo SingulArt (conforme a la imagen de referencia):
 * - Modal blanco luminoso con backdrop oscuro translúcido.
 * - Encabezado superior izquierdo: Título de la obra en mayúsculas + Artista en cursiva debajo.
 * - Botón circular superior derecho (X) para cerrar el modal.
 * - Barra superior central semitransparente: "Arrastra para mover • Rueda para zoom • Rota con los controles".
 * - Escenario gris/blanco minimalista (#f3f3f4) con:
 *   1. Silueta humana a escala real (1.75 m / 5'9") a la izquierda del cuadro.
 *   2. Cuadro 3D volumétrico (marco de madera natural tipo roble claro con grosor en 3D, bisel interior,
 *      textura de la obra y sombra proyectada sobre la pared).
 * - Interactividad completa:
 *   - Drag to move (arrastrar con mouse o touch para desplazar la vista).
 *   - Scroll to zoom (rueda del mouse para acercar/alejar).
 *   - Botonera flotante vertical a la derecha: Arriba (^), Izquierda (<), Derecha (>), Abajo (v) para rotar
 *     la perspectiva 3D, Zoom In (+), Zoom Out (-) y botón inferior (X) para restablecer la vista 3D.
 */
export function ObraVisor3DModal({
  obra,
  nombreArtista,
  abierto,
  onCerrar,
}: ObraVisor3DModalProps) {
  // Estados de cámara y transformación 3D (por defecto con leve giro tipo SingulArt: rotateY -14deg)
  const [rotX, setRotX] = useState(2);
  const [rotY, setRotY] = useState(-14);
  const [panX, setPanX] = useState(0);
  const [panY, setPanY] = useState(0);
  const [zoom, setZoom] = useState(1);
  const [arrastrando, setArrastrando] = useState(false);
  const [usarFallbackImg, setUsarFallbackImg] = useState(false);

  const puntoInicioRef = useRef<{ x: number; y: number; panX: number; panY: number } | null>(null);

  const resetearCamara = useCallback(() => {
    setRotX(2);
    setRotY(-14);
    setPanX(0);
    setPanY(0);
    setZoom(1);
  }, []);

  useEffect(() => {
    if (abierto) {
      resetearCamara();
      setUsarFallbackImg(false);
    }
  }, [abierto, obra?.id_obra, resetearCamara]);

  // Cerrar con Escape y bloquear scroll del body
  useEffect(() => {
    if (!abierto) return;
    const prevOverflow = document.body.style.overflow;
    document.body.style.overflow = "hidden";

    const alTeclado = (e: KeyboardEvent) => {
      if (e.key === "Escape") {
        e.preventDefault();
        onCerrar();
      } else if (e.key === "ArrowLeft") {
        setRotY((y) => Math.max(-48, y - 6));
      } else if (e.key === "ArrowRight") {
        setRotY((y) => Math.min(48, y + 6));
      } else if (e.key === "ArrowUp") {
        setRotX((x) => Math.min(32, x + 5));
      } else if (e.key === "ArrowDown") {
        setRotX((x) => Math.max(-32, x - 5));
      } else if (e.key === "+" || e.key === "=") {
        setZoom((z) => Math.min(2.2, Number((z + 0.15).toFixed(2))));
      } else if (e.key === "-") {
        setZoom((z) => Math.max(0.55, Number((z - 0.15).toFixed(2))));
      }
    };

    window.addEventListener("keydown", alTeclado);
    return () => {
      document.body.style.overflow = prevOverflow;
      window.removeEventListener("keydown", alTeclado);
    };
  }, [abierto, onCerrar]);

  const dimensionesFisicas = useMemo(() => {
    const { anchoCm, altoCm } = parsearDimensionesCm(obra?.dimensiones);
    // Escala: 175 cm (persona 5'9" / 1.75 m) = 385 px de altura en escena
    const pxPorCm = 385 / 175;
    // Ajustamos para que cuadros pequeños sigan viéndose con buen detalle y cuadros grandes respeten la proporción con la silueta
    const anchoEscala = Math.round(Math.min(360, Math.max(190, anchoCm * pxPorCm * 1.12)));
    const altoEscala = Math.round(Math.min(360, Math.max(190, altoCm * pxPorCm * 1.12)));
    return {
      anchoCm,
      altoCm,
      anchoPx: anchoEscala,
      altoPx: altoEscala,
    };
  }, [obra?.dimensiones]);

  if (!abierto || !obra) return null;

  const artistaTexto = resolverNombreArtistaObra(obra, nombreArtista);
  const srcPintura = resolverUrlImagenObra(obra, usarFallbackImg);

  // Drag to move (arrastrar para mover la escena)
  const manejarPointerDown = (e: ReactPointerEvent<HTMLDivElement>) => {
    // Evitar arrastrar si hizo clic en la botonera de controles
    if ((e.target as HTMLElement).closest("[data-controles-3d]")) return;
    e.currentTarget.setPointerCapture(e.pointerId);
    setArrastrando(true);
    puntoInicioRef.current = {
      x: e.clientX,
      y: e.clientY,
      panX,
      panY,
    };
  };

  const manejarPointerMove = (e: ReactPointerEvent<HTMLDivElement>) => {
    if (!arrastrando || !puntoInicioRef.current) return;
    const dx = e.clientX - puntoInicioRef.current.x;
    const dy = e.clientY - puntoInicioRef.current.y;
    setPanX(Math.max(-340, Math.min(340, puntoInicioRef.current.panX + dx)));
    setPanY(Math.max(-220, Math.min(220, puntoInicioRef.current.panY + dy)));
  };

  const manejarPointerUp = (e: ReactPointerEvent<HTMLDivElement>) => {
    if (!arrastrando) return;
    if (e.currentTarget.hasPointerCapture(e.pointerId)) {
      e.currentTarget.releasePointerCapture(e.pointerId);
    }
    setArrastrando(false);
    puntoInicioRef.current = null;
  };

  // Scroll to zoom (rueda del mouse)
  const manejarWheel = (e: ReactWheelEvent<HTMLDivElement>) => {
    e.preventDefault();
    const delta = e.deltaY < 0 ? 0.12 : -0.12;
    setZoom((z) => Math.min(2.2, Math.max(0.55, Number((z + delta).toFixed(2)))));
  };

  const grosorMarco = 22; // 22px de profundidad 3D del bastidor/marco de madera

  return (
    <div
      role="dialog"
      aria-modal="true"
      aria-labelledby="visor3d-titulo-obra"
      onClick={(e) => {
        if (e.target === e.currentTarget) onCerrar();
      }}
      className="fixed inset-0 z-50 flex items-center justify-center bg-black/72 p-3 sm:p-6 backdrop-blur-[3px] animate-[aparecer-pagina_240ms_ease_forwards]"
    >
      {/* Contenedor Modal Blanco estilo SingulArt */}
      <div className="relative flex h-[min(92vh,760px)] w-[min(96vw,1060px)] flex-col overflow-hidden rounded-[22px] bg-white text-[#1e1e1e] shadow-[0_28px_80px_rgba(0,0,0,0.55)]">
        {/* Cabecera blanca: Título en MAYÚSCULAS arriba a la izquierda + Artista en cursiva debajo + Botón X a la derecha */}
        <header className="flex items-start justify-between px-6 pt-5 pb-3 sm:px-8 sm:pt-6">
          <div>
            <h2
              id="visor3d-titulo-obra"
              className="font-sans text-[0.95rem] sm:text-[1.02rem] font-semibold uppercase tracking-[0.04em] text-[#222222]"
            >
              {obra.titulo}
            </h2>
            <p className="mt-0.5 font-serif text-[0.94rem] italic text-[#555555]">
              {artistaTexto}
            </p>
          </div>

          <button
            type="button"
            onClick={onCerrar}
            aria-label="Cerrar visualizador 3D"
            className="inline-grid h-10 w-10 place-items-center rounded-full bg-[#f0f0f0] text-[#222222] transition-colors hover:bg-[#e2e2e2] cursor-pointer border-0"
          >
            <X size={20} strokeWidth={1.8} />
          </button>
        </header>

        {/* Área del escenario 3D minimalista (pared blanca/gris clara #f3f3f4) */}
        <div className="relative mx-4 mb-4 flex-1 overflow-hidden rounded-[16px] bg-[#f4f4f6] sm:mx-6 sm:mb-6 select-none">
          {/* Barra superior central de instrucciones semitransparente */}
          <div className="pointer-events-none absolute top-4 left-1/2 z-20 -translate-x-1/2 w-[min(92%,640px)]">
            <div className="rounded-lg bg-[#b8b8bc]/85 px-4 py-1.5 text-center font-sans text-[0.82rem] sm:text-[0.88rem] font-medium tracking-[0.01em] text-white shadow-sm backdrop-blur-xs">
              Arrastra para mover • Rueda para zoom • Rota con los controles
            </div>
          </div>

          {/* Botonera vertical flotante a la derecha (idéntica a la imagen de referencia) */}
          <div
            data-controles-3d="true"
            className="absolute right-3.5 top-1/2 z-20 -translate-y-1/2 flex flex-col items-center gap-2 rounded-full bg-[#c4c4c8]/85 p-1.5 shadow-[0_6px_20px_rgba(0,0,0,0.12)] backdrop-blur-xs"
          >
            {/* Flechas de rotación 3D: Arriba, Izquierda, Derecha, Abajo */}
            <button
              type="button"
              onClick={() => setRotX((x) => Math.min(35, x + 7))}
              title="Inclinar hacia arriba"
              aria-label="Inclinar obra hacia arriba"
              className="inline-grid h-8 w-8 place-items-center rounded-full bg-white text-[#2b2b2b] shadow-xs transition-transform hover:scale-105 active:scale-95 cursor-pointer border-0"
            >
              <ChevronUp size={16} strokeWidth={2.2} />
            </button>

            <button
              type="button"
              onClick={() => setRotY((y) => Math.max(-52, y - 8))}
              title="Rotar hacia la izquierda"
              aria-label="Rotar obra hacia la izquierda"
              className="inline-grid h-8 w-8 place-items-center rounded-full bg-white text-[#2b2b2b] shadow-xs transition-transform hover:scale-105 active:scale-95 cursor-pointer border-0"
            >
              <ChevronLeft size={16} strokeWidth={2.2} />
            </button>

            <button
              type="button"
              onClick={() => setRotY((y) => Math.min(52, y + 8))}
              title="Rotar hacia la derecha"
              aria-label="Rotar obra hacia la derecha"
              className="inline-grid h-8 w-8 place-items-center rounded-full bg-white text-[#2b2b2b] shadow-xs transition-transform hover:scale-105 active:scale-95 cursor-pointer border-0"
            >
              <ChevronRight size={16} strokeWidth={2.2} />
            </button>

            <button
              type="button"
              onClick={() => setRotX((x) => Math.max(-35, x - 7))}
              title="Inclinar hacia abajo"
              aria-label="Inclinar obra hacia abajo"
              className="inline-grid h-8 w-8 place-items-center rounded-full bg-white text-[#2b2b2b] shadow-xs transition-transform hover:scale-105 active:scale-95 cursor-pointer border-0"
            >
              <ChevronDown size={16} strokeWidth={2.2} />
            </button>

            {/* Separador sutil entre rotación y zoom */}
            <div className="my-0.5 h-[1px] w-4 bg-white/50" />

            {/* Zoom In (+) */}
            <button
              type="button"
              onClick={() => setZoom((z) => Math.min(2.2, Number((z + 0.16).toFixed(2))))}
              title="Acercar (Zoom In)"
              aria-label="Acercar vista"
              className="inline-grid h-8 w-8 place-items-center rounded-full bg-white text-[#2b2b2b] shadow-xs transition-transform hover:scale-105 active:scale-95 cursor-pointer border-0"
            >
              <ZoomIn size={15} strokeWidth={2} />
            </button>

            {/* Zoom Out (-) */}
            <button
              type="button"
              onClick={() => setZoom((z) => Math.max(0.55, Number((z - 0.16).toFixed(2))))}
              title="Alejar (Zoom Out)"
              aria-label="Alejar vista"
              className="inline-grid h-8 w-8 place-items-center rounded-full bg-white text-[#2b2b2b] shadow-xs transition-transform hover:scale-105 active:scale-95 cursor-pointer border-0"
            >
              <ZoomOut size={15} strokeWidth={2} />
            </button>

            <div className="my-0.5 h-[1px] w-4 bg-white/50" />

            {/* Botón X inferior de la botonera: restablece la vista o cierra */}
            <button
              type="button"
              onClick={resetearCamara}
              title="Restablecer posición 3D original"
              aria-label="Restablecer posición 3D"
              className="inline-grid h-8 w-8 place-items-center rounded-full bg-white text-[#2b2b2b] shadow-xs transition-transform hover:scale-105 active:scale-95 cursor-pointer border-0"
            >
              <X size={15} strokeWidth={2.1} />
            </button>
          </div>

          {/* Superficie interactiva de arrastre y rueda de zoom */}
          <div
            onPointerDown={manejarPointerDown}
            onPointerMove={manejarPointerMove}
            onPointerUp={manejarPointerUp}
            onPointerCancel={manejarPointerUp}
            onWheel={manejarWheel}
            className={`relative flex h-full w-full items-center justify-center ${
              arrastrando ? "cursor-grabbing" : "cursor-grab"
            }`}
            style={{
              perspective: "1350px",
              touchAction: "none",
            }}
          >
            {/* Escena desplazable y escalable (cámara Pan + Zoom) */}
            <div
              className="relative flex items-center justify-center gap-8 sm:gap-14 transition-transform duration-150 ease-out"
              style={{
                transform: `translate3d(${panX}px, ${panY}px, 0) scale(${zoom})`,
                transformStyle: "preserve-3d",
              }}
            >
              {/* 1. SILUETA HUMANA DE ESCALA A LA IZQUIERDA (5'9" · 1.75 m) */}
              <div
                aria-label="Referencia de escala humana: 1.75 metros (5 pies 9 pulgadas)"
