<file path="src/components/ui/Modal.tsx">
import { useEffect, useId, useRef, type ReactNode } from "react";
import { X } from "lucide-react";

export interface ModalProps {
  abierto: boolean;
  onCerrar: () => void;
  titulo: string;
  descripcion?: string;
  destructivo?: boolean;
  children: ReactNode;
}

const SELECTOR_ENFOCABLES =
  'a[href], button:not([disabled]), textarea:not([disabled]), input:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])';

/**
 * 4.8 Modal:
 * Panel --fondo con borde --riel al 40 %, ancho de 520 px (máximo 92 % de la pantalla), relleno de 32 px.
 * Detrás, rgba(0,0,0,.8). Título en H3 y acciones alineadas a la derecha.
 * Se cierra con Esc, con X y con clic fuera, salvo las confirmaciones destructivas, que solo se cierran con sus botones.
 * El foco queda atrapado dentro y vuelve al disparador al cerrar.
 */
export function Modal({
  abierto,
  onCerrar,
  titulo,
  descripcion,
  destructivo = false,
  children,
}: ModalProps) {
  const tituloId = useId();
  const descId = useId();
  const dialogRef = useRef<HTMLDivElement>(null);
  const disparadorRef = useRef<HTMLElement | null>(null);

  useEffect(() => {
    if (!abierto) return;

    disparadorRef.current = document.activeElement as HTMLElement | null;
    const overflowPrevio = document.body.style.overflow;
    document.body.style.overflow = "hidden";

    const enfocarPrimero = () => {
      const contenedor = dialogRef.current;
      if (!contenedor) return;
      const enfocables = contenedor.querySelectorAll<HTMLElement>(SELECTOR_ENFOCABLES);
      if (enfocables.length > 0) {
        enfocables[0].focus();
      } else {
        contenedor.focus();
      }
    };
    const timer = window.setTimeout(enfocarPrimero, 0);

    const alPresionarTecla = (e: KeyboardEvent) => {
      if (e.key === "Escape" && !destructivo) {
        e.preventDefault();
        onCerrar();
        return;
      }

      if (e.key === "Tab" && dialogRef.current) {
        const enfocables = Array.from(
          dialogRef.current.querySelectorAll<HTMLElement>(SELECTOR_ENFOCABLES)
        );
        if (enfocables.length === 0) {
          e.preventDefault();
          return;
        }
        const primero = enfocables[0];
        const ultimo = enfocables[enfocables.length - 1];
        if (e.shiftKey && document.activeElement === primero) {
          e.preventDefault();
          ultimo.focus();
        } else if (!e.shiftKey && document.activeElement === ultimo) {
          e.preventDefault();
          primero.focus();
        }
      }
    };

    window.addEventListener("keydown", alPresionarTecla);
    return () => {
      window.clearTimeout(timer);
      window.removeEventListener("keydown", alPresionarTecla);
      document.body.style.overflow = overflowPrevio;
      disparadorRef.current?.focus?.();
    };
  }, [abierto, destructivo, onCerrar]);

  if (!abierto) return null;

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-[var(--espacio-16)]">
      <div
        aria-hidden="true"
        className="absolute inset-0 bg-[color:var(--modal-velo)]"
        onClick={destructivo ? undefined : onCerrar}
      />
      <div
        ref={dialogRef}
        role="dialog"
        aria-modal="true"
        aria-labelledby={tituloId}
        aria-describedby={descripcion ? descId : undefined}
        tabIndex={-1}
        className="relative w-[min(92vw,var(--modal-ancho))] rounded-[var(--radio-recto)] border border-[color:var(--borde-reposo)] bg-[color:var(--fondo)] p-[var(--espacio-32)] shadow-[var(--sombra-tarjeta)]"
      >
        {!destructivo && (
          <button
            type="button"
            onClick={onCerrar}
            aria-label="Cerrar"
            className="absolute right-[var(--espacio-16)] top-[var(--espacio-16)] inline-grid h-[var(--area-tactil-min)] w-[var(--area-tactil-min)] place-items-center bg-transparent border-0 text-[color:var(--tinta-suave)] transition-colors duration-[var(--duracion-hover)] hover:text-[color:var(--tinta)] cursor-pointer"
          >
            <X size={24} strokeWidth={1.5} aria-hidden="true" />
          </button>
        )}

        <h3 id={tituloId} className="voz-h3 pr-[var(--espacio-32)] text-[color:var(--tinta)]">
          {titulo}
        </h3>

        {descripcion && (
          <p id={descId} className="voz-cuerpo-pequeno mt-[var(--espacio-8)] text-[color:var(--tinta-suave)]">
            {descripcion}
          </p>
        )}

        <div className="mt-[var(--espacio-24)]">{children}</div>
      </div>
    </div>
  );
}
</file>

<file path="src/components/ui/Pagination.tsx">
import { ChevronLeft, ChevronRight } from "lucide-react";
import clsx from "clsx";

export interface PaginationProps {
  paginaActual: number;
  totalPaginas: number;
  onChange: (pagina: number) => void;
  className?: string;
}

/**
 * 4.6, 6.3, 6.5, 6.10 Paginación numerada:
 * 20 filas por página en tablas, 24 en catálogo/artistas, 10 en mis compras.
 */
export function Pagination({
  paginaActual,
  totalPaginas,
  onChange,
  className,
}: PaginationProps) {
  if (totalPaginas <= 1) return null;

  const paginas = Array.from({ length: totalPaginas }, (_, i) => i + 1);

  return (
    <nav
      aria-label="Paginación"
      className={clsx("flex flex-wrap items-center justify-center gap-[var(--espacio-8)]", className)}
    >
      <button
        type="button"
        disabled={paginaActual <= 1}
        onClick={() => onChange(paginaActual - 1)}
        aria-label="Página anterior"
        className="inline-grid h-[var(--area-tactil-min)] w-[var(--area-tactil-min)] place-items-center rounded-[var(--radio-pildora)] border border-[color:var(--riel)] bg-transparent text-[color:var(--tinta)] hover:border-[color:var(--carmesi)] disabled:opacity-45 disabled:cursor-not-allowed cursor-pointer"
      >
        <ChevronLeft size={20} strokeWidth={1.5} aria-hidden="true" />
      </button>

      {paginas.map((num) => {
        const activa = num === paginaActual;
        return (
          <button
            key={num}
            type="button"
            aria-current={activa ? "page" : undefined}
            onClick={() => onChange(num)}
            className={clsx(
              "inline-grid h-[var(--area-tactil-min)] min-w-[var(--area-tactil-min)] place-items-center rounded-[var(--radio-pildora)] border px-[var(--espacio-12)] font-[var(--fuente-texto)] font-semibold text-[length:var(--text-dato)] transition-colors duration-[var(--duracion-hover)] cursor-pointer",
              activa
                ? "border-[color:var(--carmesi)] bg-[color:var(--carmesi)] text-[color:var(--tinta-inversa)]"
                : "border-[color:var(--borde-reposo)] bg-transparent text-[color:var(--tinta-suave)] hover:border-[color:var(--carmesi)] hover:text-[color:var(--tinta)]"
            )}
          >
            {num}
          </button>
        );
      })}

      <button
        type="button"
        disabled={paginaActual >= totalPaginas}
        onClick={() => onChange(paginaActual + 1)}
        aria-label="Página siguiente"
        className="inline-grid h-[var(--area-tactil-min)] w-[var(--area-tactil-min)] place-items-center rounded-[var(--radio-pildora)] border border-[color:var(--riel)] bg-transparent text-[color:var(--tinta)] hover:border-[color:var(--carmesi)] disabled:opacity-45 disabled:cursor-not-allowed cursor-pointer"
      >
        <ChevronRight size={20} strokeWidth={1.5} aria-hidden="true" />
      </button>
    </nav>
  );
}
</file>

<file path="src/components/ui/perspective-grid.tsx">
import { useEffect, useMemo, useState } from "react";
import clsx from "clsx";

interface PerspectiveGridProps {
  className?: string;
  /** Casillas por lado. 40 es el valor del diseño original. */
  gridSize?: number;
  showOverlay?: boolean;
  fadeRadius?: number;
  /** Suelo de la sala: un plano lineal casi invisible, sin interacción. */
  suelo?: boolean;
}

function SueloSala({ className }: { className?: string }) {
  return (
    <div className={clsx("pointer-events-none overflow-hidden", className)} aria-hidden>
      <div
        className="absolute inset-x-[-8%] bottom-0 h-[42%] origin-bottom"
        style={{
          opacity: 0.4,
          backgroundImage:
            "linear-gradient(to right, var(--divisor) 1px, transparent 1px), linear-gradient(to bottom, var(--divisor) 1px, transparent 1px)",
          backgroundSize: "64px 64px",
          transform: "perspective(900px) rotateX(62deg)",
          maskImage: "linear-gradient(to top, var(--vacio), transparent 80%)",
          WebkitMaskImage: "linear-gradient(to top, var(--vacio), transparent 80%)",
        }}
      />
    </div>
  );
}

function RejillaDensa({
  className,
  gridSize,
  showOverlay,
  fadeRadius,
}: Required<Pick<PerspectiveGridProps, "gridSize" | "showOverlay" | "fadeRadius">> &
  Pick<PerspectiveGridProps, "className">) {
  const [montada, setMontada] = useState(false);

  useEffect(() => {
    setMontada(true);
  }, []);

  const casillas = useMemo(() => Array.from({ length: gridSize * gridSize }), [gridSize]);

  return (
    <div
      className={clsx(
        "relative h-full w-full overflow-hidden bg-[color:var(--fondo)] [--fade-stop:var(--fondo)]",
        className,
      )}
      style={{
        perspective: "2000px",
        transformStyle: "preserve-3d",
      }}
    >
      <div
        className="absolute grid aspect-square w-[80rem] origin-center"
        style={{
          left: "50%",
          top: "50%",
          transform: "translate(-50%, -50%) rotateX(30deg) rotateY(-5deg) rotateZ(20deg) scale(2)",
          transformStyle: "preserve-3d",
          gridTemplateColumns: `repeat(${gridSize}, 1fr)`,
          gridTemplateRows: `repeat(${gridSize}, 1fr)`,
        }}
      >
        {montada &&
          casillas.map((_, i) => (
            <div
              key={i}
              className="min-h-px min-w-px border border-[color:var(--divisor)] bg-transparent transition-colors duration-[1500ms] hover:border-[color:var(--riel)] hover:bg-[color:var(--fila-hover)] hover:duration-0"
            />
          ))}
      </div>

      {showOverlay && (
        <div
          className="pointer-events-none absolute inset-0 z-10"
          style={{
            background: `radial-gradient(circle, transparent 25%, var(--fade-stop) ${fadeRadius}%)`,
          }}
        />
      )}
    </div>
  );
}

/**
 * Cuadrícula en perspectiva. Con `suelo` queda un plano lineal tenue,
 * detrás del texto y de las obras.
 */
export function PerspectiveGrid({
  className,
  gridSize = 40,
  showOverlay = true,
  fadeRadius = 80,
  suelo = false,
}: PerspectiveGridProps) {
  if (suelo) return <SueloSala className={className} />;
  return (
    <RejillaDensa
      className={className}
      gridSize={gridSize}
      showOverlay={showOverlay}
      fadeRadius={fadeRadius}
    />
  );
}
</file>

