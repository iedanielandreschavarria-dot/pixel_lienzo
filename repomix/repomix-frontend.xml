                >
                  {/* Bisel interior del marco y lienzo con textura */}
                  <div className="relative h-full w-full overflow-hidden bg-[#1a1917] shadow-[inset_0_2px_6px_rgba(0,0,0,0.45)]">
                    <img
                      src={srcPintura}
